    /**
     * Generate a simple SVG placeholder for images
     */
    private function generatePlaceholderSvg(string $filename): string
    {
        $shortName = strlen($filename) > 15 ? substr($filename, 0, 12) . '...' : $filename;

        return '<svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">' .
               '<rect width="100%" height="100%" fill="#f8f9fa" stroke="#dee2e6" stroke-width="2"/>' .
               '<text x="50%" y="45%" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#6c757d">Loading...</text>' .
               '<text x="50%" y="65%" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#adb5bd">' . htmlspecialchars($shortName) . '</text>' .
               '</svg>';
    }

    /**
     * Check if image validation is enabled in configuration
     */
    private function isImageValidationEnabled(): bool
    {
        $config = Configuration::getInstance();
        return $config->get('mod.images.validate_images', true); // Enable by default to prevent CORS errors
    }

    /**
     * Check if invalid image logging is enabled in configuration
     */
    private function isInvalidImageLoggingEnabled(): bool
    {
        $config = Configuration::getInstance();
        $logFile = $config->get('mod.images.log_invalid_images', '');
        return !empty($logFile);
    }

    /**
     * Verify if an image URL is accessible using cache and curl-like verification
     */
    private function verifyImageUrl(string $url): bool
    {
        if (empty($url)) {
            return false;
        }

        // Check cache first
        $cached = $this->getCachedImageStatus($url);
        if ($cached !== null) {
            return $cached;
        }

        $isValid = false;
        $errorMessage = '';

        // For local files, check if file exists
        if (!str_contains($url, '://')) {
            $localPath = $this->resolveLocalImagePath($url);
            $isValid = file_exists($localPath);
            if (!$isValid) {
                $errorMessage = sprintf('Local file not found: %s', $localPath);
            }
        } else {
            // For remote URLs, use curl-like HEAD request
            $isValid = $this->curlHeadRequest($url, $errorMessage);
        }

        // Cache the result
        $this->cacheImageStatus($url, $isValid, $errorMessage);

        return $isValid;
    }

    /**
     * Perform a curl-like HEAD request to verify image availability
     */
    private function curlHeadRequest(string $url, string &$errorMessage): bool
    {
        $config = Configuration::getInstance();
        $timeout = $config->get('mod.images.validation_timeout', 5);
        $userAgent = $config->get('mod.images.validation_user_agent', 'Symbiota Portal Helpers Image Validator/1.0');
        $maxRedirects = $config->get('mod.images.validation_max_redirects', 3);

        // Use curl if available, otherwise fallback to get_headers
        if (function_exists('curl_init')) {
            $ch = curl_init();
            curl_setopt_array($ch, [
                CURLOPT_URL => $url,
                CURLOPT_NOBODY => true,  // HEAD request
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_TIMEOUT => $timeout,
                CURLOPT_USERAGENT => $userAgent,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_MAXREDIRS => $maxRedirects,
                CURLOPT_SSL_VERIFYPEER => false,  // For HTTPS images
                CURLOPT_HEADER => true
            ]);

            $result = curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $curlError = curl_error($ch);
            curl_close($ch);

            if ($result === false || !empty($curlError)) {
                $errorMessage = sprintf('cURL error: %s', $curlError);
                return false;
            }

            $isSuccess = $httpCode >= 200 && $httpCode < 400;
            if (!$isSuccess) {
                $errorMessage = sprintf('HTTP status: %d', $httpCode);
            }

            return $isSuccess;
        } else {
            // Fallback to get_headers
            $context = stream_context_create([
                'http' => [
                    'method' => 'HEAD',
                    'timeout' => $timeout,
                    'user_agent' => $userAgent,
                    'follow_location' => true,
                    'max_redirects' => $maxRedirects
                ]
            ]);

            $headers = @get_headers($url, true, $context);

            if ($headers === false) {
                $errorMessage = 'Failed to get headers';
                return false;
            }

            $statusLine = $headers[0] ?? '';
            $isSuccess = str_contains($statusLine, '200') || str_contains($statusLine, '304');

            if (!$isSuccess) {
                $errorMessage = sprintf('HTTP status: %s', $statusLine);
            }

            return $isSuccess;
        }
    }

    /**
     * Validate multiple images concurrently using multi-curl
     * This provides significant performance improvements when validating many images
     */
    private function validateImagesConcurrently(array $images, int $maxConcurrent = 30): array
    {
        if (empty($images)) {
            return [];
        }

        $config = Configuration::getInstance();
        $timeout = $config->get('mod.images.validation_timeout', 30);
        $connectTimeout = $config->get('mod.images.validation_connect_timeout', 10);
        $userAgent = $config->get('mod.images.validation_user_agent', 'Symbiota Portal Helpers Image Validator/1.0');
        $maxRedirects = $config->get('mod.images.validation_max_redirects', 3);
        $maxConcurrentConfig = $config->get('mod.images.max_concurrent_validations', 5);

        // Use configured max concurrent or parameter, whichever is smaller
        $maxConcurrent = min($maxConcurrent, $maxConcurrentConfig);

        $validImages = [];
        $chunks = array_chunk($images, $maxConcurrent);

        foreach ($chunks as $chunk) {
            $multiHandle = curl_multi_init();
            $curlHandles = [];
            $urlToImageMap = [];

            // Initialize curl handles for this chunk
            foreach ($chunk as $image) {
                $url = $image['thumbnail_url'] ?? $image['url'];

                // Skip if already cached
                $cached = $this->getCachedImageStatus($url);
                if ($cached !== null) {
                    if ($cached) {
                        $validImages[] = $image;
                    }
                    continue;
                }

                $ch = curl_init();
                curl_setopt_array($ch, [
                    CURLOPT_URL => $url,
                    CURLOPT_NOBODY => true,
                    CURLOPT_RETURNTRANSFER => true,
                    CURLOPT_FOLLOWLOCATION => true,
                    CURLOPT_MAXREDIRS => $maxRedirects,
                    CURLOPT_TIMEOUT => $timeout,
                    CURLOPT_CONNECTTIMEOUT => $connectTimeout,
                    CURLOPT_USERAGENT => $userAgent,
                    CURLOPT_SSL_VERIFYPEER => false,
                    CURLOPT_SSL_VERIFYHOST => false
                ]);

                curl_multi_add_handle($multiHandle, $ch);
                $curlHandles[] = $ch;
                $urlToImageMap[spl_object_id($ch)] = $image;
            }

            // Execute all requests concurrently
            if (!empty($curlHandles)) {
                $running = null;
                do {
                    curl_multi_exec($multiHandle, $running);
                    curl_multi_select($multiHandle);
                } while ($running > 0);

                // Process results
                foreach ($curlHandles as $ch) {
                    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                    $curlError = curl_error($ch);
                    $image = $urlToImageMap[spl_object_id($ch)];
                    $url = $image['thumbnail_url'] ?? $image['url'];

                    $isValid = false;
                    $errorMessage = '';

                    if (empty($curlError) && $httpCode >= 200 && $httpCode < 400) {
                        $isValid = true;
                    } else {
                        $errorMessage = !empty($curlError) ?
                            sprintf('cURL error: %s', $curlError) :
                            sprintf('HTTP status: %d', $httpCode);
                    }

                    // Cache the result
                    $this->cacheImageStatus($url, $isValid, $errorMessage);

                    // Log invalid images if enabled
                    if (!$isValid && $this->isInvalidImageLoggingEnabled()) {
                        $this->logInvalidImage($url, $errorMessage);
                    }

                    // Add valid images to result
                    if ($isValid) {
                        $validImages[] = $image;
                    }

                    curl_multi_remove_handle($multiHandle, $ch);
                    curl_close($ch);
                }

                curl_multi_close($multiHandle);
            }
        }

        return $validImages;
    }

    /**
     * Resolve local image path for file existence checking
     */
    private function resolveLocalImagePath(string $url): string
    {
        $config = Configuration::getInstance();
        $symbiotaPath = $config->get('symbiota.path', '');

        // Remove leading slash and resolve relative to Symbiota path
        $relativePath = ltrim($url, '/');
        return sprintf('%s/%s', $symbiotaPath, $relativePath);
    }

    /**
     * Get cached image validation status
     */
    private function getCachedImageStatus(string $url): ?bool
    {
        try {
            $db = $this->getImageCacheDb();
            if (!$db) {
                return null;
            }

            $config = Configuration::getInstance();
            $imagesConfig = $config ?
                ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
                [];
            $cacheHours = $imagesConfig['images_cache_hours'] ?? 168; // Default 7 days
            $cacheExpiry = date('Y-m-d H:i:s', time() - ($cacheHours * 3600));

            $stmt = $db->prepare('
                SELECT is_valid
                FROM image_cache
                WHERE url = ? AND checked_at > ?
            ');
            $stmt->execute([$url, $cacheExpiry]);

            $result = $stmt->fetch(PDO::FETCH_ASSOC);
            return $result ? (bool)$result['is_valid'] : null;

        } catch (Exception $e) {
            error_log("Image cache read error: " . $e->getMessage());
            return null;
        }
    }

    /**
     * Cache image validation status
     */
    private function cacheImageStatus(string $url, bool $isValid, string $errorMessage = ''): void
    {
        try {
            $db = $this->getImageCacheDb();
            if (!$db) {
                return;
            }

            $stmt = $db->prepare('
                INSERT OR REPLACE INTO image_cache
                (url, is_valid, error_message, checked_at)
                VALUES (?, ?, ?, ?)
            ');
            $stmt->execute([
                $url,
                $isValid ? 1 : 0,
                $errorMessage,
                date('Y-m-d H:i:s')
            ]);

            // Log invalid images if logging is enabled
            if (!$isValid && $this->isInvalidImageLoggingEnabled()) {
                $this->logInvalidImage($url, $errorMessage);
            }

        } catch (Exception $e) {
            error_log("Image cache write error: " . $e->getMessage());
        }
    }

    /**
     * Get or create SQLite database for image cache
     */
    private function getImageCacheDb(): ?PDO
    {
        static $db = null;

        if ($db !== null) {
            return $db;
        }

        try {
            $config = Configuration::getInstance();
            $imagesConfig = $config ?
                ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
                [];

            // First check for explicit cache database configuration
            $cacheFile = $imagesConfig['images_cache_db'] ?? '';

            if (empty($cacheFile)) {
                // Fallback: use log file directory if specified
                $invalidImagesLogFile = $imagesConfig['log_invalid_images'] ?? '';
                if (!empty($invalidImagesLogFile)) {
                    $logDir = dirname($invalidImagesLogFile);
                    $cacheFile = sprintf('%s/image_validation.sqlite', $logDir);
                } else {
                    // Final fallback: default cache location
                    $cacheFile = $imagesConfig['cache_file'] ?? 'cache/image_validation.sqlite';
                }
            }

            // Use ApplicationPaths for absolute path resolution
            if (!str_starts_with($cacheFile, '/')) {
                $cacheFile = sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $cacheFile);
            }



            // Ensure cache directory exists
            $cacheDir = dirname($cacheFile);
            if (!is_dir($cacheDir)) {
                mkdir($cacheDir, 0755, true);
            }

            $db = new PDO(sprintf('sqlite:%s', $cacheFile));
            $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

            // Create table if it doesn't exist
            $db->exec('
                CREATE TABLE IF NOT EXISTS image_cache (
                    url TEXT PRIMARY KEY,
                    is_valid INTEGER NOT NULL,
                    error_message TEXT,
                    checked_at DATETIME NOT NULL
                )
            ');

            // Create indexes for performance
            $db->exec('
                CREATE UNIQUE INDEX IF NOT EXISTS idx_url_unique
                ON image_cache(url)
            ');

            $db->exec('
                CREATE INDEX IF NOT EXISTS idx_checked_at
                ON image_cache(checked_at)
            ');

            $db->exec('
                CREATE INDEX IF NOT EXISTS idx_url_checked_at
                ON image_cache(url, checked_at)
            ');

            return $db;

        } catch (Exception $e) {
            error_log("Failed to initialize image cache database: " . $e->getMessage());
            return null;
        }
    }

    /**
     * Log invalid image URL to configured log file (fallback logging)
     */
    private function logInvalidImage(string $url, string $reason): void
    {
        try {
            $config = Configuration::getInstance();
            $logFile = $config->get('mod.images.log_invalid_images', '');

            // If no log file specified, don't log (just filter out invalid images)
            if (empty($logFile)) {
                return;
            }

            // Use ApplicationPaths for absolute path resolution
            if (!str_starts_with($logFile, '/')) {
                $logFile = sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $logFile);
            }

            // Ensure log directory exists
            $logDir = dirname($logFile);
            if (!is_dir($logDir)) {
                mkdir($logDir, 0755, true);
            }

            $timestamp = date('Y-m-d H:i:s');
            $logEntry = sprintf("[%s] INVALID IMAGE: %s - %s\n", $timestamp, $url, $reason);

            file_put_contents($logFile, $logEntry, FILE_APPEND | LOCK_EX);

        } catch (Exception $e) {
            // Silently fail logging to avoid breaking image loading
            error_log("Failed to log invalid image: " . $e->getMessage());
        }
    }

    /**
     * Handle cache cleanup action
     */
    private function handleCacheCleanupAction(array $params): array
    {
        $deletedCount = $this->cleanImageCache();

        return [
            'type' => 'json',
            'content' => [
                'success' => true,
                'message' => sprintf('Cleaned up %d expired cache entries', $deletedCount),
                'deleted_count' => $deletedCount
            ]
        ];
    }

    /**
     * Clean up old cache entries
     */
    public function cleanImageCache(): int
    {
        try {
            $db = $this->getImageCacheDb();
            if (!$db) {
                return 0;
            }

            $config = Configuration::getInstance();
            $cacheHours = $config->get('mod.images.images_cache_hours', 168); // Default 7 days
            $cacheExpiry = date('Y-m-d H:i:s', time() - ($cacheHours * 3600));

            $stmt = $db->prepare('DELETE FROM image_cache WHERE checked_at < ?');
            $stmt->execute([$cacheExpiry]);

            return $stmt->rowCount();

        } catch (Exception $e) {
            error_log("Image cache cleanup error: " . $e->getMessage());
            return 0;
        }
    }

    /**
     * Filter out images that are known to be invalid from cache
     */
    private function filterKnownInvalidImages(array $images): array
    {
        // Check if cache is enabled
        $config = Configuration::getInstance();
        $imagesConfig = $config ?
            ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
            [];

        $cacheDb = $imagesConfig['images_cache_db'] ?? '';
        if (empty($cacheDb)) {
            // No cache configured, return all images
            return $images;
        }

        try {
            $db = $this->getImageCacheDb();
            if (!$db) {
                return $images;
            }

            $filteredImages = [];
            foreach ($images as $image) {
                $thumbnailUrl = $image['thumbnail_url'];
                $mainUrl = $image['url'];

                // Check if either URL is known to be invalid
                $thumbnailValid = $this->getCachedImageStatus($thumbnailUrl);
                $mainValid = $this->getCachedImageStatus($mainUrl);

                // If we have cache data and both URLs are marked invalid, skip this image
                if (($thumbnailValid === false) && ($mainValid === false)) {
                    continue; // Skip this image
                }

                // If we don't have cache data or at least one URL might be valid, include the image
                $filteredImages[] = $image;
            }

            return $filteredImages;

        } catch (Exception $e) {
            error_log("Error filtering invalid images: " . $e->getMessage());
            // On error, return all images (fail open)
            return $images;
        }
    }

    /**
     * Generate CSRF token for session
     */
    private function generateCsrfToken(): string
    {
        // Ensure session is started (only if headers not sent)
        if (session_status() === PHP_SESSION_NONE && !headers_sent()) {
            session_start();
        }

        // Generate new token
        $token = bin2hex(random_bytes(32));

        // Only store in session if session is available
        if (session_status() === PHP_SESSION_ACTIVE) {
            $_SESSION['images_csrf_token'] = $token;
            $_SESSION['images_csrf_expires'] = time() + 3600; // 1 hour expiry
        }

        return $token;
    }

    /**
     * Validate CSRF token from request
     */
    private function validateCsrfToken(string $providedToken): bool
    {
        // Ensure session is started (only if headers not sent)
        if (session_status() === PHP_SESSION_NONE && !headers_sent()) {
            session_start();
        }

        // Only validate if session is active
        if (session_status() !== PHP_SESSION_ACTIVE) {
            return false; // No session available, cannot validate
        }

        $sessionToken = $_SESSION['images_csrf_token'] ?? '';
        $sessionExpires = $_SESSION['images_csrf_expires'] ?? 0;

        // Check if token exists and hasn't expired
        if (empty($sessionToken) || time() > $sessionExpires) {
            return false;
        }

        // Use hash_equals to prevent timing attacks
        return hash_equals($sessionToken, $providedToken);
    }

    /**
     * Report invalid images from client-side failures
     * POST /?/images/invalid
     */
    private function reportInvalidImages(array $params): array
    {
        // Only accept POST requests
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            return [
                'type' => 'error',
                'message' => 'Method not allowed. Use POST.',
                'status_code' => 405
            ];
        }

        try {
            // Get URLs and CSRF token from request body (JSON) or form data
            $urls = [];
            $csrfToken = '';

            // Try to get JSON data first
            $input = file_get_contents('php://input');
            if (!empty($input)) {
                $data = json_decode($input, true);
                if (json_last_error() === JSON_ERROR_NONE) {
                    $urls = $data['urls'] ?? [];
                    $csrfToken = $data['csrf_token'] ?? '';
                }
            }

            // Fallback to form data
            if (empty($urls) && isset($params['urls'])) {
                $urls = is_array($params['urls']) ? $params['urls'] : [$params['urls']];
            }

            // Single URL parameter
            if (empty($urls) && isset($params['url'])) {
                $urls = [$params['url']];
            }

            // Get CSRF token from form data if not in JSON
            if (empty($csrfToken)) {
                $csrfToken = $params['csrf_token'] ?? '';
            }

            // Validate CSRF token
            if (!$this->validateCsrfToken($csrfToken)) {
                return [
                    'type' => 'error',
                    'message' => 'Invalid or expired security token. Please refresh the page.',
                    'status_code' => 403
                ];
            }

            if (empty($urls)) {
                return [
                    'type' => 'error',
                    'message' => 'No URLs provided. Send as JSON: {"urls": ["url1", "url2"]} or form data.',
                    'status_code' => 400
                ];
            }

            // Validate URLs
            $validUrls = [];
            foreach ($urls as $url) {
                if (is_string($url) && filter_var($url, FILTER_VALIDATE_URL)) {
                    $validUrls[] = $url;
                }
            }

            if (empty($validUrls)) {
                return [
                    'type' => 'error',
                    'message' => 'No valid URLs provided.',
                    'status_code' => 400
                ];
            }

            // Check if cache is enabled
            $config = Configuration::getInstance();
            $imagesConfig = $config ?
                ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
                [];

            $cacheDb = $imagesConfig['images_cache_db'] ?? '';
            if (empty($cacheDb)) {
                return [
                    'type' => 'error',
                    'message' => 'Image cache not configured. Set images_cache_db in config.',
                    'status_code' => 503
                ];
            }

            // Report invalid images to cache
            $reported = 0;
            foreach ($validUrls as $url) {
                $this->cacheImageStatus($url, false, 'Client-side load failure');
                $reported++;
            }

            return [
                'type' => 'json',
                'content' => [
                    'success' => true,
                    'message' => sprintf('Reported %d invalid images', $reported),
                    'reported_count' => $reported,
                    'urls' => $validUrls
                ]
            ];

        } catch (Exception $e) {
            return [
                'type' => 'error',
                'message' => 'Failed to report invalid images: ' . $e->getMessage(),
                'status_code' => 500
            ];
        }
    }

    /**
     * Get images module configuration and status
     */
    private function getImagesStatus(array $params): array
    {
        $config = Configuration::getInstance();

        // Get configuration values using the same pattern as backup/upload modules
        $imagesConfig = $config ?
            ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
            [];

        $registryFile = $imagesConfig['registry_file'] ?? 'cache/images_registry.json';
        $cacheDb = $imagesConfig['images_cache_db'] ?? 'cache/image_validation.sqlite';
        $imagesPerRequest = $imagesConfig['images_per_request'] ?? 20;
        $enableRandom = $imagesConfig['images_enable_random'] ?? true;
        $cacheHours = $imagesConfig['images_cache_hours'] ?? 168;
        $validateImages = $imagesConfig['validate_images'] ?? false;
        $logInvalidImages = $imagesConfig['log_invalid_images'] ?? '';
        $validationTimeout = $imagesConfig['validation_timeout'] ?? 30;
        $connectTimeout = $imagesConfig['validation_connect_timeout'] ?? 10;
        $maxConcurrent = $imagesConfig['max_concurrent_validations'] ?? 5;
        $eavBatchSize = $imagesConfig['eav_batch_size'] ?? 27000;

        // Get memory information
        $memoryLimit = ini_get('memory_limit');
        $memoryLimitBytes = $this->parseMemoryLimit($memoryLimit);
        $currentMemory = memory_get_usage(true);
        $peakMemory = memory_get_peak_usage(true);

        // Evaluate batch size recommendation
        $recommendedBatchSize = $this->calculateRecommendedBatchSize($memoryLimitBytes);
        $batchSizeStatus = 'OK';
        if ($eavBatchSize > $recommendedBatchSize) {
            $batchSizeStatus = 'WARNING: May exceed memory limit';
        }

        // Resolve absolute paths
        $registryFileAbs = str_starts_with($registryFile, '/') ? $registryFile :
            sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $registryFile);
        $cacheDbAbs = str_starts_with($cacheDb, '/') ? $cacheDb :
            sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $cacheDb);
        $logFileAbs = !empty($logInvalidImages) && !str_starts_with($logInvalidImages, '/') ?
            sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $logInvalidImages) : $logInvalidImages;

        // Get registry info
        $registryInfo = [];
        if (file_exists($registryFileAbs)) {
            $registryContent = file_get_contents($registryFileAbs);
            $registry = json_decode($registryContent, true);
            if ($registry && isset($registry['api_key'])) {
                $registryInfo = [
                    'api_key_exists' => true,
                    'api_key_created' => $registry['api_key']['created_at'] ?? 'Unknown',
                    'api_key_created_by' => $registry['api_key']['created_by'] ?? 'Unknown'
                ];
            } else {
                $registryInfo['api_key_exists'] = false;
            }
        } else {
            $registryInfo['api_key_exists'] = false;
        }

        // Get cache database info (EAV index)
        $cacheInfo = [];
        if (file_exists($cacheDbAbs)) {
            try {
                // Open in read-only mode
                $db = new PDO('sqlite:' . $cacheDbAbs, null, null, [
                    PDO::SQLITE_ATTR_OPEN_FLAGS => PDO::SQLITE_OPEN_READONLY
                ]);

                // Check if this is an EAV database
                $tables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='Entities'")->fetchAll(PDO::FETCH_COLUMN);

                if (!empty($tables)) {
                    // EAV database structure
                    $stmt = $db->query('SELECT COUNT(*) as total FROM Entities');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['total_entities'] = $result['total'] ?? 0;

                    $stmt = $db->query('SELECT COUNT(*) as total FROM EAV');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['total_eav_records'] = $result['total'] ?? 0;

                    $stmt = $db->query('SELECT COUNT(*) as total FROM Attributes');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['total_attributes'] = $result['total'] ?? 0;

                    $stmt = $db->query('SELECT COUNT(*) as total FROM media');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['total_media'] = $result['total'] ?? 0;

                    $cacheInfo['index_type'] = 'EAV';

                    // Get cache metadata if available
                    $metadataTables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='cache_metadata'")->fetchAll(PDO::FETCH_COLUMN);
                    if (!empty($metadataTables)) {
                        $stmt = $db->query("SELECT value FROM cache_metadata WHERE key='cache_built_at'");
                        $cacheBuiltAt = $stmt->fetchColumn();
                        if ($cacheBuiltAt) {
                            $cacheInfo['cache_built_at'] = $cacheBuiltAt;
                            $cacheAge = time() - strtotime($cacheBuiltAt);
                            $cacheInfo['cache_age_hours'] = round($cacheAge / 3600, 1);
                            $cacheInfo['cache_age_days'] = round($cacheAge / 86400, 1);
                        }

                        $stmt = $db->query("SELECT value FROM cache_metadata WHERE key='cache_version'");
                        $cacheVersion = $stmt->fetchColumn();
                        if ($cacheVersion) {
                            $cacheInfo['cache_version'] = $cacheVersion;
                        }
                    }
                } else {
                    // Legacy image_cache structure
                    $stmt = $db->query('SELECT COUNT(*) as total FROM image_cache');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['total_entries'] = $result['total'] ?? 0;

                    $stmt = $db->query('SELECT COUNT(*) as valid FROM image_cache WHERE is_valid = 1');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['valid_entries'] = $result['valid'] ?? 0;

                    $stmt = $db->query('SELECT COUNT(*) as invalid FROM image_cache WHERE is_valid = 0');
                    $result = $stmt->fetch(PDO::FETCH_ASSOC);
                    $cacheInfo['invalid_entries'] = $result['invalid'] ?? 0;

                    $cacheInfo['index_type'] = 'Legacy';
                }

                $cacheInfo['cache_db_size'] = filesize($cacheDbAbs);
                $cacheInfo['cache_db_size_formatted'] = $this->formatBytes($cacheInfo['cache_db_size']);
            } catch (Exception $e) {
                $cacheInfo['error'] = 'Unable to read cache database: ' . $e->getMessage();
            }
        } else {
            $cacheInfo['total_entities'] = 0;
            $cacheInfo['cache_db_exists'] = false;
        }

        // Get database connection status
        $dbStatus = $this->isDatabaseAvailable() ? 'Connected' : 'Not Available';

        $status = [
            'configuration' => [
                'images_per_request' => $imagesPerRequest,
                'images_enable_random' => $enableRandom,
                'images_cache_hours' => $cacheHours,
                'validate_images' => $validateImages,
                'validation_timeout' => $validationTimeout,
                'validation_connect_timeout' => $connectTimeout,
                'max_concurrent_validations' => $maxConcurrent,
                'log_invalid_images' => !empty($logInvalidImages),
                'eav_batch_size' => $eavBatchSize
            ],
            'memory_info' => [
                'memory_limit' => $memoryLimit,
                'memory_limit_bytes' => $memoryLimitBytes,
                'current_usage' => $currentMemory,
                'current_usage_formatted' => $this->formatBytes($currentMemory),
                'peak_usage' => $peakMemory,
                'peak_usage_formatted' => $this->formatBytes($peakMemory),
                'recommended_batch_size' => $recommendedBatchSize,
                'configured_batch_size' => $eavBatchSize,
                'batch_size_status' => $batchSizeStatus
            ],
            'paths' => [
                'registry_file' => $registryFile,
                'registry_file_absolute' => $registryFileAbs,
                'registry_file_exists' => file_exists($registryFileAbs),
                'cache_db' => $cacheDb,
                'cache_db_absolute' => $cacheDbAbs,
                'cache_db_exists' => file_exists($cacheDbAbs),
                'log_file' => $logInvalidImages,
                'log_file_absolute' => $logFileAbs,
                'log_file_exists' => !empty($logFileAbs) && file_exists($logFileAbs)
            ],
            'registry_info' => $registryInfo,
            'cache_info' => $cacheInfo,
            'database_status' => $dbStatus
        ];

        if (Environment::isCli()) {
            $output = ["Images Module Status", str_repeat("=", 50)];

            $output[] = "\nConfiguration:";
            foreach ($status['configuration'] as $key => $value) {
                $displayValue = is_bool($value) ? ($value ? 'YES' : 'NO') : $value;
                $output[] = sprintf("  %-25s: %s", $key, $displayValue);
            }

            $output[] = "\nPaths:";
            foreach ($status['paths'] as $key => $value) {
                if (str_ends_with($key, '_absolute')) continue; // Skip absolute paths in CLI
                $displayValue = is_bool($value) ? ($value ? 'YES' : 'NO') : $value;
                $output[] = sprintf("  %-25s: %s", $key, $displayValue);
            }

            $output[] = "\nAPI Key Registry:";
            if ($status['registry_info']['api_key_exists']) {
                $output[] = sprintf("  %-25s: %s", 'api_key_exists', 'YES');
                $output[] = sprintf("  %-25s: %s", 'api_key_created', $status['registry_info']['api_key_created']);
                $output[] = sprintf("  %-25s: %s", 'api_key_created_by', $status['registry_info']['api_key_created_by']);
            } else {
                $output[] = sprintf("  %-25s: %s", 'api_key_exists', 'NO');
            }

            $output[] = "\nCache Database:";
            if (isset($status['cache_info']['error'])) {
                $output[] = sprintf("  %-25s: %s", 'status', 'ERROR');
                $output[] = sprintf("  %-25s: %s", 'error', $status['cache_info']['error']);
            } else {
                if (isset($status['cache_info']['index_type'])) {
                    $output[] = sprintf("  %-25s: %s", 'index_type', $status['cache_info']['index_type']);
                }

                if ($status['cache_info']['index_type'] === 'EAV') {
                    // EAV index statistics
                    $output[] = sprintf("  %-25s: %s", 'total_entities', number_format($status['cache_info']['total_entities'] ?? 0));
                    $output[] = sprintf("  %-25s: %s", 'total_eav_records', number_format($status['cache_info']['total_eav_records'] ?? 0));
                    $output[] = sprintf("  %-25s: %s", 'total_attributes', number_format($status['cache_info']['total_attributes'] ?? 0));
                    $output[] = sprintf("  %-25s: %s", 'total_media', number_format($status['cache_info']['total_media'] ?? 0));

                    // Cache metadata
                    if (isset($status['cache_info']['cache_built_at'])) {
                        $output[] = sprintf("  %-25s: %s", 'cache_built_at', $status['cache_info']['cache_built_at']);
                        $output[] = sprintf("  %-25s: %.1f hours (%.1f days)", 'cache_age',
                            $status['cache_info']['cache_age_hours'] ?? 0,
                            $status['cache_info']['cache_age_days'] ?? 0);
                    }
                    if (isset($status['cache_info']['cache_version'])) {
                        $output[] = sprintf("  %-25s: %s", 'cache_version', $status['cache_info']['cache_version']);
                    }
                } else {
                    // Legacy cache statistics
                    $output[] = sprintf("  %-25s: %d", 'total_entries', $status['cache_info']['total_entries'] ?? 0);
                    $output[] = sprintf("  %-25s: %d", 'valid_entries', $status['cache_info']['valid_entries'] ?? 0);
                    $output[] = sprintf("  %-25s: %d", 'invalid_entries', $status['cache_info']['invalid_entries'] ?? 0);
                }

                if (isset($status['cache_info']['cache_db_size_formatted'])) {
                    $output[] = sprintf("  %-25s: %s", 'database_size', $status['cache_info']['cache_db_size_formatted']);
                }
            }

            $output[] = "\nDatabase Connection:";
            $output[] = sprintf("  %-25s: %s", 'status', $status['database_status']);

            $output[] = "\nMemory & Performance:";
            $output[] = sprintf("  %-25s: %s", 'memory_limit', $status['memory_info']['memory_limit']);
            $output[] = sprintf("  %-25s: %s", 'current_usage', $status['memory_info']['current_usage_formatted']);
            $output[] = sprintf("  %-25s: %s", 'peak_usage', $status['memory_info']['peak_usage_formatted']);
            $output[] = sprintf("  %-25s: %s", 'eav_batch_size', number_format($status['memory_info']['configured_batch_size']));
            $output[] = sprintf("  %-25s: %s", 'recommended_batch_size', number_format($status['memory_info']['recommended_batch_size']));
            $output[] = sprintf("  %-25s: %s", 'batch_size_status', $status['memory_info']['batch_size_status']);

            if ($status['memory_info']['batch_size_status'] !== 'OK') {
                $output[] = "\n⚠️  WARNING: Configured batch size may exceed available memory.";
                $output[] = sprintf("   Consider setting 'eav_batch_size' => %d in config.php [mod.images]",
                    $status['memory_info']['recommended_batch_size']);
            }

            return [
                'type' => 'success',
                'content' => implode("\n", $output)
            ];
        }

        return [
            'type' => 'json',
            'data' => $status
        ];
    }

    /**
     * Format bytes into human readable format
     */
    private function formatBytes(int $bytes, int $precision = 2): string
    {
        $units = ['B', 'KB', 'MB', 'GB', 'TB'];
        $bytesFloat = (float)$bytes;

        for ($i = 0; $bytesFloat > 1024.0 && $i < count($units) - 1; $i++) {
            $bytesFloat /= 1024.0;
        }

        return sprintf('%s %s', round($bytesFloat, $precision), $units[$i]);
    }

    /**
     * Normalize whitespace in TSV value
     *
     * Removes tabs, newlines, and carriage returns that would break TSV parsing.
     * Collapses multiple spaces into single space.
     *
     * @param mixed $value Value to normalize
     * @return string Normalized value safe for TSV export
     */
    private function normalizeTsvValue($value): string
    {
        if ($value === null) {
            return '';
        }

        // Convert to string
        $value = (string)$value;

        // Remove tabs, newlines, carriage returns
        $value = preg_replace('/[\t\n\r]+/', ' ', $value);

        // Collapse multiple spaces
        $value = preg_replace('/\s+/', ' ', $value);

        // Trim leading/trailing whitespace
        return trim($value);
    }

    /**
     * Parse memory limit string to bytes
     */
    private function parseMemoryLimit(string $memoryLimit): int
    {
        $memoryLimit = trim($memoryLimit);
        $last = strtolower($memoryLimit[strlen($memoryLimit)-1]);
        $value = (int)$memoryLimit;

        switch($last) {
            case 'g':
                $value *= 1024;
            case 'm':
                $value *= 1024;
            case 'k':
                $value *= 1024;
        }

        return $value;
    }

    /**
     * Calculate recommended batch size based on available memory
     *
     * Formula: Assume ~500 bytes per row average, leave 50% headroom
     */
    private function calculateRecommendedBatchSize(int $memoryLimitBytes): int
    {
        // Leave 50% of memory for PHP overhead and other operations
        $availableMemory = (float)$memoryLimitBytes * 0.5;

        // Estimate ~500 bytes per row (conservative estimate)
        $bytesPerRow = 500.0;

        // Calculate batch size
        $batchSize = (int)($availableMemory / $bytesPerRow);

        // Round down to nearest 1000
        $batchSize = (int)(floor((float)$batchSize / 1000.0) * 1000.0);

        // Minimum 1000, maximum 100000
        return max(1000, min(100000, $batchSize));
    }

    /**
     * Load SQL template from file
     */
    private function loadSqlTemplate(string $templateName): string
    {
        $templatePath = sprintf('%s/templates/sql/images/%s.sql', ApplicationPaths::applicationDirectory(), $templateName);

        if (!file_exists($templatePath)) {
            throw new Exception(sprintf('SQL template not found: %s', $templatePath));
        }

        return file_get_contents($templatePath);
    }

    /**
     * Get maximum media ID for random sampling (optimized version)
     */
    private function getMaxMediaIdForSampling(): int
    {
        // Use Configuration singleton to get max media ID
        $config = Configuration::getInstance();
        $configMaxId = $config ? $config->get('mod.images.images_max_media_id', 1000000) : 1000000;

        if ($configMaxId > 0) {
            return (int)$configMaxId;
        }

        // Fallback to database query only if config not set
        static $cachedMaxId = null;

        if ($cachedMaxId !== null) {
            return $cachedMaxId;
        }

        if (!$this->isDatabaseAvailable()) {
            $cachedMaxId = 1000000;
            return $cachedMaxId;
        }

        try {
            $db = $this->getDatabaseConnection('readonly');
            if (!$db) {
                $cachedMaxId = 1000000;
                return $cachedMaxId;
            }

            // Simple direct query
            $result = $db->query("SELECT MAX(mediaid) as max_mediaid FROM media WHERE url IS NOT NULL LIMIT 1");
            if ($result && $row = $result->fetch_assoc()) {
                $cachedMaxId = (int)($row['max_mediaid'] ?? 1000000);
                return $cachedMaxId;
            }

            $cachedMaxId = 1000000;
            return $cachedMaxId;
        } catch (Exception $e) {
            error_log(sprintf('Error getting max media ID: %s', $e->getMessage()));
            $cachedMaxId = 1000000;
            return $cachedMaxId;
        }
    }

    /**
     * Generate random media IDs for fast basic query (optimized version)
     */
    private function generateRandomMediaIdsOptimized(int $count): array
    {
        $maxId = $this->getMaxMediaIdForSampling();
        $mediaIds = [];

        // Generate twice the requested count to account for missing/invalid IDs
        $generateCount = $count * 2;

        for ($i = 0; $i < $generateCount; $i++) {
            $mediaIds[] = rand(1, $maxId);
        }

        return array_unique($mediaIds);
    }

    /**
     * Create a new API key for image downloads
     */
    private function createApiKey(array $params): array
    {
        try {
            $apiKey = $this->generateUuid();
            $this->storeApiKey($apiKey);

            return [
                'type' => 'json',
                'content' => [
                    'success' => true,
                    'api_key' => $apiKey,
                    'message' => 'API key created successfully'
                ]
            ];
        } catch (Exception $e) {
            return [
                'type' => 'json',
                'content' => [
                    'success' => false,
                    'error' => $e->getMessage()
                ]
            ];
        }
    }

    /**
     * Show the current API key
     */
    private function showApiKey(array $params): array
    {
        try {
            $apiKey = $this->getStoredApiKey();

            if (!$apiKey) {
                return [
                    'type' => 'json',
                    'content' => [
                        'success' => false,
                        'message' => 'No API key found. Use api-key-create to generate one.'
                    ]
                ];
            }

            return [
                'type' => 'json',
                'content' => [
                    'success' => true,
                    'api_key' => $apiKey,
                    'message' => 'Current API key'
                ]
            ];
        } catch (Exception $e) {
            return [
                'type' => 'json',
                'content' => [
                    'success' => false,
                    'error' => $e->getMessage()
                ]
            ];
        }
    }

    /**
     * Download images API endpoint with API key authentication
     */
    private function downloadImages(array $params): array
    {
        try {
            // Check API key authentication
            if (!$this->validateApiKey($params)) {
                return [
                    'type' => 'json',
                    'content' => [
                        'success' => false,
                        'error' => 'Invalid or missing API key'
                    ],
                    'status' => 401
                ];
            }

            // Get images using existing stream functionality
            $limit = (int)($params['limit'] ?? 20);
            $offset = (int)($params['offset'] ?? 0);
            $search = $params['search'] ?? '';
            $sort = $params['sort'] ?? 'random';
            $filter = $params['filter'] ?? '';

            $images = $this->getImagesFromDatabase($limit, $search, $sort, $filter, $offset);

            return [
                'type' => 'json',
                'content' => [
                    'success' => true,
                    'images' => $images,
                    'count' => count($images),
                    'limit' => $limit,
                    'offset' => $offset
                ]
            ];
        } catch (Exception $e) {
            return [
                'type' => 'json',
                'content' => [
                    'success' => false,
                    'error' => $e->getMessage()
                ],
                'status' => 500
            ];
        }
    }

    /**
     * Clear image validation cache
     */
    private function clearCache(array $params): array
    {
        try {
            // For HTTP requests, require API key authentication
            if (isset($_SERVER['REQUEST_METHOD']) && !$this->validateApiKey($params)) {
                return [
                    'type' => 'json',
                    'content' => [
                        'success' => false,
                        'error' => 'Invalid or missing API key'
                    ],
                    'status' => 401
                ];
            }

            $db = $this->getImageCacheDb();
            if (!$db) {
                throw new Exception('Unable to access cache database');
            }

            $stmt = $db->prepare('DELETE FROM image_cache');
            $stmt->execute();
            $deletedCount = $stmt->rowCount();

            return [
                'type' => 'json',
                'content' => [
                    'success' => true,
                    'message' => sprintf('Cleared %d cache entries', $deletedCount),
                    'deleted_count' => $deletedCount
                ]
            ];
        } catch (Exception $e) {
            return [
                'type' => 'json',
                'content' => [
                    'success' => false,
                    'error' => $e->getMessage()
                ],
                'status' => 500
            ];
        }
    }

    /**
     * Generate a UUID v4
     */
    private function generateUuid(): string
    {
        $data = random_bytes(16);
        $data[6] = chr(ord($data[6]) & 0x0f | 0x40); // Version 4
        $data[8] = chr(ord($data[8]) & 0x3f | 0x80); // Variant bits

        return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
    }

    /**
     * Store API key in registry file
     */
    private function storeApiKey(string $apiKey): void
    {
        $config = Configuration::getInstance();
        $imagesConfig = $config ?
            ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
            [];
        $registryFile = $imagesConfig['registry_file'] ?? 'cache/images_registry.json';

        // Use ApplicationPaths for absolute path resolution
        if (!str_starts_with($registryFile, '/')) {
            $registryFile = sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $registryFile);
        }



        // Ensure directory exists
        $dir = dirname($registryFile);
        if (!is_dir($dir)) {
            mkdir($dir, 0755, true);
        }

        // Load existing registry or create new one
        $registry = [];
        if (file_exists($registryFile)) {
            $content = file_get_contents($registryFile);
            $registry = json_decode($content, true) ?? [];
        }

        // Store API key with timestamp
        $registry['api_key'] = [
            'key' => $apiKey,
            'created_at' => date('Y-m-d H:i:s'),
            'created_by' => 'cli'
        ];

        file_put_contents($registryFile, json_encode($registry, JSON_PRETTY_PRINT), LOCK_EX);
        chmod($registryFile, 0600); // Secure permissions
    }

    /**
     * Get stored API key from registry
     */
    private function getStoredApiKey(): ?string
    {
        $config = Configuration::getInstance();
        $imagesConfig = $config ?
            ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
            [];
        $registryFile = $imagesConfig['registry_file'] ?? 'cache/images_registry.json';

        // Use ApplicationPaths for absolute path resolution
        if (!str_starts_with($registryFile, '/')) {
            $registryFile = sprintf('%s/%s', ApplicationPaths::applicationDirectory(), $registryFile);
        }

        if (!file_exists($registryFile)) {
            return null;
        }

        $content = file_get_contents($registryFile);
        $registry = json_decode($content, true);

        if (!$registry || !isset($registry['api_key']['key'])) {
            return null;
        }

        return $registry['api_key']['key'];
    }

    /**
     * Validate API key from request headers or parameters
     */
    private function validateApiKey(array $params): bool
    {
        $storedApiKey = $this->getStoredApiKey();
        if (!$storedApiKey) {
            return false;
        }

        // Check Authorization header
        $headers = getallheaders();
        if ($headers && isset($headers['Authorization'])) {
            $authHeader = $headers['Authorization'];
            if (str_starts_with($authHeader, 'Bearer ')) {
                $providedKey = substr($authHeader, 7);
                return hash_equals($storedApiKey, $providedKey);
            }
        }

        // Check X-API-Key header
        if ($headers && isset($headers['X-API-Key'])) {
            return hash_equals($storedApiKey, $headers['X-API-Key']);
        }

        // Check api_key parameter
        if (isset($params['api_key'])) {
            return hash_equals($storedApiKey, $params['api_key']);
        }

        return false;
    }

    /**
     * Execute ultra-fast basic image query with minimal overhead
     */
    private function executeBasicImageQuery(int $limit): array
    {
        if (!$this->isDatabaseAvailable()) {
            return [];
        }

        try {
            $db = $this->getDatabaseConnection('readonly');
            if (!$db) {
                return [];
            }

            // Improved random sampling - generate more IDs and retry if needed
            $maxId = $this->getMaxMediaIdForSampling();
            $attempts = 0;
            $images = [];

            while (count($images) < $limit && $attempts < 3) {
                $randomIds = [];

                // Generate more random IDs to account for gaps and duplicates
                $idsToGenerate = ($limit - count($images)) * 5; // 5x buffer
                for ($i = 0; $i < $idsToGenerate; $i++) {
                    $randomIds[] = rand(1, $maxId);
                }

                // Remove duplicates and convert to string
                $uniqueIds = array_unique($randomIds);
                $randomIdsStr = implode(',', $uniqueIds);

                // Query for this batch - use lowercase column names, map in PHP
                $sql = "SELECT
                            m.mediaid,
                            m.occid,
                            m.url,
                            m.thumbnailurl,
                            m.originalurl,
                            m.caption,
                            SUBSTRING_INDEX(m.url, '/', -1) as filename
                        FROM media m
                        WHERE m.mediaid IN ($randomIdsStr)
                        AND m.url IS NOT NULL
                        AND m.url != ''
                        LIMIT " . ($limit - count($images));

                $result = $db->query($sql);
                if ($result) {
                    while ($row = $result->fetch_assoc()) {
                        // Map lowercase DB columns to camelCase
                        $images[] = [
                            'mediaID' => (int)$row['mediaid'],
                            'occid' => $row['occid'],
                            'url' => $row['url'],
                            'thumbnailUrl' => $row['thumbnailurl'] ?: $row['url'],
                            'originalUrl' => $row['originalurl'] ?: $row['url'],
                            'caption' => $row['caption'] ?: '',
                            'filename' => $row['filename']
                        ];
                        if (count($images) >= $limit) break;
                    }
                }
                $attempts++;
            }

            return $images;
        } catch (Exception $e) {
            error_log(sprintf('Error executing basic image query: %s', $e->getMessage()));
            return [];
        }
    }

    /**
     * Execute detailed image query with full JOINs for overlay
     */
    private function executeDetailedImageQuery(array $conditions = [], string $orderBy = 'm.mediaid DESC', int $limit = 20, int $offset = 0): array
    {
        if (!$this->isDatabaseAvailable()) {
            return [];
        }

        try {
            $sql = $this->loadSqlTemplate('detailed_load');

            $whereClause = '';
            if (!empty($conditions)) {
                $whereClause = sprintf('AND %s', implode(' AND ', $conditions));
            }

            $query = str_replace('{WHERE_CONDITIONS}', $whereClause, $sql);
            $query = str_replace('{ORDER_BY}', $orderBy, $query);
            $query = str_replace('{LIMIT}', (string)$limit, $query);
            $query = str_replace('{OFFSET}', (string)$offset, $query);

            $db = $this->getDatabaseConnection('readonly');

            if (!$db) {
                return [];
            }

            $result = $db->query($query);
            $images = [];
            if ($result) {
                while ($row = $result->fetch_assoc()) {
                    $images[] = $row;
                }
            }
            return $images;
        } catch (Exception $e) {
            error_log(sprintf('Error executing detailed image query: %s', $e->getMessage()));
            return [];
        }
    }

    /**
     * Handle overlay action for image display
     */
    private function handleOverlayAction(array $route, array $params): array
    {
        // Extract media ID from multiple possible sources
        $mediaId = '';

        // Try params first (standard approach)
        $mediaId = $params['id'] ?? $params['mediaId'] ?? $params[0] ?? '';

        // Try route array - the media ID might have :htmx suffix
        if (!$mediaId && isset($route[0])) {
            // Remove :htmx suffix if present
            $routeValue = $route[0];
            if (strpos($routeValue, ':') !== false) {
                $routeValue = explode(':', $routeValue)[0];
            }
            if (is_numeric($routeValue)) {
                $mediaId = $routeValue;
            }
        }

        // Try route array at different positions in case routing is different
        if (!$mediaId) {
            for ($i = 0; $i < count($route); $i++) {
                $routeValue = $route[$i];
                // Remove :htmx suffix if present
                if (strpos($routeValue, ':') !== false) {
                    $routeValue = explode(':', $routeValue)[0];
                }
                if (is_numeric($routeValue)) {
                    $mediaId = $routeValue;
                    break;
                }
            }
        }

        if (!is_numeric($mediaId)) {
            return [
                'type' => 'error',
                'message' => 'Media ID required for overlay',
                'status_code' => 400
            ];
        }

        $mediaId = (int)$mediaId;

        // Handle DELETE request to close overlay
        if (isset($_SERVER['REQUEST_METHOD']) && $_SERVER['REQUEST_METHOD'] === 'DELETE') {
            return [
                'type' => 'success',
                'content' => '',
                'format' => TemplateFormat::HTML
            ];
        }

        // Handle POST request for toggle info
        if (isset($route[3]) && $route[3] === 'toggle-info') {
            $visible = $params['visible'] ?? 'hidden';
            $newVisible = $visible === 'visible' ? 'hidden' : 'visible';

            return $this->renderOverlayInfo($mediaId, $newVisible);
        }

        return $this->renderImageOverlay($mediaId);
    }

    /**
     * Render image overlay with navigation and information
     */
    private function renderImageOverlay(int $mediaId): array
    {
        // For now, let's use a simple approach to get the image URL from the basic query
        // This avoids the complex JOIN that might be causing the hang
        if (!$this->isDatabaseAvailable()) {
            return [
                'type' => 'error',
                'message' => 'Database not available',
                'status_code' => 503
            ];
        }

        try {
            $db = $this->getDatabaseConnection('readonly');
            if (!$db) {
                throw new Exception('Database connection failed');
            }

            // Start with basic media query, then try to get additional data
            $sql = "SELECT mediaid, url, thumbnailurl, caption, occid FROM media WHERE mediaid = ? AND url IS NOT NULL";
            $stmt = $db->prepare($sql);
            if (!$stmt) {
                throw new Exception('Failed to prepare statement: ' . $db->error);
            }

            $stmt->bind_param('i', $mediaId);
            $stmt->execute();
            $result = $stmt->get_result();
            $image = $result->fetch_assoc();

            // Try to get comprehensive portal data if occid exists
            if ($image && $image['occid']) {
                try {
                    $portalSql = "SELECT
                                    o.sciname,
                                    o.scientificName,
                                    o.eventdate,
                                    o.country,
                                    o.county,
                                    o.stateprovince,
                                    o.tidinterpreted,
                                    o.collid,
                                    c.collectionname,
                                    c.collectioncode,
                                    c.institutioncode,
                                    t.sciname as taxa_sciname,
                                    t.tid as taxa_tid
                                FROM omoccurrences o
                                LEFT JOIN omcollections c ON o.collid = c.collid
                                LEFT JOIN taxa t ON o.tidinterpreted = t.tid
                                WHERE o.occid = ?";
                    $portalStmt = $db->prepare($portalSql);
                    if ($portalStmt) {
                        $portalStmt->bind_param('i', $image['occid']);
                        $portalStmt->execute();
                        $portalResult = $portalStmt->get_result();
                        $portalData = $portalResult->fetch_assoc();
                        if ($portalData) {
                            // Merge portal data with image data
                            $image = array_merge($image, $portalData);

                            // Determine best sciname and tid to use
                            if (!empty($portalData['taxa_sciname']) && !empty($portalData['taxa_tid'])) {
                                // Use taxa table data if available (most reliable)
                                $image['display_sciname'] = $portalData['taxa_sciname'];
                                $image['display_tid'] = $portalData['taxa_tid'];
                            } elseif (!empty($portalData['sciname'])) {
                                // Use occurrence sciname
                                $image['display_sciname'] = $portalData['sciname'];
                                $image['display_tid'] = null; // No reliable tid link
                            } elseif (!empty($portalData['scientificName'])) {
                                // Fallback to scientificName
                                $image['display_sciname'] = $portalData['scientificName'];
                                $image['display_tid'] = null; // No reliable tid link
                            } else {
                                $image['display_sciname'] = 'Unknown';
                                $image['display_tid'] = null;
                            }
                        }
                    }
                } catch (Exception $e) {
                    // If portal data fails, continue with basic image data
                    error_log('Portal data query failed: ' . $e->getMessage());
                }
            }

            if (!$image) {
                return [
                    'type' => 'error',
                    'message' => sprintf('Image not found: %d', $mediaId),
                    'status_code' => 404
                ];
            }

            // Create template data with portal links
            $filename = basename($image['url']);
            $config = Configuration::getInstance();
            $symbClientUrl = $config ? $config->get('_internal.symbclienturl', '') : '';

            // Generate portal link HTML
            $occidLinkHtml = !empty($image['occid']) && !empty($symbClientUrl) ?
                sprintf('<a href="%s/collections/individual/index.php?occid=%s" target="_blank" class="portal-link occid-link" title="View Occurrence"><i class="fas fa-leaf"></i></a>',
                    $symbClientUrl, $image['occid']) : '';

            $tidLinkHtml = !empty($image['display_tid']) && !empty($symbClientUrl) ?
                sprintf('<a href="%s/taxa/index.php?taxon=%s" target="_blank" class="portal-link tid-link" title="View Taxon"><i class="fas fa-dna"></i></a>',
                    $symbClientUrl, $image['display_tid']) : '';

            $collidLinkHtml = !empty($image['collid']) && !empty($symbClientUrl) ?
                sprintf('<a href="%s/collections/misc/collprofiles.php?collid=%s" target="_blank" class="portal-link collid-link" title="View Collection"><i class="fas fa-archive"></i></a>',
                    $symbClientUrl, $image['collid']) : '';

            // Format location and collection info
            $locationParts = array_filter([
                $image['country'] ?? '',
                $image['stateprovince'] ?? '',
                $image['county'] ?? ''
            ]);
            $locationText = !empty($locationParts) ? implode(', ', $locationParts) : '';

            $collectionText = $image['collectionname'] ?? 'Unknown Collection';
            if (!empty($image['institutioncode']) && !empty($image['collectioncode'])) {
                $collectionText = sprintf('%s (%s:%s)', $collectionText, $image['institutioncode'], $image['collectioncode']);
            }

            $templateData = [
                'url' => $image['url'],
                'caption' => $image['caption'] ?: '',
                'filename' => $filename,
                'occid' => $image['occid'] ?: '',
                'sciname' => $image['display_sciname'] ?? 'Unknown',
                'eventdate' => $image['eventdate'] ?? 'Unknown Date',
                'location' => $locationText,
                'tid' => $image['display_tid'] ?? '',
                'collection' => $collectionText,
                'collid' => $image['collid'] ?? '',
                'symbclienturl' => $symbClientUrl,
                'occid_link_html' => $occidLinkHtml,
                'tid_link_html' => $tidLinkHtml,
                'collid_link_html' => $collidLinkHtml
            ];

            return [
                'type' => 'success',
                'content' => $this->renderTemplate('overlay', TemplateFormat::HTML, $templateData)
            ];

        } catch (Exception $e) {
            error_log(sprintf('Error rendering image overlay: %s', $e->getMessage()));
            return [
                'type' => 'error',
                'message' => sprintf('Error loading image: %s', $e->getMessage()),
                'status_code' => 500
            ];
        }
    }

    /**
     * Get adjacent image for navigation
     */
    private function getAdjacentImage(int $mediaId, string $direction): ?array
    {
        $operator = $direction === 'prev' ? '<' : '>';
        $order = $direction === 'prev' ? 'DESC' : 'ASC';

        $conditions = [sprintf('m.mediaid %s %d', $operator, $mediaId)];
        $images = $this->executeDetailedImageQuery($conditions, sprintf('m.mediaid %s', $order), 1, 0);

        return $images[0] ?? null;
    }

    /**
     * Format location information for display
     */
    private function formatLocationInfo(array $image): string
    {
        $location = [];

        if (!empty($image['country'])) {
            $location[] = $image['country'];
        }
        if (!empty($image['stateprovince'])) {
            $location[] = $image['stateprovince'];
        }
        if (!empty($image['county'])) {
            $location[] = $image['county'];
        }
        if (!empty($image['locality'])) {
            $location[] = $image['locality'];
        }

        if (empty($location)) {
            return '';
        }

        return sprintf('<div class="location-info"><i class="fas fa-map-marker-alt"></i> %s</div>', implode(', ', $location));
    }

    /**
     * Render overlay information panel
     */
    private function renderOverlayInfo(int $mediaId, string $visible): array
    {
        $conditions = [sprintf('m.mediaid = %d', $mediaId)];
        $images = $this->executeDetailedImageQuery($conditions, 'm.mediaid', 1, 0);

        if (empty($images)) {
            return [
                'type' => 'error',
                'message' => sprintf('Image not found: %d', $mediaId),
                'status_code' => 404
            ];
        }

        $image = $images[0];
        $config = Configuration::getInstance();
        $symbClientUrl = $config ? $config->get('SYMBCLIENTURL', '') : '';

        $templateData = [
            'sciname' => $image['sciname'] ?: 'Unknown',
            'tid' => $image['tid'],
            'occid' => $image['occid'],
            'collid' => $image['collid'],
            'collection_name' => $image['collectionname'] ?: 'Unknown Collection',
            'event_date' => $image['eventdate'] ?: 'Unknown Date',
            'symbclienturl' => $symbClientUrl,
            'app_url_prefix' => $this->getAppUrlPrefix(),
            'info_visible' => $visible,
            'tid_link' => $image['tid'] ? sprintf('<a href="%s/taxa/index.php?taxon=%d" class="info-link" target="_blank" title="View taxon"><i class="fas fa-external-link-alt"></i></a>', $symbClientUrl, $image['tid']) : '',
            'location_info' => $this->formatLocationInfo($image)
        ];

        return [
            'type' => 'success',
            'content' => $this->renderTemplate('overlay_info', TemplateFormat::HTML, $templateData)
        ];
    }

