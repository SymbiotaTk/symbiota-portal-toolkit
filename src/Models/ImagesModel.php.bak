    /**
     * Refresh autocomplete cache if needed
     */
    private function refreshAutocompleteCache(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $autocompleteCachePath = $params['db-path'] ?? $config->get('components.images.autocomplete_cache_db');
            $configPath = __DIR__ . '/../../templates/sql/images/eav/index_config.ini';
            $force = isset($params['force']) || isset($params['f']);

            // Create hybrid model to check if rebuild is needed
            // It will use DatabaseManager internally
            $hybridModel = new ImagesModelHybrid(
                EavIndexing::parseConfig($configPath),
                [], // Empty - will use DatabaseManager
                $autocompleteCachePath
            );

            // Check if rebuild is needed
            $needsRebuild = $hybridModel->needsCacheRebuild();

            if (!$needsRebuild && !$force) {
                if (Environment::isCli()) {
                    echo "\n✓ Autocomplete cache is up-to-date\n";
                    echo "  Cache: {$autocompleteCachePath}\n";

                    $metadata = $hybridModel->getCacheMetadata();
                    if ($metadata) {
                        echo sprintf("  Last build: %s\n", $metadata['build_timestamp'] ?? 'N/A');
                        echo sprintf("  Entities: %s\n\n", number_format($metadata['entity_count'] ?? 0));
                    }
                }

                return [
                    'type' => 'success',
                    'message' => 'Cache is up-to-date',
                    'content' => 'No rebuild needed'
                ];
            }

            // Rebuild cache
            if (Environment::isCli()) {
                if ($force) {
                    echo "\n🔄 Force rebuild requested...\n";
                } else {
                    echo "\n🔄 Source data changed, rebuilding cache...\n";
                }
            }

            // Create autocomplete builder
            // It will use DatabaseManager internally
            $builder = new ImagesModelAutocomplete([
                'config_path' => $configPath,
                'autocomplete_db_path' => $autocompleteCachePath,
                'mysql_config' => [] // Empty - will use DatabaseManager
            ]);

            // Build cache (pass params for --source-db-path support)
            $result = $builder->buildAutocompleteCache($params);

            return $result;

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to refresh autocomplete cache',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
     * Get PHP memory limit in bytes
     *
     * @return int Memory limit in bytes
     */
    private function getMemoryLimitBytes(): int
    {
        $memoryLimit = ini_get('memory_limit');

        if ($memoryLimit == -1) {
            // No limit
            return PHP_INT_MAX;
        }

        $unit = strtoupper(substr($memoryLimit, -1));
        $value = (int)substr($memoryLimit, 0, -1);

        switch ($unit) {
            case 'G':
                $value *= 1024;
                // fall through
            case 'M':
                $value *= 1024;
                // fall through
            case 'K':
                $value *= 1024;
                break;
        }

        return $value;
    }

    /**
     * Build table relationship graph for export filtering
     *
     * The config defines foreign keys from the table's perspective:
     *   [media]
     *   foreign_key[] = "occid:omoccurrences.occid"
     *
     * This means: media.occid references omoccurrences.occid
     *
     * For export filtering, we need to know:
     * - Which column in media points to omoccurrences? (occid)
     * - Which column in omoccurrences does it point to? (occid)
     *
     * So we can filter: SELECT * FROM omoccurrences WHERE occid IN (SELECT occid FROM media)
     *
     * The graph structure is: [table_name => [referenced_table => [local_col, ref_col]]]
     *
     * @param array $config Parsed config from index_config.ini
     * @param string $rootTable Root table name
     * @return array Graph mapping tables to their referenced tables
     */
    private function buildExportTableGraph(array $config, string $rootTable): array
    {
        $graph = [];

        foreach ($config as $tableName => $tableConfig) {
            if ($tableName === '_config' || $tableName === 'aliases') {
                continue;
            }

            $graph[$tableName] = [];

            // Parse foreign keys
            if (isset($tableConfig['foreign_key'])) {
                $foreignKeys = is_array($tableConfig['foreign_key'])
                    ? $tableConfig['foreign_key']
                    : [$tableConfig['foreign_key']];

                foreach ($foreignKeys as $fk) {
                    // Parse format: "local_column:referenced_table.referenced_column"
                    // Example: "occid:omoccurrences.occid" in [media] section
                    if (preg_match('/^([^:]+):([^.]+)\.(.+)$/', $fk, $matches)) {
                        $localCol = $matches[1];      // media.occid
                        $refTable = $matches[2];      // omoccurrences
                        $refCol = $matches[3];        // omoccurrences.occid

                        $graph[$tableName][$refTable] = [
                            'local_col' => $localCol,
                            'ref_col' => $refCol
                        ];
                    }
                }
            }
        }

        return $graph;
    }

    /**
     * Get tables in export order (root first, then referenced tables)
     *
     * Starting from root, find all tables it references (directly or indirectly).
     * Also include tables that reference any of the collected tables.
     *
     * Example:
     *   media references omoccurrences
     *   omoccurrences references omcollections, taxa
     *   taxstatus references taxa (so include taxstatus too)
     *
     * Export order: media, omoccurrences, omcollections, taxa, taxstatus
     *
     * @param array $config Parsed config
     * @param string $rootTable Root table name
     * @param array $graph Table relationship graph
     * @return array Table names in export order
     */
    private function getExportTableOrder(array $config, string $rootTable, array $graph): array
    {
        $tables = [$rootTable]; // Root table first
        $visited = [$rootTable => true];

        // Recursively add tables referenced by root (and tables they reference)
        $this->collectReferencedTables($graph, $rootTable, $tables, $visited);

        // Also add any tables that reference the tables we've collected
        // (e.g., taxstatus references taxa, so if taxa is in the list, add taxstatus)
        $additionalTables = [];
        foreach ($graph as $tableName => $references) {
            if (isset($visited[$tableName])) {
                continue; // Already in the list
            }

            // Check if this table references any table in our list
            foreach ($references as $refTable => $joinInfo) {
                if (isset($visited[$refTable])) {
                    // This table references a table in our list, so include it
                    $additionalTables[] = $tableName;
                    $visited[$tableName] = true;
                    break;
                }
            }
        }

        // Add additional tables to the end
        $tables = array_merge($tables, $additionalTables);

        return $tables;
    }

    /**
     * Recursively collect tables referenced by the current table
     *
     * The graph maps: table_name => [referenced_table => [local_col, ref_col]]
     *
     * @param array $graph Table relationship graph
     * @param string $currentTable Current table
     * @param array &$tables Collected tables (output)
     * @param array &$visited Visited tables tracker
     * @return void
     */
    private function collectReferencedTables(array $graph, string $currentTable, array &$tables, array &$visited): void
    {
        if (!isset($graph[$currentTable])) {
            return;
        }

        // Add all tables referenced by currentTable
        foreach ($graph[$currentTable] as $refTable => $joinInfo) {
            if (isset($visited[$refTable])) {
                continue;
            }

            $tables[] = $refTable;
            $visited[$refTable] = true;

            // Recursively add tables referenced by this table
            $this->collectReferencedTables($graph, $refTable, $tables, $visited);
        }
    }

    /**
     * Build WHERE clause to filter related rows for export
     *
     * The path from root to this table tells us how to filter.
     *
     * Example: media (root table with where_clause)
     *   WHERE clause: occid IS NOT NULL
     *
     * Example: media -> omoccurrences (no LIMIT)
     *   Path: [['local_col' => 'occid', 'ref_table' => 'omoccurrences', 'ref_col' => 'occid']]
     *   WHERE clause: occid IN (SELECT occid FROM media WHERE occid IS NOT NULL)
     *
     * Example: media -> omoccurrences (with LIMIT=1000)
     *   Path: [['local_col' => 'occid', 'ref_table' => 'omoccurrences', 'ref_col' => 'occid']]
     *   WHERE clause: occid IN (123, 456, 789, ...) -- 1000 values from SQLite
     *
     * @param string $tableName Current table being exported
     * @param string $rootTable Root table name
     * @param array $graph Table relationship graph
     * @param array $config Parsed config
     * @param int|null $limit Optional LIMIT for root table (testing only)
     * @param PDO|null $sourceDb SQLite database (for querying limited root table data)
     * @return string WHERE clause (without "WHERE" keyword), or empty string if no filter
     */
    private function buildExportWhereClause(string $tableName, string $rootTable, array $graph, array $config, ?int $limit = null, ?PDO $sourceDb = null): string
    {
        // Root table: apply where_clause from config if defined
        if ($tableName === $rootTable) {
            $rootWhereClause = isset($config['_config']['where_clause']) ? $config['_config']['where_clause'] : '';
            return $rootWhereClause;
        }

        // Find path from root to this table
        $path = $this->findPathToRoot($tableName, $rootTable, $graph);

        if (empty($path)) {
            // Table not connected to root - export all rows (shouldn't happen with valid config)
            if (Environment::isCli()) {
                echo sprintf("  ⚠ WARNING: No path found from %s to %s - exporting ALL rows!\n", $rootTable, $tableName);
            }
            return '';
        }

        if (Environment::isCli()) {
            echo sprintf("  Path from %s to %s: %d steps\n", $rootTable, $tableName, count($path));
        }

        // Build nested subquery from target table back to root
        // Path is from root to target: [media->omoccurrences, omoccurrences->omcollections]
        // We need to build: WHERE collid IN (SELECT collid FROM omoccurrences WHERE occid IN (SELECT occid FROM media WHERE occid IS NOT NULL))
        //
        // IMPORTANT: When LIMIT is used, we query the SQLite database (which has the limited data)
        // and build an IN clause with explicit values instead of a subquery.
        //
        // For each step, we need:
        // - The column in the CURRENT table (ref_col from this step)
        // - The column in the PREVIOUS table (local_col from this step)
        // - The PREVIOUS table name (which is ref_table from PREVIOUS step, or rootTable for first step)

        $whereClause = '';
        $previousTable = $rootTable;

        // Get root table WHERE clause (if any) - only used when querying MySQL
        $rootWhereClause = isset($config['_config']['where_clause']) ? $config['_config']['where_clause'] : '';

        foreach ($path as $i => $step) {
            $localCol = $step['local_col'];   // Column in previous table
            $refTable = $step['ref_table'];   // Current table (target of this FK)
            $refCol = $step['ref_col'];       // Column in current table

            if ($limit && $sourceDb) {
                // When LIMIT is used, query the SQLite database to get the actual values
                // For multi-step paths, we need to query the PREVIOUS table in the chain
                // Example: media -> omoccurrences -> omcollections
                //   Step 0: Query media.occid from SQLite
                //   Step 1: Query omoccurrences.collid from SQLite (WHERE occid IN (...))

                if ($i === 0) {
                    // First step: Query root table
                    $stmt = $sourceDb->query("SELECT DISTINCT `{$localCol}` FROM `{$previousTable}` WHERE `{$localCol}` IS NOT NULL");
                } else {
                    // Subsequent steps: Query previous table with WHERE clause from previous step
                    // We need to get the values from the previous table that match the previous WHERE clause
                    // But we already have the previous table in SQLite, so just query it
                    $stmt = $sourceDb->query("SELECT DISTINCT `{$localCol}` FROM `{$previousTable}` WHERE `{$localCol}` IS NOT NULL");
                }

                $values = $stmt->fetchAll(PDO::FETCH_COLUMN);

                if (empty($values)) {
                    // No values found - return impossible condition
                    return "1=0";
                }

                // Build IN clause with explicit values
                $valueList = implode(',', array_map(function($v) {
                    return is_numeric($v) ? $v : "'" . addslashes($v) . "'";
                }, $values));

                $whereClause = sprintf("`%s` IN (%s)", $refCol, $valueList);

                if (Environment::isCli()) {
                    echo sprintf("  Using %d values from SQLite table '%s' for filtering\n", count($values), $previousTable);
                }

                // No need to continue building subqueries - we have the explicit values
                break;

            } elseif ($i === 0) {
                // No LIMIT: query MySQL database with WHERE clause
                $whereClause = sprintf(
                    "`%s` IN (SELECT `%s` FROM `%s`",
                    $refCol,
                    $localCol,
                    $previousTable
                );

                // Add root table WHERE clause if this is the first step (connecting to root)
                if ($rootWhereClause) {
                    $whereClause .= " WHERE " . $rootWhereClause;
                }
            } else {
                // Subsequent steps: add WHERE clause to subquery
                $whereClause .= sprintf(
                    " WHERE `%s` IN (SELECT `%s` FROM `%s`",
                    $refCol,
                    $localCol,
                    $previousTable
                );
            }

            $previousTable = $refTable;  // Update for next iteration
        }

        // Close all subqueries (only if we didn't use explicit values)
        if (!($limit && $sourceDb)) {
            $whereClause .= str_repeat(')', count($path));
        }

        return $whereClause;
    }

    /**
     * Find path from root to target table through foreign key relationships
     *
     * Uses BFS to find shortest path from root table to target table.
     * The graph maps: table_name => [referenced_table => [local_col, ref_col]]
     *
     * Example path from media to omcollections:
     *   [
     *     ['local_col' => 'occid', 'ref_table' => 'omoccurrences', 'ref_col' => 'occid'],
     *     ['local_col' => 'collid', 'ref_table' => 'omcollections', 'ref_col' => 'collid']
     *   ]
     *
     * This means:
     *   media.occid -> omoccurrences.occid
     *   omoccurrences.collid -> omcollections.collid
     *
     * @param string $tableName Target table
     * @param string $rootTable Starting root table
     * @param array $graph Table relationship graph
     * @return array Path as array of steps: [['local_col' => ..., 'ref_table' => ..., 'ref_col' => ...], ...]
     */
    private function findPathToRoot(string $tableName, string $rootTable, array $graph): array
    {
        // BFS to find shortest path from root to target
        $queue = [[$rootTable, []]]; // [current_table, path_so_far]
        $visited = [$rootTable => true];

        while (!empty($queue)) {
            list($currentTable, $path) = array_shift($queue);

            // Found target?
            if ($currentTable === $tableName) {
                return $path;
            }

            // Check if current table references any other tables
            if (!isset($graph[$currentTable])) {
                continue;
            }

            // Check all tables referenced by current table
            foreach ($graph[$currentTable] as $refTable => $joinInfo) {
                if (isset($visited[$refTable])) {
                    continue;
                }

                // Add this step to the path
                $newPath = array_merge($path, [[
                    'local_col' => $joinInfo['local_col'],
                    'ref_table' => $refTable,
                    'ref_col' => $joinInfo['ref_col']
                ]]);

                // Continue searching from referenced table
                $visited[$refTable] = true;
                $queue[] = [$refTable, $newPath];
            }
        }

        return []; // No path found
    }

    // ========================================================================
    // EAV CACHE MANAGEMENT METHODS
    // ========================================================================

    /**
     * Check if EAV cache is stale
     * Returns true if cache needs rebuilding
     */
    private function isCacheStale(string $dbPath): bool
    {
        if (!file_exists($dbPath)) {
            return true; // Cache doesn't exist
        }

        try {
            $db = new \PDO(sprintf('sqlite:%s', $dbPath));
            $db->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);

            // Check if Config table exists (new cache format)
            $tables = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='Config'")->fetchAll(\PDO::FETCH_COLUMN);
            if (empty($tables)) {
                return true; // No Config table = old cache format
            }

            // Get cache build time
            $stmt = $db->query("SELECT ConfigValue FROM Config WHERE ConfigKey='cache_built_at'");
            $cacheBuiltAt = $stmt->fetchColumn();

            if (!$cacheBuiltAt) {
                return true; // No build time recorded
            }

            // Get configuration for staleness threshold
            $config = Configuration::getInstance();
            $imagesConfig = $config ?
                ($config->get('components.images') ?? $config->get('images') ?? $config->get('mod.images') ?? []) :
                [];
            $cacheStaleHours = $imagesConfig['eav_cache_stale_hours'] ?? 168; // Default 7 days

            // Check if cache is older than threshold
            $cacheAge = time() - strtotime($cacheBuiltAt);
            $staleThreshold = $cacheStaleHours * 3600;

            return $cacheAge > $staleThreshold;

        } catch (\Exception $e) {
            error_log("Cache staleness check failed: " . $e->getMessage());
            return true; // Assume stale on error
        }
    }

    /**
     * Ensure cache is ready, rebuild if stale
     * Returns true if cache is ready, false if rebuild failed
     */
    private function ensureCacheReady(string $dbPath, bool $showProgress = true): bool
    {
        if (!$this->isCacheStale($dbPath)) {
            return true; // Cache is fresh
        }

        if ($showProgress && Environment::isCli()) {
            echo "\n⚠️  EAV cache is stale or missing. Rebuilding...\n\n";
        }

        // Rebuild cache
        $result = $this->buildEavIndexNew([]);

        if (isset($result['type']) && $result['type'] === 'error') {
            error_log("Failed to rebuild EAV cache: " . ($result['message'] ?? 'Unknown error'));
            return false;
        }

        return true;
    }

    // ========================================================================
    // OLD EAV METHODS REMOVED
    // All old EAV indexing methods have been removed and replaced with
    // ImagesModelEav delegation in buildEavIndexNew() and exportEavTsvNew()
    //
    // Removed methods (1606 lines):
    // - buildEavIndex() - OLD IMPLEMENTATION
    // - buildEavIndexOptimized() - OLD IMPLEMENTATION
    // - exportEavTsv() - OLD IMPLEMENTATION
    // - eavStep1Setup() through eavStep9Cleanup()
    // - eavTokenizerStep1Setup() through eavTokenizerStep7Cleanup()
    // - Various helper methods for old implementation
    // ========================================================================

    /**
     * Export MySQL data to TSV files
     *
     * @param mysqli $connection MySQL connection
     * @param string $configPath Path to index_config.ini
     * @param string $outputDir Directory to write TSV files
     * @param int|null $limit Optional row limit for root table
     * @param int $batchSize Rows per batch
     * @return array Result array
     */
    private function exportToTsvFiles(
        mysqli $connection,
        string $configPath,
        string $outputDir,
        ?int $limit,
        int $batchSize
    ): array {
        $startTime = microtime(true);

        if (Environment::isCli()) {
            echo "\n=== Exporting MySQL to TSV Files ===\n";
            echo sprintf("Output directory: %s\n", $outputDir);
            if ($limit) {
                echo sprintf("LIMIT: %s rows (partial load)\n", number_format($limit));
            }
            echo "\n";
        }

        // Parse config
        $config = @parse_ini_file($configPath, true);
        if (!$config) {
            throw new Exception("Failed to parse config file: {$configPath}");
        }

        $rootTable = $config['_config']['root_table'] ?? null;
        if (!$rootTable) {
            throw new Exception("No root_table defined in [_config] section");
        }

        // Get tables to export
        $tables = [];
        foreach ($config as $sectionName => $sectionData) {
            if ($sectionName === '_config' || !isset($sectionData['primary_key'])) {
                continue;
            }
            $tables[] = $sectionName;
        }

        // Export root table first to get foreign key values for filtering related tables
        $allForeignKeyValues = $this->exportTableToTsv($connection, $rootTable, $outputDir, $config, $rootTable, $limit, $batchSize);

        // Export related tables (filtered by foreign key values from root table)
        // Process in multiple passes to handle cascading relationships
        $exportedTables = [$rootTable => true];
        $maxPasses = 5; // Prevent infinite loops

        for ($pass = 0; $pass < $maxPasses; $pass++) {
            $exportedInThisPass = false;

            foreach ($tables as $tableName) {
                if (isset($exportedTables[$tableName])) {
                    continue; // Already exported
                }

                // Export this table and collect its foreign keys
                $newForeignKeyValues = $this->exportTableToTsv($connection, $tableName, $outputDir, $config, $rootTable, $limit, $batchSize, $allForeignKeyValues);

                // Merge new foreign key values
                foreach ($newForeignKeyValues as $targetTable => $ids) {
                    if (!isset($allForeignKeyValues[$targetTable])) {
                        $allForeignKeyValues[$targetTable] = [];
                    }
                    $allForeignKeyValues[$targetTable] = array_merge($allForeignKeyValues[$targetTable], $ids);
                }

                $exportedTables[$tableName] = true;
                $exportedInThisPass = true;
            }

            if (!$exportedInThisPass) {
                break; // All tables exported
            }
        }

        $totalTime = microtime(true) - $startTime;

        if (Environment::isCli()) {
            echo sprintf("\n✓ Export complete (%.2f seconds)\n\n", $totalTime);
        }

        return [
            'type' => 'success',
            'content' => sprintf('Exported %d tables to %s in %.2f seconds', count($tables), $outputDir, $totalTime)
        ];
    }

    /**
     * Export a single table to TSV file
     *
     * @return array Array of exported IDs (for filtering related tables)
     */
    private function exportTableToTsv(
        mysqli $connection,
        string $tableName,
        string $outputDir,
        array $config,
        string $rootTable,
        ?int $limit,
        int $batchSize,
        array $rootIds = []
    ): array {
        $filePath = $outputDir . '/' . $tableName . '.tsv';

        if (Environment::isCli()) {
            echo sprintf("Exporting %s...\n", $tableName);
        }

        // Get columns from config
        $columns = [];
        if (isset($config[$tableName]['primary_key'])) {
            $columns[] = trim($config[$tableName]['primary_key'], '"');
        }

        if (isset($config[$tableName]['foreign_key'])) {
            foreach ($config[$tableName]['foreign_key'] as $fk) {
                $fkColumn = explode(':', $fk)[0];
                $columns[] = $fkColumn;
            }
        }

        if (isset($config[$tableName]['columns'])) {
            foreach ($config[$tableName]['columns'] as $colDef) {
                $colName = explode(':', $colDef)[0];
                $columns[] = $colName;
            }
        }

        // Remove duplicates
        $columns = array_unique($columns);

        // Build query
        $columnList = implode(', ', array_map(function($c) { return "`{$c}`"; }, $columns));
        $sql = "SELECT {$columnList} FROM `{$tableName}`";

        $whereClauses = [];

        // Add WHERE clause for root table if needed
        if ($tableName === $rootTable) {
            $whereClause = $config['_config']['where_clause'] ?? null;
            if ($whereClause) {
                $whereClauses[] = trim($whereClause, '"');
            }
        }

        // Filter related tables by foreign key values from root table
        if ($tableName !== $rootTable && !empty($rootIds) && isset($rootIds[$tableName])) {
            // Use the primary key of this table to filter by the foreign key values collected from root table
            $primaryKey = trim($config[$tableName]['primary_key'] ?? '', '"');
            if ($primaryKey) {
                $idList = implode(',', array_map('intval', array_unique($rootIds[$tableName])));
                if (!empty($idList)) {
                    $whereClauses[] = "`{$primaryKey}` IN ({$idList})";
                }
            }
        }

        if (!empty($whereClauses)) {
            $sql .= " WHERE " . implode(' AND ', $whereClauses);
        }

        // Add LIMIT for root table
        if ($tableName === $rootTable && $limit) {
            $sql .= " LIMIT {$limit}";
        }

        // Execute query
        $result = $connection->query($sql);
        if (!$result) {
            throw new Exception("Query failed for {$tableName}: " . $connection->error);
        }

        // Write to TSV file
        $fp = fopen($filePath, 'w');
        if (!$fp) {
            throw new Exception("Failed to create file: {$filePath}");
        }

        // Write header
        fputcsv($fp, $columns, "\t");

        // Write rows and collect foreign key values
        $rowCount = 0;
        $foreignKeyValues = [];

        while ($row = $result->fetch_assoc()) {
            $values = [];
            foreach ($columns as $col) {
                $values[] = $row[$col] ?? '';
            }
            fputcsv($fp, $values, "\t");
            $rowCount++;

            // Collect foreign key values from root table for filtering related tables
            if ($tableName === $rootTable && isset($config[$tableName]['foreign_key'])) {
                foreach ($config[$tableName]['foreign_key'] as $fk) {
                    list($fkColumn, $fkTarget) = explode(':', $fk);
                    list($targetTable, $targetColumn) = explode('.', $fkTarget);

                    if (isset($row[$fkColumn]) && $row[$fkColumn]) {
                        if (!isset($foreignKeyValues[$targetTable])) {
                            $foreignKeyValues[$targetTable] = [];
                        }
                        $foreignKeyValues[$targetTable][] = $row[$fkColumn];
                    }
                }
            }
        }

        fclose($fp);
        $result->free();

        if (Environment::isCli()) {
            echo sprintf("  ✓ %s rows exported\n", number_format($rowCount));
        }

        return $foreignKeyValues;
    }

}
