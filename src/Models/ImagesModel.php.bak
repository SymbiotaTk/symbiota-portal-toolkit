    /**
     * Refresh hybrid index (rebuild if source data changed)
     */
    private function refreshHybridIndex(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $hybridIndexPath = $config->get('components.images.hybrid_index_db');
            $sourceDbPath = $params['sourcedb'] ?? $params['source-db-path'] ?? $config->get('components.images.source_db');

            if (Environment::isCli()) {
                echo "\n🔄 Refreshing Hybrid Index\n";
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";
            }

            // Check if source.db exists
            if (!file_exists($sourceDbPath)) {
                if (Environment::isCli()) {
                    echo "⚠️  Source database not found: {$sourceDbPath}\n";
                    echo "Run: php index.php images cache --get-source\n\n";
                }
                return [
                    'type' => 'error',
                    'message' => 'Source database not found. Run: images cache --get-source'
                ];
            }

            // Check if hybrid index exists
            if (!file_exists($hybridIndexPath)) {
                if (Environment::isCli()) {
                    echo "⚠️  Hybrid index not found. Building new index...\n\n";
                }
                return $this->buildHybridIndex($params);
            }

            // Check if refresh is needed (compare timestamps)
            $sourceModTime = filemtime($sourceDbPath);
            $indexModTime = filemtime($hybridIndexPath);

            if ($indexModTime >= $sourceModTime && !isset($params['force'])) {
                if (Environment::isCli()) {
                    echo "✅ Hybrid index is up-to-date (no rebuild needed)\n";
                    echo "   Source: " . date('Y-m-d H:i:s', $sourceModTime) . "\n";
                    echo "   Index:  " . date('Y-m-d H:i:s', $indexModTime) . "\n\n";
                    echo "Use --force to rebuild anyway\n\n";
                }
                return [
                    'type' => 'success',
                    'message' => 'Hybrid index is up-to-date'
                ];
            }

            if (Environment::isCli()) {
                echo "🔨 Rebuilding hybrid index (source data changed)...\n\n";
            }

            return $this->buildHybridIndex($params);

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to refresh hybrid index',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
     * Cleanup hybrid index (remove old/temporary files)
     */
    private function cleanupHybridIndex(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $hybridIndexPath = $config->get('components.images.hybrid_index_db');

            if (Environment::isCli()) {
                echo "\n🧹 Cleaning Up Hybrid Index\n";
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";
            }

            $deleted = [];

            // Delete hybrid index if --delete flag is set
            if (isset($params['delete']) && file_exists($hybridIndexPath)) {
                if (unlink($hybridIndexPath)) {
                    $deleted[] = $hybridIndexPath;
                    if (Environment::isCli()) {
                        echo "✅ Deleted: {$hybridIndexPath}\n";
                    }
                }
            }

            // Clean up temporary files (*.tmp, *.bak, etc.)
            $indexDir = dirname($hybridIndexPath);
            $pattern = $indexDir . '/images_hybrid_index*.tmp';
            foreach (glob($pattern) as $tmpFile) {
                if (unlink($tmpFile)) {
                    $deleted[] = $tmpFile;
                    if (Environment::isCli()) {
                        echo "✅ Deleted: {$tmpFile}\n";
                    }
                }
            }

            if (empty($deleted)) {
                if (Environment::isCli()) {
                    echo "ℹ️  No files to clean up\n";
                    if (!isset($params['delete'])) {
                        echo "\nUse --delete to remove the hybrid index database\n";
                    }
                    echo "\n";
                }
                return [
                    'type' => 'success',
                    'message' => 'No files to clean up'
                ];
            }

            if (Environment::isCli()) {
                echo "\n✅ Cleanup complete (" . count($deleted) . " files removed)\n\n";
            }

            return [
                'type' => 'success',
                'message' => 'Cleanup complete',
                'content' => ['deleted' => $deleted]
            ];

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to cleanup hybrid index',
                'content' => $e->getMessage()
            ];
        }
    }

