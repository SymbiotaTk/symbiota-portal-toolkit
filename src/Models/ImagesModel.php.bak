    /**
     * Search images using hybrid mode (indexed fields + MySQL direct queries)
     *
     * @deprecated Use delegateSearch() with ImagesModelHybrid plugin instead
     * @param array $params Search parameters
     * @return array Search results
     */
    private function hybridSearch(array $params): array
    {
        try {
            $config = Configuration::getInstance();

            // Get hybrid index path
            $hybridIndexPath = $config->get('components.images.hybrid_index_db');
            if (empty($hybridIndexPath) || !file_exists($hybridIndexPath)) {
                throw new Exception('Hybrid index not found. Run: php index.php images cache-build-hybrid');
            }

            // Get config path
            $configPath = ApplicationPaths::templatesDirectory() . '/sql/images/eav/index_config.ini';
            if (!file_exists($configPath)) {
                throw new Exception('index_config.ini not found');
            }

            // Initialize hybrid index model
            $hybridIndex = new ImagesModelHybridIndex([
                'config_path' => $configPath,
                'hybrid_index_db_path' => $hybridIndexPath
            ]);

            // Extract search parameters
            $query = $params['query'] ?? '';
            $queryAnd = $params['queryAnd'] ?? [];
            $queryOr = $params['queryOr'] ?? [];
            $limit = (int)($params['limit'] ?? 100);
            $offset = (int)($params['offset'] ?? 0);

            // Parse search query into indexed, direct, and keyword parameters
            $parsedQuery = $this->parseSearchQuery($query, $queryAnd, $queryOr);
            $indexedParams = $parsedQuery['indexed'];
            $directParams = $parsedQuery['direct'];
            $keywords = $parsedQuery['keywords'];

            if (empty($indexedParams) && empty($directParams) && empty($keywords)) {
                return [
                    'type' => 'htmx',
                    'content' => '<div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>No search query provided.</strong> Please add at least one search filter.
                    </div>'
                ];
            }

            // Step 1: Search indexed fields to get initial occid list (if any indexed params)
            $occids = null;
            if (!empty($indexedParams)) {
                $occids = $hybridIndex->searchIndexedFields($indexedParams);

                if (empty($occids)) {
                    // No results from indexed search - return empty
                    $noResultsHtml = $this->renderTemplate('no_results', TemplateFormat::HTML, [
                        'query' => htmlspecialchars($query),
                        'app_url_prefix' => $this->getAppUrlPrefix()
                    ]);

                    return [
                        'type' => 'htmx',
                        'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                            'images_html' => $noResultsHtml,
                            'load_more_html' => ''
                        ])
                    ];
                }
            }

            // Step 2: Apply direct MySQL queries for high-cardinality fields and keywords
            // If we have occids from indexed search, filter by them
            if (!empty($directParams) || !empty($keywords)) {
                $occids = $this->searchDirectFields($directParams, $keywords, $occids);

                if (empty($occids)) {
                    // No results from direct search
                    $noResultsHtml = $this->renderTemplate('no_results', TemplateFormat::HTML, [
                        'query' => htmlspecialchars($query),
                        'app_url_prefix' => $this->getAppUrlPrefix()
                    ]);

                    return [
                        'type' => 'htmx',
                        'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                            'images_html' => $noResultsHtml,
                            'load_more_html' => ''
                        ])
                    ];
                }
            }

            // Step 3: Get media records for the final occid list
            $images = $this->getMediaByOccids($occids, $limit, $offset);

            if (empty($images)) {
                $noResultsHtml = $this->renderTemplate('no_results', TemplateFormat::HTML, [
                    'query' => htmlspecialchars($query),
                    'app_url_prefix' => $this->getAppUrlPrefix()
                ]);

                return [
                    'type' => 'htmx',
                    'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                        'images_html' => $noResultsHtml,
                        'load_more_html' => ''
                    ])
                ];
            }

            // Build load more URL
            $queryParams = [
                'offset' => $offset + $limit,
                'limit' => $limit
            ];
            if (!empty($query)) {
                $queryParams['query'] = $query;
            }
            if (!empty($queryAnd)) {
                $queryParams['queryAnd'] = $queryAnd;
            }
            if (!empty($queryOr)) {
                $queryParams['queryOr'] = $queryOr;
            }

            $queryString = http_build_query($queryParams);
            $loadMoreUrl = $this->getAppUrlPrefix() . 'images/search?' . $queryString;

            // Use unified rendering method
            return $this->renderImagesWithLoadMore($images, $limit, $offset, $loadMoreUrl, $query);

        } catch (Exception $e) {
            $errorMsg = sprintf('Hybrid search failed: %s (File: %s, Line: %d)',
                $e->getMessage(),
                $e->getFile(),
                $e->getLine()
            );

            if (Environment::isCli()) {
                return [
                    'type' => 'error',
                    'content' => $errorMsg
                ];
            }

            return [
                'type' => 'error',
                'message' => $errorMsg,
                'status_code' => 500
            ];
        }
    }

    /**
     * Parse search query into indexed and direct (MySQL) parameters
     *
     * @param string $query Main query string
     * @param array|string $queryAnd Additional AND queries (can be string from CLI)
     * @param array|string $queryOr Additional OR queries (can be string from CLI)
     * @return array ['indexed' => [...], 'direct' => [...], 'keywords' => [...]]
     */
    private function parseSearchQuery(string $query, array|string $queryAnd = [], array|string $queryOr = []): array
    {
        // High-cardinality fields that should be queried directly from MySQL
        $highCardinalityFields = ['catalogNumber', 'otherCatalogNumbers', 'locality', 'catalog'];

        // Fields indexed in hybrid SQLite cache
        $indexedFields = [
            'family', 'genus', 'scientificName', 'sciname', 'sciName',
            'country', 'stateProvince', 'county', 'municipality', 'continent',
            'collectionName', 'collectionCode', 'institutionCode',
            'eventDate', 'date'
        ];

        $indexedParams = [];
        $directParams = [];
        $keywords = [];

        // Normalize queryAnd and queryOr to arrays
        $queryAnd = is_array($queryAnd) ? $queryAnd : ($queryAnd ? [$queryAnd] : []);
        $queryOr = is_array($queryOr) ? $queryOr : ($queryOr ? [$queryOr] : []);

        // Combine all queries
        $allQueries = [];
        if (!empty($query)) {
            $allQueries[] = $query;
        }
        if (!empty($queryAnd)) {
            $allQueries = array_merge($allQueries, $queryAnd);
        }
        // Note: OR queries not fully supported yet

        // Parse each query term
        foreach ($allQueries as $queryTerm) {
            $queryTerm = trim($queryTerm);
            if (empty($queryTerm)) {
                continue;
            }

            // Match field:value pattern
            if (preg_match('/^([a-z]+):(.+)$/i', $queryTerm, $matches)) {
                $field = strtolower($matches[1]);
                $value = trim($matches[2], '"\'');

                // Resolve aliases
                $aliases = [
                    'taxon' => 'sciname',
                    'collection' => 'collectionName',
                    'date' => 'eventDate',
                    'catalog' => 'catalogNumber',
                    'state' => 'stateProvince'
                ];

                if (isset($aliases[$field])) {
                    $field = $aliases[$field];
                }

                // Categorize as indexed or direct
                if (in_array($field, $highCardinalityFields)) {
                    $directParams[$field] = $value;
                } elseif (in_array($field, $indexedFields)) {
                    $indexedParams[$field] = $value;
                } else {
                    // Unknown field - treat as indexed
                    $indexedParams[$field] = $value;
                }
            } else {
                // No field specified - general keyword search
                $keywords[] = $queryTerm;
            }
        }

        return [
            'indexed' => $indexedParams,
            'direct' => $directParams,
            'keywords' => $keywords
        ];
    }

    /**
     * Convert occid list to optimized WHERE clause using ranges
     *
     * @param array $occids Array of occurrence IDs (must be sorted)
     * @return array ['clause' => string, 'params' => array]
     */
    private function buildOccidWhereClause(array $occids): array
    {
        if (empty($occids)) {
            return ['clause' => '1=0', 'params' => []];
        }

        // Sort occids
        sort($occids, SORT_NUMERIC);

        // Find sequences and gaps
        $ranges = [];
        $singles = [];
        $start = $occids[0];
        $prev = $occids[0];

        for ($i = 1; $i < count($occids); $i++) {
            $current = $occids[$i];

            if ($current == $prev + 1) {
                // Continue sequence
                $prev = $current;
            } else {
                // Gap found - save previous sequence
                if ($prev == $start) {
                    // Single value
                    $singles[] = $start;
                } elseif ($prev == $start + 1) {
                    // Two values - use singles (more efficient than BETWEEN)
                    $singles[] = $start;
                    $singles[] = $prev;
                } else {
                    // Range of 3+ values
                    $ranges[] = [$start, $prev];
                }

                // Start new sequence
                $start = $current;
                $prev = $current;
            }
        }

        // Handle last sequence
        if ($prev == $start) {
            $singles[] = $start;
        } elseif ($prev == $start + 1) {
            $singles[] = $start;
            $singles[] = $prev;
        } else {
            $ranges[] = [$start, $prev];
        }

        // Build WHERE clause
        $clauses = [];
        $params = [];

        if (!empty($singles)) {
            $placeholders = implode(',', array_fill(0, count($singles), '?'));
            $clauses[] = "o.occid IN ($placeholders)";
            $params = array_merge($params, $singles);
        }

        foreach ($ranges as $range) {
            $clauses[] = "(o.occid BETWEEN ? AND ?)";
            $params[] = $range[0];
            $params[] = $range[1];
        }

        $clause = implode(' OR ', $clauses);

        return ['clause' => "($clause)", 'params' => $params];
    }

    /**
     * Search high-cardinality fields directly in MySQL
     *
     * @param array $directParams Field:value pairs for direct MySQL search
     * @param array $keywords General keywords to search across multiple fields
     * @param array|null $filterOccids Optional occid list to filter by (from indexed search)
     * @return array Array of occurrence IDs matching the criteria
     */
    private function searchDirectFields(array $directParams, array $keywords, ?array $filterOccids = null): array
    {
        if (empty($directParams) && empty($keywords)) {
            return $filterOccids ?? [];
        }

        try {
            $db = $this->getDatabaseConnection('readonly');
            if (!$db) {
                error_log("Database connection failed in searchDirectFields");
                return [];
            }

            // Build WHERE clauses
            $whereClauses = [];
            $params = [];
            $paramTypes = ''; // Track parameter types for mysqli bind_param

            // Add filter by occids if provided (from indexed search)
            if ($filterOccids !== null && !empty($filterOccids)) {
                $occidFilter = $this->buildOccidWhereClause($filterOccids);
                $whereClauses[] = $occidFilter['clause'];
                $params = array_merge($params, $occidFilter['params']);
                // Occids are integers
                $paramTypes .= str_repeat('i', count($occidFilter['params']));
            }

            // Add direct field searches
            foreach ($directParams as $field => $value) {
                switch ($field) {
                    case 'catalogNumber':
                        $whereClauses[] = "o.catalogNumber LIKE ?";
                        $params[] = $value . '%';
                        $paramTypes .= 's';
                        break;
                    case 'otherCatalogNumbers':
                        $whereClauses[] = "o.otherCatalogNumbers LIKE ?";
                        $params[] = '%' . $value . '%';
                        $paramTypes .= 's';
                        break;
                    case 'locality':
                        $whereClauses[] = "LOWER(o.locality) LIKE LOWER(?)";
                        $params[] = '%' . $value . '%';
                        $paramTypes .= 's';
                        break;
                }
            }

            // Add keyword searches (search across multiple text fields)
            foreach ($keywords as $keyword) {
                $keywordClauses = [
                    "LOWER(o.locality) LIKE LOWER(?)",
                    "LOWER(c.collectionName) LIKE LOWER(?)",
                    "LOWER(c.collectionCode) LIKE LOWER(?)",
                    "LOWER(c.institutionCode) LIKE LOWER(?)",
                    "LOWER(o.sciname) LIKE LOWER(?)",
                    "LOWER(o.family) LIKE LOWER(?)",
                    "LOWER(o.genus) LIKE LOWER(?)"
                ];
                $whereClauses[] = '(' . implode(' OR ', $keywordClauses) . ')';
                $keywordPattern = '%' . $keyword . '%';
                $params = array_merge($params, array_fill(0, count($keywordClauses), $keywordPattern));
                $paramTypes .= str_repeat('s', count($keywordClauses));
            }

            if (empty($whereClauses)) {
                return $filterOccids ?? [];
            }

            // Build and execute query
            $sql = "
                SELECT DISTINCT o.occid
                FROM omoccurrences o
                LEFT JOIN omcollections c ON o.collid = c.collID
                WHERE " . implode(' AND ', $whereClauses) . "
                ORDER BY o.occid
            ";

            $stmt = $db->prepare($sql);
            if (!$stmt) {
                error_log("Error preparing statement: " . $db->error);
                return [];
            }

            // Bind parameters dynamically
            if (!empty($params)) {
                $types = str_repeat('s', count($params)); // All strings for LIKE queries
                $stmt->bind_param($types, ...$params);
            }

            $stmt->execute();
            $result = $stmt->get_result();

            $occids = [];
            while ($row = $result->fetch_assoc()) {
                $occids[] = (int)$row['occid'];
            }

            $stmt->close();

            return $occids;

        } catch (Exception $e) {
            error_log("Error in searchDirectFields: " . $e->getMessage());
            return [];
        }
    }

    /**
     * Get media records by occurrence IDs
     *
     * @param array $occids Array of occurrence IDs
     * @param int $limit Result limit
     * @param int $offset Result offset
     * @return array Array of media records
     */
    private function getMediaByOccids(array $occids, int $limit = 100, int $offset = 0): array
    {
        if (empty($occids)) {
            return [];
        }

        try {
            $connection = $this->getDatabaseConnection('readonly');
            if (!$connection) {
                throw new Exception('Database connection failed');
            }

            // Paginate occids
            $paginatedOccids = array_slice($occids, $offset, $limit);

            if (empty($paginatedOccids)) {
                return [];
            }

            // Build query to get media for these occids
            $occidList = implode(',', array_map('intval', $paginatedOccids));

            $sql = "
                SELECT DISTINCT
                    m.mediaID,
                    m.url,
                    m.thumbnailUrl,
                    m.caption,
                    m.creator,
                    m.occid,
                    o.catalogNumber,
                    o.sciname,
                    c.collectionName,
                    c.collectionCode
                FROM media m
                LEFT JOIN omoccurrences o ON m.occid = o.occid
                LEFT JOIN omcollections c ON o.collid = c.collid
                WHERE m.occid IN ({$occidList})
                ORDER BY m.mediaID
            ";

            $result = $connection->query($sql);
            if (!$result) {
                throw new Exception('Query failed: ' . $connection->error);
            }

            $images = [];
            while ($row = $result->fetch_assoc()) {
                $images[] = $row;
            }

            return $images;

        } catch (Exception $e) {
            error_log("Error fetching media by occids: " . $e->getMessage());
            return [];
        }
    }

    /**
     * Get media records by their IDs
     *
     * @param array $mediaIds Array of media IDs
     * @return array Array of media records
     */
    private function getMediaByIds(array $mediaIds): array
    {
        if (empty($mediaIds)) {
            return [];
        }

        try {
            $connection = $this->getDatabaseConnection('readonly');
            if (!$connection) {
                throw new Exception('Database connection failed');
            }

            // Build IN clause with placeholders
            $placeholders = implode(',', array_fill(0, count($mediaIds), '?'));

            $sql = "SELECT
                        m.mediaID,
                        m.occid,
                        m.url,
                        m.originalUrl,
                        m.thumbnailUrl,
                        m.caption,
                        m.creator,
                        m.anatomy,
                        m.locality as media_locality,
                        m.initialTimestamp,
                        o.sciname,
                        o.locality as occurrence_locality,
                        o.eventdate,
                        o.catalognumber,
                        o.family,
                        o.genus,
                        c.collectionname,
                        c.institutioncode,
                        c.collectioncode
                    FROM media m
                    LEFT JOIN omoccurrences o ON o.occid = m.occid
                    LEFT JOIN omcollections c ON o.collid = c.collid
                    WHERE m.mediaID IN ($placeholders)
                    AND m.url IS NOT NULL AND m.url != ''";

            $stmt = $connection->prepare($sql);
            if (!$stmt) {
                throw new Exception('Failed to prepare query: ' . $connection->error);
            }

            // Bind parameters dynamically
            $types = str_repeat('i', count($mediaIds));
            $stmt->bind_param($types, ...$mediaIds);

            if (!$stmt->execute()) {
                throw new Exception('Failed to execute query: ' . $stmt->error);
            }

            $result = $stmt->get_result();
            $images = [];

            while ($row = $result->fetch_assoc()) {
                $images[] = $row;
            }

            $stmt->close();

            return $images;

        } catch (Exception $e) {
            error_log(sprintf('Error fetching media by IDs: %s', $e->getMessage()));
            return [];
        }
    }

    /**
     * Search images using EAV index for comprehensive search
     *
     * @deprecated Use delegateSearch() with ImagesModelEav plugin instead
     */
    public function eavSearch(array $params): array
    {
        try {
            // Get cache database path from config
            $dbPath = $params['db-path'] ?? $this->getEavCachePath();

            // Check if cache exists and is fresh
            if (!file_exists($dbPath)) {
                if (Environment::isCli()) {
                    echo "\n⚠️  EAV index not found. Building index...\n\n";
                }
                if (!$this->ensureCacheReady($dbPath)) {
                    throw new Exception('Failed to build EAV index. Please run: php index.php images cache-build-eav');
                }
            } elseif ($this->isCacheStale($dbPath)) {
                if (Environment::isCli()) {
                    echo "\n⚠️  EAV cache is stale. Rebuilding...\n\n";
                }
                $this->ensureCacheReady($dbPath);
            }

            // Open database in read-only mode for safety and better concurrency
            $db = new PDO(sprintf('sqlite:%s', $dbPath), null, null, [
                PDO::SQLITE_ATTR_OPEN_FLAGS => PDO::SQLITE_OPEN_READONLY
            ]);
            $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

            // Handle --parameters flag to list available search fields
            if (isset($params['parameters']) || isset($params['params'])) {
                return $this->listEavParameters($db);
            }

            // Handle query parameter - collect all positional args if --query not provided
            $query = $params['query'] ?? $params['search'] ?? '';

            // If query is an array (from repeated --query parameters), join them
            if (is_array($query)) {
                $query = implode(' ', $query);
            }

            // If no named query parameter, collect all positional arguments
            if (empty($query)) {
                $positionalArgs = [];
                for ($i = 0; isset($params[$i]); $i++) {
                    $positionalArgs[] = $params[$i];
                }
                $query = implode(' ', $positionalArgs);
            }

            // Handle multiple query conditions (AND/OR logic)
            $queryAnd = $params['queryAnd'] ?? [];
            $queryOr = $params['queryOr'] ?? [];

            // Ensure they are arrays
            if (!is_array($queryAnd)) {
                $queryAnd = [$queryAnd];
            }
            if (!is_array($queryOr)) {
                $queryOr = [$queryOr];
            }

            // Parse limit and offset parameters
            $limit = (int)($params['limit'] ?? 20);
            $offset = (int)($params['offset'] ?? 0);

            // Parse sortBy parameter (comma-separated list of fields)
            $sortBy = [];
            if (isset($params['sortBy'])) {
                $sortBy = array_map('trim', explode(',', $params['sortBy']));
            }

            // Validate that we have at least one query
            if (empty($query) && empty($queryAnd) && empty($queryOr)) {
                if (Environment::isCli()) {
                    return [
                        'type' => 'error',
                        'message' => 'Search query is required. Use --query, --queryAnd[], or --queryOr[]',
                        'status_code' => 400
                    ];
                } else {
                    // For web, return HTMX content with error message
                    return [
                        'type' => 'htmx',
                        'content' => '<div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>No search query provided.</strong> Please add at least one search filter.
                        </div>'
                    ];
                }
            }

            // Search in EAV index
            $entities = $this->searchEavIndex($db, $query, $queryAnd, $queryOr, $limit, $offset, $sortBy);

            if (Environment::isCli()) {
                // Build query description
                $queryDesc = [];
                if (!empty($query)) $queryDesc[] = $query;
                if (!empty($queryAnd)) $queryDesc[] = 'AND[' . implode(', ', $queryAnd) . ']';
                if (!empty($queryOr)) $queryDesc[] = 'OR[' . implode(', ', $queryOr) . ']';
                $queryStr = implode(' ', $queryDesc);

                $outputLines = [
                    sprintf("EAV search results for '%s' (%d found):", $queryStr, count($entities)),
                    str_repeat("-", 50)
                ];

                foreach ($entities as $entity) {
                    $details = [];

                    if (!empty($entity['sciName'])) $details[] = "Species: {$entity['sciName']}";
                    if (!empty($entity['collectionName'])) $details[] = "Collection: {$entity['collectionName']}";
                    if (!empty($entity['occid'])) $details[] = "OccID: {$entity['occid']}";
                    if (!empty($entity['catalogNumber'])) $details[] = "Catalog: {$entity['catalogNumber']}";
                    if (!empty($entity['eventDate'])) $details[] = "Date: {$entity['eventDate']}";

                    $detailsStr = !empty($details) ? ' (' . implode(', ', $details) . ')' : '';
                    $filename = basename($entity['url'] ?? 'Unknown');

                    $outputLines[] = sprintf("- %s%s", $filename, $detailsStr);

                    if (!empty($entity['url'])) {
                        $outputLines[] = sprintf("  Full Image: %s", $entity['url']);
                    }
                    if (!empty($entity['thumbnailUrl'])) {
                        $outputLines[] = sprintf("  Thumbnail: %s", $entity['thumbnailUrl']);
                    }
                    $outputLines[] = ""; // Add blank line between results
                }

                if (empty($entities)) {
                    $outputLines[] = "No images found matching the search criteria.";
                    $outputLines[] = "";
                    $outputLines[] = "Search tips:";
                    $outputLines[] = "  - Use field:value syntax (e.g., sciname:amanita, collectioncode:mich)";
                    $outputLines[] = "  - Search is case-insensitive";
                    $outputLines[] = "  - Prefix matching is used (e.g., 'aman' matches 'amanita')";
                }

                return [
                    'type' => 'success',
                    'content' => implode("\n", $outputLines)
                ];
            }

            // Convert EAV entities to image format for web display
            $images = $this->convertEavEntitiesToImages($entities);

            // Build load more URL with all query parameters
            $nextOffset = $offset + $limit;
            $queryParams = [
                'query' => $query,
                'limit' => $limit,
                'offset' => $nextOffset
            ];

            // Add queryAnd and queryOr if present
            if (!empty($queryAnd)) {
                foreach ($queryAnd as $andQuery) {
                    $queryParams['queryAnd'][] = $andQuery;
                }
            }
            if (!empty($queryOr)) {
                foreach ($queryOr as $orQuery) {
                    $queryParams['queryOr'][] = $orQuery;
                }
            }

            // Add sortBy if present
            if (!empty($sortBy)) {
                $queryParams['sortBy'] = implode(',', $sortBy);
            }

            $queryString = http_build_query($queryParams);
            $loadMoreUrl = $this->getAppUrlPrefix() . 'images/search?' . $queryString;

            // Use unified rendering method
            return $this->renderImagesWithLoadMore($images, $limit, $offset, $loadMoreUrl, $query);

        } catch (Exception $e) {
            $errorMsg = sprintf('EAV search failed: %s (File: %s, Line: %d)',
                $e->getMessage(),
                $e->getFile(),
                $e->getLine()
            );

            if (Environment::isCli()) {
                return [
                    'type' => 'error',
                    'content' => $errorMsg
                ];
            }

            return [
                'type' => 'error',
                'message' => $errorMsg,
                'status_code' => 500
            ];
        }
    }

    /**
     * List available EAV search parameters
     */
    private function listEavParameters(PDO $db): array
    {
        $stmt = $db->query("
            SELECT TableName, ColumnName, IsNumeric
            FROM Attributes
            ORDER BY TableName, ColumnName
        ");
        $attributes = $stmt->fetchAll(PDO::FETCH_ASSOC);

        if (Environment::isCli()) {
            $outputLines = [
                "Available EAV Search Parameters",
                str_repeat("=", 50),
                "",
                "Field Aliases (defined in index_config.ini):",
                "  Taxonomy:",
                "    taxon:<value>, sciname:<value>  - Scientific name",
                "    genus:<value>                   - Genus",
                "    family:<value>                  - Family",
                "",
                "  Geography:",
                "    state:<value>, stateprovince:<value>  - State/Province",
                "    country:<value>                       - Country",
                "    locality:<value>                      - Locality",
                "    county:<value>                        - County",
                "    municipality:<value>                  - Municipality",
                "",
                "  Collection:",
                "    collection:<value>              - Collection name",
                "    collectioncode:<value>          - Collection code",
                "    catalog:<value>                 - Catalog number",
                "",
                "  Occurrence:",
                "    occid:<value>                   - Occurrence ID (numeric)",
                "",
                "  Date (special handling):",
                "    date:<value>, eventdate:<value> - Event date",
                "      Formats: <1980, >2000, 1976, 1976,1977,1978, 1976-1978",
                "",
                "Note: Aliases are configured in templates/sql/images/eav/index_config.ini",
                "      You can add custom aliases by editing the [aliases] section.",
                "",
                "All Indexed Fields (for free text search):",
                ""
            ];

            $currentTable = '';
            foreach ($attributes as $attr) {
                if ($currentTable !== $attr['TableName']) {
                    $currentTable = $attr['TableName'];
                    $outputLines[] = sprintf("  %s:", $currentTable);
                }
                $type = $attr['IsNumeric'] ? 'numeric' : 'text';
                $outputLines[] = sprintf("    - %s (%s)", $attr['ColumnName'], $type);
            }

            $outputLines[] = "";
            $outputLines[] = "Examples:";
            $outputLines[] = "  Single query:";
            $outputLines[] = "    php index.php images eav-search --query=\"taxon:Faxonella\"";
            $outputLines[] = "";
            $outputLines[] = "  Multiple AND conditions (CLI-friendly - use repeated parameters):";
            $outputLines[] = "    php index.php images eav-search --queryAnd=taxon:Faxonella --queryAnd=date:<1980";
            $outputLines[] = "    php index.php images eav-search --queryAnd=taxon:Faxonella --queryAnd=state:Alabama --queryAnd=date:1974-1978";
            $outputLines[] = "";
            $outputLines[] = "  Date formats:";
            $outputLines[] = "    php index.php images eav-search --query=\"date:1974\"           # Single year";
            $outputLines[] = "    php index.php images eav-search --query=\"date:1974,1996,2000\" # Multiple years";
            $outputLines[] = "    php index.php images eav-search --query=\"date:1974-1978\"      # Year range";
            $outputLines[] = "    php index.php images eav-search --query=\"date:<1980\"          # Before 1980";
            $outputLines[] = "";
            $outputLines[] = "  Multiple OR conditions:";
            $outputLines[] = "    php index.php images eav-search --queryOr=taxon:Faxonella --queryOr=taxon:Lepomis";
            $outputLines[] = "";
            $outputLines[] = "  Sorting:";
            $outputLines[] = "    php index.php images eav-search --query=\"taxon:Faxonella\" --sortBy=eventDate,catalogNumber";
            $outputLines[] = "";
            $outputLines[] = "  Pagination:";
            $outputLines[] = "    php index.php images eav-search --query=\"taxon:Faxonella\" --offset=50 --limit=100";
            $outputLines[] = "";
            $outputLines[] = "Note: You can use --queryAnd=value or --queryAnd[]=value (both work).";
            $outputLines[] = "      The [] syntax is HTTP-friendly but may need quoting in some shells.";
            $outputLines[] = "";

            return [
                'type' => 'success',
                'content' => implode("\n", $outputLines)
            ];
        }

        return [
            'type' => 'success',
            'content' => [
                'attributes' => $attributes
            ]
        ];
    }

    /**
     * Search the EAV index for entities matching the query
     */
    private function searchEavIndex(PDO $db, string $query, array $queryAnd, array $queryOr, int $limit, int $offset, array $sortBy): array
    {
        // Collect all entity IDs from different query types
        $entityIdSets = [];

        // Process main query (use higher limit for AND/OR combinations)
        // Use 10000 as a reasonable max to avoid memory issues
        $maxQueryLimit = 10000;
        $queryLimit = (!empty($queryAnd) || !empty($queryOr)) ? $maxQueryLimit : ($limit + $offset);

        if (!empty($query)) {
            $entityIdSets['main'] = $this->executeEavQuery($db, $query, $queryLimit);
        }

        // Process AND queries (use higher limit - we need all results for intersection)
        if (!empty($queryAnd)) {
            foreach ($queryAnd as $andQuery) {
                $results = $this->executeEavQuery($db, $andQuery, $maxQueryLimit);
                $entityIdSets['and_' . md5($andQuery)] = $results;
            }
        }

        // Process OR queries (use higher limit - we need all results for union)
        if (!empty($queryOr)) {
            $orEntityIds = [];
            foreach ($queryOr as $orQuery) {
                $orResults = $this->executeEavQuery($db, $orQuery, $maxQueryLimit);
                $orEntityIds = array_merge($orEntityIds, $orResults);
            }
            if (!empty($orEntityIds)) {
                $entityIdSets['or'] = array_unique($orEntityIds);
            }
        }

        // Combine results based on logic
        // Logic: (main AND and1 AND and2 AND ...) AND (or1 OR or2 OR ...)
        // All conditions must be satisfied:
        // - If there's a main query, results must match it
        // - If there are AND queries, results must match ALL of them
        // - If there are OR queries, results must match AT LEAST ONE of them
        $finalEntityIds = [];

        // Step 1: Collect all AND sets (main + queryAnd)
        $andSets = [];
        foreach ($entityIdSets as $key => $set) {
            if ($key !== 'or') {
                $andSets[] = $set;
            }
        }

        // Step 2: Intersect all AND sets
        if (!empty($andSets)) {
            $finalEntityIds = $andSets[0];
            for ($i = 1; $i < count($andSets); $i++) {
                $finalEntityIds = array_intersect($finalEntityIds, $andSets[$i]);
            }
            // Re-index array after intersection
            $finalEntityIds = array_values($finalEntityIds);
        }

        // Step 3: If there are OR conditions, intersect them with AND results
        // The OR conditions form a union, then that union is intersected with AND results
        if (isset($entityIdSets['or'])) {
            if (!empty($finalEntityIds)) {
                // Intersect OR results with existing AND results
                $finalEntityIds = array_values(array_intersect($finalEntityIds, $entityIdSets['or']));
            } else {
                // No AND conditions, just use OR results
                $finalEntityIds = $entityIdSets['or'];
            }
        }

        if (empty($finalEntityIds)) {
            return [];
        }

        // If sorting is requested, we need to load more data before limiting
        // Otherwise, apply limit to entity IDs to prevent memory issues
        if (!empty($sortBy)) {
            // Load all entities (up to maxQueryLimit) for sorting
            $loadLimit = min(count($finalEntityIds), $maxQueryLimit);
            $entitiesToLoad = array_slice($finalEntityIds, 0, $loadLimit);
            $entities = $this->getEavEntities($db, $entitiesToLoad);

            // Sort the entities
            $entities = $this->sortEavEntities($entities, $sortBy);

            // Apply offset and limit after sorting
            return array_slice($entities, $offset, $limit);
        } else {
            // No sorting - apply limit to entity IDs before loading
            $limitedEntityIds = array_slice($finalEntityIds, $offset, $limit);
            return $this->getEavEntities($db, $limitedEntityIds);
        }
    }

    /**
     * Load field aliases from config
     */
    private function loadFieldAliases(): array
    {
        $configPath = __DIR__ . '/../../templates/sql/images/eav/index_config.ini';
        if (!file_exists($configPath)) {
            return [];
        }

        $config = parse_ini_file($configPath, true);
        return $config['aliases'] ?? [];
    }

    /**
     * Execute eventDate query with special handling for operators and ranges
     */
    private function executeEventDateQuery(PDO $db, string $searchValue, int $limit): array
    {
        if (preg_match('/^([<>=]+)(.+)$/', $searchValue, $dateMatches)) {
            // Operator format: <1980, >2000, etc.
            $operator = $dateMatches[1];
            $dateValue = trim($dateMatches[2]);

            $sql = "SELECT DISTINCT e.Eid
                    FROM Entities e
                    JOIN EAV eav ON e.Eid = eav.Eid
                    JOIN Attributes a ON eav.Aid = a.Aid
                    JOIN ValuesText v ON eav.Vid = v.Vid
                    WHERE a.ColumnName = 'eventDate'
                    AND v.ValueText " . $operator . " :search
                    LIMIT :limit";

            $stmt = $db->prepare($sql);
            $stmt->bindValue(':search', $dateValue, PDO::PARAM_STR);
            $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
            $stmt->execute();
            return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);

        } elseif (strpos($searchValue, ',') !== false) {
            // Multiple years: 1976,1977,1978
            $years = array_map('trim', explode(',', $searchValue));
            $conditions = [];
            foreach ($years as $year) {
                $conditions[] = "v.ValueText LIKE '" . $year . "%'";
            }

            $sql = "SELECT DISTINCT e.Eid
                    FROM Entities e
                    JOIN EAV eav ON e.Eid = eav.Eid
                    JOIN Attributes a ON eav.Aid = a.Aid
                    JOIN ValuesText v ON eav.Vid = v.Vid
                    WHERE a.ColumnName = 'eventDate'
                    AND (" . implode(' OR ', $conditions) . ")
                    LIMIT :limit";

            $stmt = $db->prepare($sql);
            $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
            $stmt->execute();
            return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);

        } elseif (preg_match('/^(\d{4})-(\d{4})$/', $searchValue, $rangeMatches)) {
            // Year range: 1976-1978
            $startYear = $rangeMatches[1];
            $endYear = $rangeMatches[2];

            $sql = "SELECT DISTINCT e.Eid
                    FROM Entities e
                    JOIN EAV eav ON e.Eid = eav.Eid
                    JOIN Attributes a ON eav.Aid = a.Aid
                    JOIN ValuesText v ON eav.Vid = v.Vid
                    WHERE a.ColumnName = 'eventDate'
                    AND v.ValueText >= :startYear
                    AND v.ValueText < :endYearNext
                    LIMIT :limit";

            $stmt = $db->prepare($sql);
            $stmt->bindValue(':startYear', $startYear, PDO::PARAM_STR);
            $stmt->bindValue(':endYearNext', ((int)$endYear + 1) . '-01-01', PDO::PARAM_STR);
            $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
            $stmt->execute();
            return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);

        } else {
            // Single year: 1980
            $sql = "SELECT DISTINCT e.Eid
                    FROM Entities e
                    JOIN EAV eav ON e.Eid = eav.Eid
                    JOIN Attributes a ON eav.Aid = a.Aid
                    JOIN ValuesText v ON eav.Vid = v.Vid
                    WHERE a.ColumnName = 'eventDate'
                    AND v.ValueText LIKE :search
                    LIMIT :limit";

            $stmt = $db->prepare($sql);
            $stmt->bindValue(':search', $searchValue . '%', PDO::PARAM_STR);
            $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
            $stmt->execute();
            return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
        }
    }

    /**
     * Execute collection query across multiple fields
     * Searches collectionName, collectionCode, and institutionCode with LIKE
     * Case-insensitive prefix match (e.g., 'cup' matches 'CUP', 'Cup', etc.)
     */
    private function executeCollectionQuery(PDO $db, string $searchValue, int $limit): array
    {
        // Search across collectionName, collectionCode, and institutionCode
        // Return union of all matches
        // Case-insensitive search using LOWER() since ValuesText is stored in lowercase
        $sql = "SELECT DISTINCT e.Eid
                FROM Entities e
                JOIN EAV eav ON e.Eid = eav.Eid
                JOIN Attributes a ON eav.Aid = a.Aid
                JOIN ValuesText v ON eav.Vid = v.Vid
                WHERE (
                    a.ColumnName = 'collectionName'
                    OR a.ColumnName = 'collectionCode'
                    OR a.ColumnName = 'institutionCode'
                )
                AND v.ValueText LIKE :search
                LIMIT :limit";

        $stmt = $db->prepare($sql);
        // Convert to lowercase for case-insensitive matching, prefix match
        $stmt->bindValue(':search', strtolower($searchValue) . '%', PDO::PARAM_STR);
        $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
        $stmt->execute();
        return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
    }

    /**
     * Execute a single EAV query and return entity IDs
     */
    private function executeEavQuery(PDO $db, string $query, int $limit): array
    {
        // Load field aliases from config
        static $aliases = null;
        if ($aliases === null) {
            $aliases = $this->loadFieldAliases();
        }

        // Parse query for prefix-based searches
        // Support both specific prefixes and generic field:value format
        $searchType = 'freetext';
        $searchValue = $query;
        $fieldName = null;

        // Match field:value pattern
        if (preg_match('/^([a-z]+):(.+)$/i', $query, $matches)) {
            $prefix = strtolower($matches[1]);
            $searchValue = trim($matches[2]);

            // Special handling for 'collection' - search across multiple fields
            if ($prefix === 'collection') {
                return $this->executeCollectionQuery($db, $searchValue, $limit);
            }

            // Check if this is an alias
            if (isset($aliases[$prefix])) {
                $fieldName = $aliases[$prefix];
                $searchType = 'field';
            } else {
                // Check if the prefix matches an actual attribute name (case-insensitive)
                // This allows searching by attribute name directly without needing an alias
                $attrCheckStmt = $db->prepare("SELECT ColumnName FROM Attributes WHERE LOWER(ColumnName) = :prefix LIMIT 1");
                $attrCheckStmt->bindValue(':prefix', $prefix, PDO::PARAM_STR);
                $attrCheckStmt->execute();
                $actualColumnName = $attrCheckStmt->fetchColumn();

                if ($actualColumnName) {
                    // Found a matching attribute - use it as a field search
                    $fieldName = $actualColumnName;
                    $searchType = 'field';
                } else {
                    // Not an alias or attribute - treat as freetext
                    $searchType = 'freetext';
                }
            }
        }

        // Build SQL based on search type
        switch ($searchType) {
            case 'field':
                // Generic field search using alias mapping
                // Special handling for eventDate (supports operators and ranges)
                if ($fieldName === 'eventDate') {
                    return $this->executeEventDateQuery($db, $searchValue, $limit);
                }

                // Check if this is a numeric field by querying Attributes table (data-driven, not hardcoded)
                $dataTypeStmt = $db->prepare("SELECT DataType FROM Attributes WHERE ColumnName = :fieldName LIMIT 1");
                $dataTypeStmt->bindValue(':fieldName', $fieldName, PDO::PARAM_STR);
                $dataTypeStmt->execute();
                $dataType = $dataTypeStmt->fetchColumn();

                if ($dataType === 'numeric' && is_numeric($searchValue)) {
                    // Numeric field search - exact match on ValueNumber
                    $sql = "SELECT DISTINCT e.Eid
                            FROM Entities e
                            JOIN EAV eav ON e.Eid = eav.Eid
                            JOIN Attributes a ON eav.Aid = a.Aid
                            WHERE a.ColumnName = :fieldName
                            AND eav.ValueNumber = :search
                            LIMIT :limit";

                    $stmt = $db->prepare($sql);
                    $stmt->bindValue(':fieldName', $fieldName, PDO::PARAM_STR);
                    // Use float for decimals (coordinates), int for IDs
                    $stmt->bindValue(':search', (float)$searchValue, PDO::PARAM_STR);
                    $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
                    $stmt->execute();
                    return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
                } else {
                    // Text field search with normalized EAV schema
                    // Simple JOIN on Vid - fast and indexed!
                    // Case-insensitive search using LOWER() since ValuesText is stored in lowercase
                    $sql = "SELECT DISTINCT e.Eid, COUNT(DISTINCT eav.Vid) as relevance
                            FROM Entities e
                            JOIN EAV eav ON e.Eid = eav.Eid
                            JOIN Attributes a ON eav.Aid = a.Aid
                            JOIN ValuesText v ON eav.Vid = v.Vid
                            WHERE a.ColumnName = :fieldName
                            AND v.ValueText LIKE :search
                            GROUP BY e.Eid
                            ORDER BY relevance DESC, e.Eid
                            LIMIT :limit";

                    $stmt = $db->prepare($sql);
                    $stmt->bindValue(':fieldName', $fieldName, PDO::PARAM_STR);
                    // Convert search to lowercase for case-insensitive matching
                    $stmt->bindValue(':search', strtolower($searchValue) . '%', PDO::PARAM_STR); // Prefix match
                    $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
                    $stmt->execute();
                    return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
                }
                break;

            default: // freetext or unrecognized prefix
                // Freetext search across all text attributes with normalized EAV
                // Case-insensitive search using LOWER() since ValuesText is stored in lowercase
                $sql = "SELECT DISTINCT e.Eid, COUNT(DISTINCT eav.Vid) as relevance
                        FROM Entities e
                        JOIN EAV eav ON e.Eid = eav.Eid
                        JOIN ValuesText v ON eav.Vid = v.Vid
                        WHERE v.ValueText LIKE :search
                        GROUP BY e.Eid
                        ORDER BY relevance DESC, e.Eid
                        LIMIT :limit";
                // Convert search to lowercase for case-insensitive matching
                $searchValue = strtolower($searchValue) . '%'; // Prefix match
                break;
        }

        $stmt = $db->prepare($sql);
        $stmt->bindValue(':search', $searchValue, is_int($searchValue) ? PDO::PARAM_INT : PDO::PARAM_STR);
        $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
        $stmt->execute();

        // Return just the entity IDs (Eid column)
        return $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
    }

    /**
     * Sort EAV entities by specified fields
     */
    private function sortEavEntities(array $entities, array $sortBy): array
    {
        usort($entities, function($a, $b) use ($sortBy) {
            foreach ($sortBy as $field) {
                $aVal = $a[$field] ?? '';
                $bVal = $b[$field] ?? '';

                // Try numeric comparison first
                if (is_numeric($aVal) && is_numeric($bVal)) {
                    $cmp = $aVal <=> $bVal;
                } else {
                    $cmp = strcasecmp($aVal, $bVal);
                }

                if ($cmp !== 0) {
                    return $cmp;
                }
            }
            return 0;
        });

        return $entities;
    }

    /**
     * Get full entity data from EAV index
     * Handles normalized schema: reassembles :split attributes using VidOrder
     */
    private function getEavEntities(PDO $db, array $entityIds): array
    {
        $placeholders = implode(',', array_fill(0, count($entityIds), '?'));

        // First, get display fields from Entities table
        $displaySql = sprintf("
            SELECT Eid, EntityValue, url, originalUrl, thumbnailUrl
            FROM Entities
            WHERE Eid IN (%s)
        ", $placeholders);

        $stmt = $db->prepare($displaySql);
        $stmt->execute($entityIds);
        $displayRows = $stmt->fetchAll(PDO::FETCH_ASSOC);

        // Initialize entities with display fields
        $entities = [];
        foreach ($displayRows as $row) {
            $entities[$row['Eid']] = $row;
        }

        // Query EAV data with VidOrder to reassemble split tokens
        $sql = sprintf("
            SELECT
                e.Eid,
                a.ColumnName,
                a.TokenStrategy,
                eav.VidOrder,
                COALESCE(v.ValueText, CAST(eav.ValueNumber AS TEXT)) as Value
            FROM Entities e
            JOIN EAV eav ON e.Eid = eav.Eid
            JOIN Attributes a ON eav.Aid = a.Aid
            LEFT JOIN ValuesText v ON eav.Vid = v.Vid
            WHERE e.Eid IN (%s)
            ORDER BY e.Eid, a.ColumnName, eav.VidOrder
        ", $placeholders);

        $stmt = $db->prepare($sql);
        $stmt->execute($entityIds);
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);

        // Add EAV attributes to entities and reassemble split attributes
        foreach ($rows as $row) {
            $eid = $row['Eid'];
            $columnName = $row['ColumnName'];
            $value = $row['Value'];
            $tokenStrategy = $row['TokenStrategy'];

            // Handle :split attributes - reassemble tokens in order
            if ($tokenStrategy === 'split' && $row['VidOrder'] !== null) {
                if (!isset($entities[$eid][$columnName])) {
                    $entities[$eid][$columnName] = [];
                }
                $entities[$eid][$columnName][] = $value;
            } else {
                // :whole or numeric - single value
                $entities[$eid][$columnName] = $value;
            }
        }

        // Join split attribute tokens back into strings
        foreach ($entities as &$entity) {
            foreach ($entity as $key => &$value) {
                if (is_array($value)) {
                    $value = implode(' ', $value);
                }
            }
        }

        return array_values($entities);
    }

    /**
     * Convert EAV entities to image format
     * Uses ONLY original database column names - no artificial field names
     */
    private function convertEavEntitiesToImages(array $entities): array
    {
        $images = [];

        foreach ($entities as $entity) {
            // Use ONLY original column names from database
            // Cast mediaID to int to avoid float formatting (802566.0 -> 802566)
            // EntityValue contains the mediaID
            $mediaID = $entity['mediaID'] ?? $entity['EntityValue'] ?? $entity['Eid'] ?? 0;
            $mediaID = (int)$mediaID;

            $images[] = [
                'mediaID' => $mediaID,
                'occid' => $entity['occid'] ?? null,
                'url' => $entity['url'] ?? '',
                'originalUrl' => $entity['originalUrl'] ?? $entity['url'] ?? '',
                'thumbnailUrl' => $entity['thumbnailUrl'] ?? $entity['url'] ?? '',
                'filename' => basename($entity['url'] ?? ''),
                'caption' => $entity['sciName'] ?? '',
                'sciName' => $entity['sciName'] ?? '',
                'catalogNumber' => $entity['catalogNumber'] ?? '',
                'collectionName' => $entity['collectionName'] ?? '',
                'collectionCode' => $entity['collectionCode'] ?? '',
                'eventDate' => $entity['eventDate'] ?? null,
                'stateProvince' => $entity['stateProvince'] ?? null,
                'country' => $entity['country'] ?? null,
                'locality' => $entity['locality'] ?? null
            ];
        }

        return $images;
    }





    /**
     * Unified method to render images with load more button
     * Used by both random (stream) and EAV search to avoid code duplication
     *
     * @param array $images Array of image data (already formatted with mediaID, thumbnailUrl, etc.)
     * @param int $limit Number of images per page
     * @param int $offset Current offset
     * @param string $loadMoreUrl URL for load more button (with query params)
     * @param string|null $query Original search query (for no results message)
     * @return array HTMX response array
     */
    private function renderImagesWithLoadMore(array $images, int $limit, int $offset, string $loadMoreUrl, ?string $query = null): array
    {
        // Check if no results found
        if (empty($images) && $offset === 0) {
            $noResultsHtml = $this->renderTemplate('no_results', TemplateFormat::HTML, [
                'query' => htmlspecialchars($query ?? 'your search'),
                'app_url_prefix' => $this->getAppUrlPrefix()
            ]);

            return [
                'type' => 'htmx',
                'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                    'images_html' => $noResultsHtml,
                    'load_more_html' => '' // No load more button
                ])
            ];
        }

        // Generate images HTML
        $imagesHtml = $this->generateImagesHtml($images);

        // Generate load more button if we got a full page (might be more results)
        $loadMoreHtml = '';
        if (count($images) >= $limit) {
            $loadMoreHtml = $this->renderTemplate('load_more_button', TemplateFormat::HTML, [
                'app_url_prefix' => $this->getAppUrlPrefix(),
                'search_url' => $loadMoreUrl
            ]);
        }

        // Different response for initial load vs load more
        if ($offset > 0) {
            // Load more: append images + update button
            return [
                'type' => 'htmx',
                'content' => $imagesHtml . "\n" .
                            '<div id="load-more-container" class="load-more-container" hx-swap-oob="true">' .
                            $loadMoreHtml .
                            '</div>'
            ];
        } else {
            // Initial load: full grid with button
            return [
                'type' => 'htmx',
                'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                    'images_html' => $imagesHtml,
                    'load_more_html' => $loadMoreHtml
                ])
            ];
        }
    }

    /**
     * Generate EAV UNPIVOT SQL
     */
    private function generateEavSql(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $cacheDbPath = $config->get('components.images.images_cache_db');

            if (!file_exists($cacheDbPath)) {
                return [
                    'type' => 'error',
                    'content' => sprintf('Cache database not found: %s', $cacheDbPath)
                ];
            }

            $configFile = __DIR__ . '/../../templates/sql/images/index_config.ini';
            $outputFile = dirname($cacheDbPath) . '/eav_inserts.sql';

            $generator = new EavSqlGenerator(
                $cacheDbPath,
                $configFile,
                $outputFile
            );

            echo "Generating EAV UNPIVOT SQL...\n";
            $stats = $generator->generateUnpivotSql();

            return [
                'type' => 'success',
                'content' => [
                    'message' => 'EAV SQL generated successfully',
                    'output_file' => $stats['output_file'],
                    'tables_processed' => $stats['tables_processed'],
                    'total_columns' => $stats['total_columns']
                ]
            ];

        } catch (Exception $e) {
            return [
                'type' => 'error',
                'content' => sprintf('EAV SQL generation failed: %s', $e->getMessage())
            ];
        }
    }

    /**
     * Build complete EAV index (NEW IMPLEMENTATION - Pure SQL)
     * Delegates to ImagesModelEav for refactored pure SQL implementation
     *
     * IMPORTANT: This command does NOT access MySQL - it only uses SQLite databases.
     * It can be run in any environment (Docker, native, etc.) as long as you have:
     *   1. source.db file (created by cache-get-source)
     *   2. Sufficient memory and disk space
     *   3. Proper paths configured
     *
     * Supported parameters:
     * --limit <n>           : Limit processing to first N entities (for testing)
     * --sourcedb <path>     : Use alternative source database path (default: same dir as cache db)
     * --source-db-path <path> : Alias for --sourcedb
     * --db-path <path>      : Override cache database output path (default: from config.php)
     * --output-dir <path>   : Override output directory for cache database (creates images_cache.db in this dir)
     *
     * Example workflows:
     *
     * 1. Native environment (avoid Docker memory issues):
     *    php index.php images cache-get-source --output-file=/home/user/source.db
     *    php index.php images cache-build-eav --sourcedb=/home/user/source.db --output-dir=/home/user/cache
     *
     * 2. Docker environment (using copied source.db):
     *    docker cp /home/user/source.db container:/var/www/temp/myco/data/source.db
     *    docker exec container php index.php images cache-build-eav
     */
    private function buildEavIndexNew(array $params): array
    {
        $startTime = microtime(true);

        // Set memory limit from configuration
        // Falls back to performance.memory_limit or components.images.memory_limit
        $oldMemoryLimit = $this->setMemoryLimitFromConfig('cache-build-eav');
        $this->setMaxExecutionTimeFromConfig('cache-build-eav');

        // Debug: Show received parameters
        if (Environment::isCli() && !empty($params)) {
            echo "\nReceived parameters:\n";
            foreach ($params as $key => $value) {
                if (is_bool($value)) {
                    echo "  {$key}: " . ($value ? 'true' : 'false') . "\n";
                } else {
                    echo "  {$key}: {$value}\n";
                }
            }
            echo "\n";
        }

        try {
            $config = Configuration::getInstance();

            // Handle --output-dir parameter (override output directory)
            if (isset($params['output-dir'])) {
                $outputDir = rtrim($params['output-dir'], '/');

                // Make relative paths absolute (relative to current working directory)
                if (!str_starts_with($outputDir, '/')) {
                    $outputDir = getcwd() . '/' . $outputDir;
                }

                if (!is_dir($outputDir)) {
                    if (Environment::isCli()) {
                        echo "Creating output directory: {$outputDir}\n";
                    }
                    if (!mkdir($outputDir, 0755, true)) {
                        throw new Exception("Failed to create output directory: {$outputDir}");
                    }
                }
                $cacheDbPath = $outputDir . '/images_cache.db';
            } else {
                $cacheDbPath = $params['db-path'] ?? $config->get('components.images.images_cache_db');
            }

            $workDbPath = str_replace('.db', '_work.db', $cacheDbPath);

            // Handle --sourcedb parameter (alternative source database)
            $dataDir = dirname($cacheDbPath);
            $sourceDbPath = $params['sourcedb'] ?? $params['source-db-path'] ?? ($dataDir . '/source.db');

            // Make relative source paths absolute
            if (isset($params['sourcedb']) || isset($params['source-db-path'])) {
                if (!str_starts_with($sourceDbPath, '/')) {
                    $sourceDbPath = getcwd() . '/' . $sourceDbPath;
                }
            }

            // Handle --limit parameter (for testing on subset of data)
            $limit = isset($params['limit']) ? (int)$params['limit'] : null;

            // Handle --append parameter (incremental build)
            $append = isset($params['append']) || isset($params['incremental']);

            $configPath = __DIR__ . '/../../templates/sql/images/eav/index_config.ini';

            if (Environment::isCli()) {
                echo "\n╔════════════════════════════════════════════════════════════════╗\n";
                if ($append) {
                    echo "║        Incremental EAV Index Build (Append Mode)             ║\n";
                } else {
                    echo "║           Building EAV Index (Pure SQL Method)                ║\n";
                }
                echo "╚════════════════════════════════════════════════════════════════╝\n\n";

                // Show environment info
                echo "Environment:\n";
                echo "  Platform:  " . PHP_OS . "\n";
                echo "  PHP:       " . PHP_VERSION . "\n";
                echo "  Memory:    " . ini_get('memory_limit') . "\n";
                echo "\n";

                echo "Configuration:\n";
                echo "  Cache DB:  {$cacheDbPath}";
                if (isset($params['output-dir'])) {
                    echo " (custom output directory)\n";
                } else {
                    echo " (from config.php)\n";
                }
                echo "  Source DB: {$sourceDbPath}";
                if (isset($params['sourcedb']) || isset($params['source-db-path'])) {
                    echo " (custom source)\n";
                } else {
                    echo " (default location)\n";
                }
                echo "  Work DB:   {$workDbPath}\n";
                if ($limit !== null) {
                    echo "  Limit:     " . number_format($limit) . " entities (partial load)\n";
                } else {
                    echo "  Limit:     None (processing all entities)\n";
                }
                echo "\n";

                // Verify source database exists
                if (!file_exists($sourceDbPath)) {
                    echo "❌ ERROR: Source database not found: {$sourceDbPath}\n";
                    echo "\nCreate source.db first using:\n";
                    echo "  php index.php images cache-get-source --output-file={$sourceDbPath}\n\n";
                    throw new Exception("Source database not found: {$sourceDbPath}");
                }

                // Show source database info
                $sourceSize = filesize($sourceDbPath);
                $sourceSizeMB = round($sourceSize / 1024 / 1024, 2);
                echo "Source database verified:\n";
                echo "  Size: " . number_format($sourceSizeMB, 2) . " MB\n";
                echo "  Path: {$sourceDbPath}\n";
                echo "\n";
            }

            $eavModel = new ImagesModelEav([
                'config_path' => $configPath,
                'work_db_path' => $workDbPath,
                'cache_db_path' => $cacheDbPath,
                'source_db_path' => $sourceDbPath
            ]);

            // Set alternative source database if specified
            if (isset($params['sourcedb']) || isset($params['source-db-path'])) {
                $eavModel->setSourceDbPath($sourceDbPath);
            }

            // Step 1: Create databases (skip in append mode)
            if (!$append) {
                if (Environment::isCli()) {
                    echo "=== Step 1: Creating Databases ===\n";
                }
                $step1Start = microtime(true);
                $eavModel->createDatabases();
                $step1Time = microtime(true) - $step1Start;
                if (Environment::isCli()) {
                    echo sprintf("✓ Databases created (%.2fs)\n\n", $step1Time);
                }

                // Step 2: Build attributes
                if (Environment::isCli()) {
                    echo "=== Step 2: Building Attributes ===\n";
                }
                $step2Start = microtime(true);
                $eavModel->buildAttributes();
                $step2Time = microtime(true) - $step2Start;
                if (Environment::isCli()) {
                    echo sprintf("✓ Attributes built (%.2fs)\n\n", $step2Time);
                }
            } else {
                if (Environment::isCli()) {
                    echo "=== Append Mode: Skipping database/attribute creation ===\n\n";
                }
            }

            // Step 3: Build EAV index using pure SQL
            if (Environment::isCli()) {
                if ($append) {
                    echo "=== Step 3: Incremental EAV Index Build ===\n";
                } else {
                    echo "=== Step 3: Building EAV Index (Pure SQL) ===\n";
                }
            }
            $step3Start = microtime(true);
            $result = $eavModel->buildEavIndexPureSQL($limit, $append);
            $step3Time = microtime(true) - $step3Start;

            // Check for errors
            if (isset($result['type']) && $result['type'] === 'error') {
                $totalTime = microtime(true) - $startTime;
                if (Environment::isCli()) {
                    echo sprintf("\n❌ Failed after %.2f seconds\n\n", $totalTime);
                    echo "ERROR: " . $result['message'] . "\n";
                }
                return [
                    'type' => 'error',
                    'message' => $result['message'],
                    'code' => 500
                ];
            }

            if (Environment::isCli()) {
                echo sprintf("\n✓ EAV index built (%.2fs)\n", $step3Time);
                echo sprintf("  Entities: %s\n", number_format($result['entityCount']));
                echo sprintf("  ValuesText: %s\n", number_format($result['valuesTextCount']));
                echo sprintf("  EAV rows: %s\n", number_format($result['eavCount']));
                echo sprintf("  Rate: %.0f entities/sec\n\n", $result['entityCount'] / $step3Time);
            }

            // Step 4: Create autocomplete indexes
            if (Environment::isCli()) {
                echo "=== Step 4: Creating Autocomplete Indexes ===\n";
            }
            $step4Start = microtime(true);
            $eavModel->createAutocompleteIndexes();
            $step4Time = microtime(true) - $step4Start;
            if (Environment::isCli()) {
                echo sprintf("✓ Autocomplete indexes created (%.2fs)\n\n", $step4Time);
            }

            // Step 5: Set cache metadata (timestamp for staleness check)
            $cacheDb = new PDO('sqlite:' . $cacheDbPath);
            $cacheDb->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

            // Store build timestamp
            $cacheDb->exec("INSERT OR REPLACE INTO Config (ConfigKey, ConfigValue) VALUES ('cache_built_at', '" . date('Y-m-d H:i:s') . "')");

            // Store schema version
            $cacheDb->exec("INSERT OR REPLACE INTO Config (ConfigKey, ConfigValue) VALUES ('schema_version', '1.0')");

            if (Environment::isCli()) {
                echo "✓ Cache metadata updated\n\n";
            }

            // Step 6: Get info
            if (Environment::isCli()) {
                echo "=== Cache Information ===\n";
            }
            $infoResult = $eavModel->getInfo([]);
            if (Environment::isCli()) {
                echo $infoResult['content'];
            }

            $totalTime = microtime(true) - $startTime;
            if (Environment::isCli()) {
                echo sprintf("\n=== Total Time: %.2f seconds ===\n\n", $totalTime);
            }

            return [
                'type' => 'success',
                'content' => sprintf('EAV index built successfully in %.2f seconds', $totalTime)
            ];

        } catch (Exception $e) {
            $totalTime = microtime(true) - $startTime;
            $errorMsg = sprintf('Failed to build EAV index: %s', $e->getMessage());
            if (Environment::isCli()) {
                echo sprintf("\n❌ Failed after %.2f seconds\n\n", $totalTime);
                echo "ERROR: {$errorMsg}\n";
                echo "File: " . $e->getFile() . ":" . $e->getLine() . "\n";
            }
            return [
                'type' => 'error',
                'content' => $errorMsg,
                'message' => $errorMsg
            ];
        }
    }

    /**
     * Get source data from MySQL and export to SQLite (or optionally TSV files)
     *
     * Command: cache-get-source (replaces cache-export-tsv)
     *
     * By default, exports MySQL data to SQLite database (source.db) for EAV processing.
     * This creates a portable snapshot of production data for offline indexing.
     *
     * Uses batching to handle large datasets efficiently.
     *
     * Parameters:
     *   --limit=N         : Limit root table export to N rows (for testing)
     *   --batch-size=N    : Number of rows to process per batch (default: 1000)
     *   --output-file=PATH : Export to custom SQLite file path (creates source.db with indexes)
     *   --output-dir=PATH  : Export TSV files to this directory instead of SQLite
     */
    private function exportEavTsvNew(array $params): array
    {
        $startTime = microtime(true);

        // Set memory limit from configuration
        $oldMemoryLimit = $this->setMemoryLimitFromConfig('cache-get-source');
        $this->setMaxExecutionTimeFromConfig('cache-get-source');

        // Get optional parameters
        $limit = isset($params['limit']) ? (int)$params['limit'] : null;
        $batchSize = isset($params['batch-size']) ? (int)$params['batch-size'] : 1000;
        $outputFile = $params['output-file'] ?? null;
        $outputDir = $params['output-dir'] ?? null;

        // Validate batch size
        if ($batchSize < 1) {
            $batchSize = 1000;
        }
        if ($batchSize > 50000) {
            echo "Warning: batch-size capped at 50,000 for memory safety\n";
            $batchSize = 50000;
        }

        try {
            $config = Configuration::getInstance();
            $cacheDbPath = $params['db-path'] ?? $config->get('components.images.images_cache_db');
            $workDbPath = str_replace('.db', '_work.db', $cacheDbPath);
            $configPath = __DIR__ . '/../../templates/sql/images/eav/index_config.ini';

            // Get source database connection
            $dbManager = new DatabaseManager();
            $connection = $dbManager->getConnection('readonly');

            if (!$connection) {
                throw new Exception('Database connection failed');
            }

            // Determine output path
            if ($outputDir) {
                // Export to TSV files
                if (!is_dir($outputDir)) {
                    mkdir($outputDir, 0755, true);
                }
                return $this->exportToTsvFiles($connection, $configPath, $outputDir, $limit, $batchSize);
            }

            // Determine SQLite output path
            if ($outputFile) {
                // User-specified output file path
                $sourceDbPath = $outputFile;

                // Create parent directory if it doesn't exist
                $outputFileDir = dirname($sourceDbPath);
                if (!is_dir($outputFileDir)) {
                    mkdir($outputFileDir, 0755, true);
                }
            } else {
                // Default: Create source.db in same directory as cache database
                $dataDir = dirname($cacheDbPath);
                $sourceDbPath = $dataDir . '/source.db';
            }

            if (file_exists($sourceDbPath)) {
                unlink($sourceDbPath);
            }

            if (Environment::isCli()) {
                echo "\n=== Exporting MySQL to SQLite ===\n";

                // Show output file path
                if ($outputFile) {
                    echo sprintf("Output file: %s (custom location)\n", $sourceDbPath);
                } else {
                    echo sprintf("Output file: %s (default location)\n", $sourceDbPath);
                }

                // Show memory info
                $memoryLimit = ini_get('memory_limit');
                $currentMemory = memory_get_usage(true) / 1024 / 1024;
                echo sprintf("PHP Memory: %dMB used / %s limit\n", $currentMemory, $memoryLimit);

                // Show SQLite optimizations
                echo "SQLite optimizations: WAL mode, 2GB cache, 30GB mmap, NORMAL sync\n";

                // Show parameters
                if ($limit) {
                    echo sprintf("LIMIT: %s rows (partial load)\n", number_format($limit));
                }
                if ($batchSize !== 1000) {
                    echo sprintf("Batch size: %s rows per batch\n", number_format($batchSize));
                }
            }

            $sourceDb = new PDO('sqlite:' . $sourceDbPath);
            $sourceDb->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

            // Optimize SQLite for large imports
            $sourceDb->exec("PRAGMA journal_mode = WAL");           // Write-Ahead Logging for better concurrency
            $sourceDb->exec("PRAGMA synchronous = NORMAL");         // Faster writes (safe with WAL)
            $sourceDb->exec("PRAGMA cache_size = -2000000");        // 2GB page cache (negative = KB)
            $sourceDb->exec("PRAGMA temp_store = MEMORY");          // Store temp tables in memory
            $sourceDb->exec("PRAGMA page_size = 4096");             // Optimal page size
            $sourceDb->exec("PRAGMA mmap_size = 30000000000");      // 30GB memory-mapped I/O
            $sourceDb->exec("PRAGMA wal_autocheckpoint = 10000");   // Checkpoint every 10K pages (~40MB)

            // Get table list from config
            $config = @parse_ini_file($configPath, true);
            if (!$config) {
                throw new Exception("Failed to parse config file: {$configPath}");
            }

            // Get root table from config
            $rootTable = $config['_config']['root_table'] ?? null;
            if (!$rootTable) {
                throw new Exception("No root_table defined in [_config] section");
            }

            // Build table graph to determine export order and relationships
            $tableGraph = $this->buildExportTableGraph($config, $rootTable);

            // Get tables in dependency order (root first, then related tables)
            $tables = $this->getExportTableOrder($config, $rootTable, $tableGraph);

            if (Environment::isCli()) {
                echo sprintf("Root table: %s\n", $rootTable);
                echo sprintf("Tables to export: %s\n", implode(', ', $tables));
                echo "Export method: Wide JOIN with batch processing\n\n";
            }

            // Use wide JOIN approach for export
            $this->exportWithWideJoin($connection, $sourceDb, $config, $rootTable, $tables, $tableGraph, $limit, $batchSize);

            // OLD APPROACH: Export each table separately with subqueries (REMOVED)
            // This approach had issues with LIMIT and multi-step paths
            /*
            foreach ($tables as $tableName) {
                $tableStart = microtime(true);

                if (Environment::isCli()) {
                    echo sprintf("Exporting %s...\n", $tableName);
                }

                // Get primary key from config
                $primaryKey = $config[$tableName]['primary_key'] ?? null;
                if (!$primaryKey) {
                    throw new Exception("No primary_key defined for table {$tableName} in config");
                }

                // Get columns from config (both display and indexed)
                $configColumns = $config[$tableName]['columns'] ?? [];
                if (!is_array($configColumns)) {
                    $configColumns = [$configColumns];
                }

                // Parse column definitions to get column names
                $columnsToExport = [$primaryKey]; // Always include primary key
                $columnTypes = []; // Track types from config

                foreach ($configColumns as $colDef) {
                    // Parse "columnName:type[:flag][:strategy]"
                    $parts = explode(':', $colDef);
                    $colName = $parts[0];
                    $colType = $parts[1] ?? 'text';

                    if (!in_array($colName, $columnsToExport)) {
                        $columnsToExport[] = $colName;
                    }

                    // Map config type to SQLite type
                    if ($colType === 'numeric') {
                        $columnTypes[$colName] = 'REAL';
                    } elseif ($colType === 'date') {
                        $columnTypes[$colName] = 'TEXT';
                    } else {
                        $columnTypes[$colName] = 'TEXT';
                    }
                }

                // Add foreign key columns if not already included
                if (isset($config[$tableName]['foreign_key'])) {
                    $foreignKeys = $config[$tableName]['foreign_key'];
                    if (!is_array($foreignKeys)) {
                        $foreignKeys = [$foreignKeys];
                    }

                    foreach ($foreignKeys as $fk) {
                        // Parse "local_column:referenced_table.referenced_column"
                        list($localColumn) = explode(':', $fk);
                        if (!in_array($localColumn, $columnsToExport)) {
                            $columnsToExport[] = $localColumn;
                            // Foreign keys are typically numeric IDs
                            $columnTypes[$localColumn] = 'INTEGER';
                        }
                    }
                }

                // Get MySQL schema for type mapping (only for columns we're exporting)
                $schemaResult = $connection->query("DESCRIBE {$tableName}");
                $mysqlSchema = [];
                while ($col = $schemaResult->fetch_assoc()) {
                    $mysqlSchema[$col['Field']] = $col;
                }

                // Build column definitions for CREATE TABLE
                $columnDefs = [];
                foreach ($columnsToExport as $colName) {
                    // Use type from config if available, otherwise infer from MySQL
                    if (isset($columnTypes[$colName])) {
                        $type = $columnTypes[$colName];
                    } elseif (isset($mysqlSchema[$colName])) {
                        $mysqlType = $mysqlSchema[$colName]['Type'];
                        if (strpos($mysqlType, 'int') !== false) {
                            $type = 'INTEGER';
                        } elseif (strpos($mysqlType, 'decimal') !== false ||
                                  strpos($mysqlType, 'float') !== false ||
                                  strpos($mysqlType, 'double') !== false) {
                            $type = 'REAL';
                        } else {
                            $type = 'TEXT';
                        }
                    } else {
                        $type = 'TEXT';
                    }

                    // Mark primary key
                    if ($colName === $primaryKey) {
                        $columnDefs[] = sprintf('`%s` %s PRIMARY KEY', $colName, $type);
                    } else {
                        $columnDefs[] = sprintf('`%s` %s', $colName, $type);
                    }
                }

                // Calculate estimated row size based on column types
                $estimatedRowSize = 0;
                foreach ($columnsToExport as $colName) {
                    if (isset($columnTypes[$colName])) {
                        $type = $columnTypes[$colName];
                    } elseif (isset($mysqlSchema[$colName])) {
                        $mysqlType = $mysqlSchema[$colName]['Type'];
                        if (strpos($mysqlType, 'int') !== false) {
                            $type = 'INTEGER';
                        } elseif (strpos($mysqlType, 'decimal') !== false ||
                                  strpos($mysqlType, 'float') !== false ||
                                  strpos($mysqlType, 'double') !== false) {
                            $type = 'REAL';
                        } else {
                            $type = 'TEXT';
                        }
                    } else {
                        $type = 'TEXT';
                    }

                    // Estimate size per column type
                    if ($type === 'INTEGER' || $type === 'REAL') {
                        $estimatedRowSize += 8; // 8 bytes for numeric
                    } else {
                        // For TEXT, estimate based on MySQL column type
                        if (isset($mysqlSchema[$colName])) {
                            $mysqlType = $mysqlSchema[$colName]['Type'];
                            // Extract length from varchar(255), text, etc.
                            if (preg_match('/varchar\((\d+)\)/', $mysqlType, $matches)) {
                                $estimatedRowSize += min((int)$matches[1], 255); // Cap at 255
                            } elseif (strpos($mysqlType, 'text') !== false) {
                                $estimatedRowSize += 1024; // TEXT fields average 1KB
                            } elseif (strpos($mysqlType, 'char') !== false) {
                                $estimatedRowSize += 50; // CHAR fields average 50 bytes
                            } else {
                                $estimatedRowSize += 100; // Default for unknown TEXT
                            }
                        } else {
                            $estimatedRowSize += 100; // Default for unknown
                        }
                    }
                }

                // Add overhead for row structure (pointers, etc.)
                $estimatedRowSize += 50;

                // Calculate optimal batch size for this table
                $memoryLimitBytes = $this->getMemoryLimitBytes();
                $availableMemory = $memoryLimitBytes - memory_get_usage(true);
                // Use 40% of available memory for batching (conservative)
                $tableBatchSize = max(500, min(50000, (int)($availableMemory * 0.4 / $estimatedRowSize)));

                if (Environment::isCli()) {
                    echo sprintf("  Columns: %d (from %d total in MySQL)\n",
                        count($columnsToExport),
                        count($mysqlSchema)
                    );
                    echo sprintf("  Estimated row size: %s bytes\n", number_format($estimatedRowSize));
                    echo sprintf("  Batch size: %s rows (%.1fMB per batch)\n",
                        number_format($tableBatchSize),
                        ($tableBatchSize * $estimatedRowSize) / 1024 / 1024
                    );
                }

                // Create table in SQLite
                $createSql = sprintf(
                    'CREATE TABLE `%s` (%s)',
                    $tableName,
                    implode(', ', $columnDefs)
                );
                $sourceDb->exec($createSql);

                // Create indexes on foreign key columns from config
                if (isset($config[$tableName]['foreign_key'])) {
                    $foreignKeys = $config[$tableName]['foreign_key'];
                    if (!is_array($foreignKeys)) {
                        $foreignKeys = [$foreignKeys];
                    }

                    foreach ($foreignKeys as $fk) {
                        // Parse "local_column:referenced_table.referenced_column"
                        list($localColumn) = explode(':', $fk);
                        $indexName = sprintf('idx_%s_%s', $tableName, $localColumn);
                        $indexSql = sprintf(
                            'CREATE INDEX `%s` ON `%s` (`%s`)',
                            $indexName,
                            $tableName,
                            $localColumn
                        );
                        $sourceDb->exec($indexSql);
                    }
                }

                // Build WHERE clause for related tables (only export related rows)
                $whereClause = $this->buildExportWhereClause($tableName, $rootTable, $tableGraph, $config, $limit, $sourceDb);

                // Get total row count (with WHERE clause if applicable)
                $countQuery = "SELECT COUNT(*) as cnt FROM {$tableName}";
                if ($whereClause) {
                    $countQuery .= " WHERE {$whereClause}";
                }
                $countResult = $connection->query($countQuery);
                $totalRows = $countResult->fetch_assoc()['cnt'];

                if (Environment::isCli()) {
                    if ($tableName === $rootTable) {
                        // Root table
                        $rootWhereClause = isset($config['_config']['where_clause']) ? $config['_config']['where_clause'] : null;
                        if ($rootWhereClause) {
                            echo sprintf("  Filter: %s\n", $rootWhereClause);
                        }
                        if ($limit) {
                            echo sprintf("  LIMIT: %s rows (partial load)\n", number_format($limit));
                        }
                        echo sprintf("  Total rows to export: %s\n", number_format($totalRows));
                    } elseif ($whereClause) {
                        echo sprintf("  Filter: Only rows related to %s\n", $rootTable);
                        echo sprintf("  WHERE clause: %s\n", $whereClause);
                        echo sprintf("  Filtered rows: %s\n", number_format($totalRows));
                    } else {
                        echo sprintf("  ⚠ No filter (no path found)\n");
                    }
                }

                // Copy data in batches (only selected columns)
                $insertSql = sprintf(
                    'INSERT INTO `%s` (%s) VALUES (%s)',
                    $tableName,
                    implode(', ', array_map(function($c) { return "`{$c}`"; }, $columnsToExport)),
                    implode(', ', array_fill(0, count($columnsToExport), '?'))
                );
                $stmt = $sourceDb->prepare($insertSql);

                $rowCount = 0;
                $offset = 0;

                // Apply LIMIT to root table if specified (for testing)
                $effectiveTotalRows = $totalRows;
                if ($tableName === $rootTable && $limit && $limit < $totalRows) {
                    $effectiveTotalRows = $limit;
                }

                while ($offset < $effectiveTotalRows) {
                    // Fetch batch (only selected columns, use table-specific batch size)
                    $query = sprintf(
                        'SELECT %s FROM %s',
                        implode(', ', array_map(function($c) { return "`{$c}`"; }, $columnsToExport)),
                        $tableName
                    );

                    // Add WHERE clause for related tables
                    if ($whereClause) {
                        $query .= " WHERE {$whereClause}";
                    }

                    // Calculate batch size (don't exceed limit for root table)
                    $currentBatchSize = $tableBatchSize;
                    if ($tableName === $rootTable && $limit) {
                        $remaining = $limit - $offset;
                        $currentBatchSize = min($tableBatchSize, $remaining);
                    }

                    $query .= sprintf(' LIMIT %d OFFSET %d', $currentBatchSize, $offset);

                    $result = $connection->query($query);

                    // Begin transaction for batch
                    $sourceDb->beginTransaction();

                    while ($row = $result->fetch_row()) {
                        $stmt->execute($row);
                        $rowCount++;
                    }

                    // Commit batch
                    $sourceDb->commit();

                    $offset += $tableBatchSize;

                    // Free result
                    $result->free();

                    // Show progress
                    if (Environment::isCli() && $effectiveTotalRows > 10000) {
                        $progress = min(100, ($rowCount / $effectiveTotalRows) * 100);
                        echo sprintf("  Progress: %d%% (%s / %s rows)\r",
                            $progress,
                            number_format($rowCount),
                            number_format($effectiveTotalRows)
                        );
                    }
                }

                $tableTime = microtime(true) - $tableStart;

                if (Environment::isCli()) {
                    echo sprintf("  ✓ %s rows exported\n", number_format($rowCount));
                }
            }
            */ // END OLD APPROACH

            $totalTime = microtime(true) - $startTime;

            if (Environment::isCli()) {
                echo sprintf("\n✓ Export complete (%.2f seconds)\n\n", $totalTime);

                // Show helpful instructions if using custom output file
                if ($outputFile) {
                    $fileSize = file_exists($sourceDbPath) ? filesize($sourceDbPath) : 0;
                    $fileSizeMB = round($fileSize / 1024 / 1024, 2);

                    echo "╔════════════════════════════════════════════════════════════════╗\n";
                    echo "║  Source Database Created                                      ║\n";
                    echo "╚════════════════════════════════════════════════════════════════╝\n\n";
                    echo sprintf("File: %s\n", $sourceDbPath);
                    echo sprintf("Size: %s MB\n", number_format($fileSizeMB, 2));
                    echo sprintf("Tables: %d\n", count($tables));
                    echo "\nTo use this source.db in Docker environment:\n\n";
                    echo "1. Copy to Docker data directory:\n";
                    echo "   docker cp {$sourceDbPath} symbiota-web:/var/www/temp/myco/data/source.db\n\n";
                    echo "2. Build EAV index in Docker:\n";
                    echo "   docker exec -it symbiota-web bash -c \"cd /var/www/html/portal/tk && php index.php images cache-build-eav\"\n\n";
                    echo "Or specify custom source path:\n";
                    echo "   docker exec -it symbiota-web bash -c \"cd /var/www/html/portal/tk && php index.php images cache-build-eav --source-db-path=/path/to/source.db\"\n\n";
                }
            }

            return [
                'type' => 'success',
                'content' => sprintf('Exported %d tables to %s in %.2f seconds', count($tables), $sourceDbPath, $totalTime)
            ];

        } catch (Exception $e) {
            $totalTime = microtime(true) - $startTime;
            if (Environment::isCli()) {
                echo sprintf("\n❌ Export failed after %.2f seconds\n\n", $totalTime);
                echo sprintf("Error: %s\n", $e->getMessage());
                echo sprintf("File: %s:%d\n", $e->getFile(), $e->getLine());
                echo sprintf("Trace:\n%s\n", $e->getTraceAsString());
            }
            return [
                'type' => 'error',
                'content' => sprintf('Failed to export TSV: %s', $e->getMessage())
            ];
        }
    }

    /**
     * Export using skeleton JOIN + batch SELECT approach
     *
     * This is a two-phase approach:
     * 1. Skeleton JOIN: Fast query to get just primary keys from all tables
     * 2. Batch SELECT: Retrieve full rows by primary key (indexed lookups)
     *
     * This approach:
     * - Much faster than wide JOIN with LIMIT/OFFSET (no OFFSET degradation)
     * - Works correctly with LIMIT (applied to skeleton query)
     * - Handles multi-step paths automatically
     * - Can use very large batches (50,000+ IDs)
     * - Constant performance across all batches
     *
     * @param mysqli $connection MySQL connection
     * @param PDO $sourceDb SQLite database
     * @param array $config Parsed config
     * @param string $rootTable Root table name
     * @param array $tables List of tables to export
     * @param array $tableGraph Table relationship graph
     * @param int|null $limit Optional row limit for testing
     * @param int $batchSize Rows per batch
     */
    private function exportWithWideJoin(
        mysqli $connection,
        PDO $sourceDb,
        array $config,
        string $rootTable,
        array $tables,
        array $tableGraph,
        ?int $limit,
        int $batchSize
    ): void {
        // Create SQLite tables with PRIMARY KEYs
        foreach ($tables as $tableName) {
            $this->createSqliteTable($sourceDb, $connection, $tableName, $config);
        }

        // Get root table primary key
        $rootPrimaryKey = $config[$rootTable]['primary_key'] ?? null;
        if (!$rootPrimaryKey) {
            throw new Exception("Root table {$rootTable} must have a primary_key defined");
        }

        if (Environment::isCli()) {
            echo "Using keyset pagination (no OFFSET degradation)\n";
            echo "Phase 1: Query root table only (fast!)...\n";
            echo "Phase 2: Batch SELECT all tables by primary key...\n\n";
        }

        $lastRootId = 0; // Start from beginning (keyset pagination)
        $totalProcessed = 0;
        $batchNumber = 0;

        while (true) {
            $batchNumber++;
            $batchStart = microtime(true);

            // Phase 1: Query ONLY root table (no JOINs - very fast!)
            // Get root IDs + foreign key columns
            $rootColumns = $this->getColumnsForTable($config[$rootTable]);
            $rootQuery = sprintf(
                "SELECT %s FROM `%s` WHERE %s AND `%s` > %d ORDER BY `%s` LIMIT %d",
                implode(', ', array_map(fn($c) => "`$c`", $rootColumns)),
                $rootTable,
                $config['_config']['where_clause'] ?? '1=1',
                $rootPrimaryKey,
                $lastRootId,
                $rootPrimaryKey,
                $batchSize
            );

            if (Environment::isCli() && $batchNumber === 1) {
                echo "Root query: " . substr($rootQuery, 0, 200) . "...\n\n";
            }

            $result = $connection->query($rootQuery);

            if (!$result) {
                throw new Exception("Root table query failed: " . $connection->error);
            }

            if ($result->num_rows === 0) {
                break; // No more data
            }

            // Collect root rows and extract foreign key IDs
            $rootRows = [];
            $tableIds = [];
            foreach ($tables as $tableName) {
                $tableIds[$tableName] = [];
            }

            $rowCount = 0;
            $maxRootId = $lastRootId;

            while ($row = $result->fetch_assoc()) {
                $rootRows[] = $row;

                // Add root table ID
                $rootId = $row[$rootPrimaryKey];
                $tableIds[$rootTable][$rootId] = true;

                if ($rootId > $maxRootId) {
                    $maxRootId = $rootId;
                }

                // Extract foreign key IDs from root table
                // This tells us which related records to fetch
                if (isset($config[$rootTable]['foreign_key'])) {
                    $foreignKeys = $config[$rootTable]['foreign_key'];
                    if (!is_array($foreignKeys)) {
                        $foreignKeys = [$foreignKeys];
                    }

                    foreach ($foreignKeys as $fk) {
                        // Parse "local_column:referenced_table.referenced_column"
                        if (preg_match('/^([^:]+):([^.]+)\.(.+)$/', $fk, $matches)) {
                            $localColumn = $matches[1];
                            $refTable = $matches[2];

                            if (isset($row[$localColumn]) && $row[$localColumn] !== null) {
                                $tableIds[$refTable][$row[$localColumn]] = true;
                            }
                        }
                    }
                }

                $rowCount++;
            }

            $result->free();

            // Update lastRootId for next iteration
            $lastRootId = $maxRootId;

            // Now we need to recursively fetch related tables
            // For example, if we have omoccurrences IDs, we need to get their collid and tidInterpreted
            $this->fetchRelatedIds($connection, $config, $tables, $tableIds);

            // Phase 2: Batch SELECT by primary key for each table
            // IMPORTANT: Filter out IDs that already exist in SQLite to avoid re-fetching
            $stats = [];
            foreach ($tables as $tableName) {
                $ids = array_keys($tableIds[$tableName]);
                if (empty($ids)) {
                    $stats[$tableName] = 0;
                    continue;
                }

                // Filter out IDs that already exist in SQLite
                $newIds = $this->filterExistingIds($sourceDb, $tableName, $config[$tableName], $ids);

                if (empty($newIds)) {
                    $stats[$tableName] = 0;
                    continue;
                }

                $inserted = $this->batchSelectAndInsert($connection, $sourceDb, $tableName, $config[$tableName], $newIds);
                $stats[$tableName] = $inserted;
            }

            $batchTime = microtime(true) - $batchStart;
            $totalProcessed += $rowCount;

            if (Environment::isCli()) {
                echo sprintf("Batch %d: %d skeleton rows, %s, lastId=%d (%.2fs)\n",
                    $batchNumber,
                    $rowCount,
                    implode(', ', array_map(function($table) use ($stats) {
                        return "{$table}={$stats[$table]}";
                    }, $tables)),
                    $lastRootId,
                    $batchTime
                );
            }

            // Stop if we hit the limit
            if ($limit && $totalProcessed >= $limit) {
                if (Environment::isCli()) {
                    echo sprintf("\n✓ Reached limit of %d rows\n", $limit);
                }
                break;
            }

            // Stop if batch was smaller than requested (end of data)
            if ($rowCount < $batchSize) {
                break;
            }
        }

        if (Environment::isCli()) {
            echo sprintf("\n✓ Total rows processed: %d\n", $totalProcessed);

            // Show final counts per table
            echo "\nFinal row counts:\n";
            foreach ($tables as $tableName) {
                $count = $sourceDb->query("SELECT COUNT(*) FROM `{$tableName}`")->fetchColumn();
                echo sprintf("  %s: %s rows\n", $tableName, number_format($count));
            }
        }
    }

    /**
     * Build skeleton JOIN query (just primary keys)
     *
     * Creates a fast SELECT query that JOINs all related tables but only fetches primary keys.
     * This is much faster than fetching all columns, especially with LIMIT/OFFSET.
     *
     * @param array $config Parsed config
     * @param string $rootTable Root table name
     * @param array $tables List of tables to include
     * @param array $tableGraph Table relationship graph
     * @return string SQL query (without LIMIT/OFFSET)
     */
    private function buildSkeletonJoinQuery(array $config, string $rootTable, array $tables, array $tableGraph): string
    {
        $columns = [];
        $joins = [];

        // Build column list with just primary keys
        foreach ($tables as $tableName) {
            $tableConfig = $config[$tableName];
            $primaryKey = $tableConfig['primary_key'] ?? null;

            if ($primaryKey) {
                // Prefix with table name: media__mediaID, omoccurrences__occid, etc.
                $columns[] = "`{$tableName}`.`{$primaryKey}` AS `{$tableName}__{$primaryKey}`";
            }
        }

        // Build JOIN chain from foreign keys
        $visited = [$rootTable => true];
        $this->buildJoinChain($config, $rootTable, $tableGraph, $joins, $visited);

        // Assemble query
        $query = "SELECT DISTINCT " . implode(', ', $columns);
        $query .= " FROM `{$rootTable}`";

        if (!empty($joins)) {
            $query .= " " . implode(' ', $joins);
        }

        // Add WHERE clause from config
        // Prefix column names with root table to avoid ambiguity
        // Note: We use WHERE here, and the caller will add AND for keyset pagination
        if (isset($config['_config']['where_clause'])) {
            $whereClause = $config['_config']['where_clause'];
            // Replace bare column names with table-prefixed versions
            $whereClause = preg_replace_callback(
                '/\b([a-zA-Z_][a-zA-Z0-9_]*)\b/',
                function($matches) use ($rootTable) {
                    $col = $matches[1];
                    // Don't prefix SQL keywords
                    $keywords = ['AND', 'OR', 'NOT', 'IS', 'NULL', 'IN', 'LIKE', 'BETWEEN'];
                    if (in_array(strtoupper($col), $keywords)) {
                        return $col;
                    }
                    return "`{$rootTable}`.`{$col}`";
                },
                $whereClause
            );
            $query .= " WHERE " . $whereClause;
        } else {
            // No WHERE clause from config, but we need WHERE for keyset pagination
            // Add a dummy WHERE 1=1 so caller can add AND
            $query .= " WHERE 1=1";
        }

        return $query;
    }

    /**
     * Recursively fetch related table IDs
     *
     * Given a set of table IDs, fetch their foreign key references.
     * For example, if we have omoccurrences IDs, fetch their collid and tidInterpreted values.
     *
     * @param mysqli $connection MySQL connection
     * @param array $config Parsed config
     * @param array $tables List of all tables
     * @param array &$tableIds Array of table => [id => true] (modified in place)
     */
    private function fetchRelatedIds(mysqli $connection, array $config, array $tables, array &$tableIds): void
    {
        // Process each table that has IDs
        foreach ($tables as $tableName) {
            $ids = array_keys($tableIds[$tableName]);
            if (empty($ids)) {
                continue;
            }

            $tableConfig = $config[$tableName];

            // Check if this table has foreign keys
            if (!isset($tableConfig['foreign_key'])) {
                continue;
            }

            $foreignKeys = $tableConfig['foreign_key'];
            if (!is_array($foreignKeys)) {
                $foreignKeys = [$foreignKeys];
            }

            // Build query to fetch foreign key values
            $primaryKey = $tableConfig['primary_key'] ?? null;
            if (!$primaryKey) {
                continue;
            }

            // Get list of foreign key columns to fetch
            $fkColumns = [$primaryKey];
            $fkMap = []; // local_column => ref_table

            foreach ($foreignKeys as $fk) {
                // Parse "local_column:referenced_table.referenced_column"
                if (preg_match('/^([^:]+):([^.]+)\.(.+)$/', $fk, $matches)) {
                    $localColumn = $matches[1];
                    $refTable = $matches[2];

                    $fkColumns[] = $localColumn;
                    $fkMap[$localColumn] = $refTable;
                }
            }

            // Optimize query by detecting gaps in ID sequence
            // Use BETWEEN for dense ranges, IN for sparse IDs
            $ranges = $this->detectIdRanges($ids);

            foreach ($ranges as $range) {
                if ($range['type'] === 'range') {
                    // Dense range: use BETWEEN
                    $query = sprintf(
                        "SELECT %s FROM `%s` WHERE `%s` BETWEEN %s AND %s",
                        implode(', ', array_map(fn($c) => "`$c`", $fkColumns)),
                        $tableName,
                        $primaryKey,
                        is_numeric($range['min']) ? $range['min'] : "'" . addslashes($range['min']) . "'",
                        is_numeric($range['max']) ? $range['max'] : "'" . addslashes($range['max']) . "'"
                    );
                } else {
                    // Sparse IDs: use IN clause
                    $idList = implode(',', array_map(function($id) {
                        return is_numeric($id) ? $id : "'" . addslashes($id) . "'";
                    }, $range['ids']));

                    $query = sprintf(
                        "SELECT %s FROM `%s` WHERE `%s` IN (%s)",
                        implode(', ', array_map(fn($c) => "`$c`", $fkColumns)),
                        $tableName,
                        $primaryKey,
                        $idList
                    );
                }

                $result = $connection->query($query);

                if (!$result) {
                    continue; // Skip on error
                }

                // Extract foreign key IDs
                while ($row = $result->fetch_assoc()) {
                    foreach ($fkMap as $localColumn => $refTable) {
                        if (isset($row[$localColumn]) && $row[$localColumn] !== null) {
                            $tableIds[$refTable][$row[$localColumn]] = true;
                        }
                    }
                }

                $result->free();
            }
        }
    }

    /**
     * Detect dense ranges and sparse IDs in an ID list
     *
     * Analyzes gaps in the ID sequence to optimize queries:
     * - Dense ranges (>80% coverage): Use BETWEEN
     * - Sparse IDs: Use IN clause
     *
     * Example: [1,2,3,4,5, 100,101,102, 1000000]
     * Returns:
     *   [
     *     ['type' => 'range', 'min' => 1, 'max' => 5],      // 5 IDs, 100% dense
     *     ['type' => 'range', 'min' => 100, 'max' => 102],  // 3 IDs, 100% dense
     *     ['type' => 'sparse', 'ids' => [1000000]]          // 1 ID, sparse
     *   ]
     *
     * @param array $ids Array of numeric IDs
     * @return array Array of ranges/sparse groups
     */
    private function detectIdRanges(array $ids): array
    {
        if (empty($ids)) {
            return [];
        }

        // Sort IDs
        sort($ids);
        $ids = array_values(array_unique($ids));

        $ranges = [];
        $currentRangeStart = $ids[0];
        $currentRangeEnd = $ids[0];
        $currentRangeIds = [$ids[0]];

        for ($i = 1; $i < count($ids); $i++) {
            $prevId = $ids[$i - 1];
            $currentId = $ids[$i];
            $gap = $currentId - $prevId;

            // If gap is small (<=10), continue current range
            if ($gap <= 10) {
                $currentRangeEnd = $currentId;
                $currentRangeIds[] = $currentId;
            } else {
                // Large gap detected - finalize current range
                $finalizedRanges = $this->finalizeRange($currentRangeStart, $currentRangeEnd, $currentRangeIds);

                // finalizeRange may return multiple ranges if chunking is needed
                if (isset($finalizedRanges['type'])) {
                    // Single range
                    $ranges[] = $finalizedRanges;
                } else {
                    // Multiple ranges (chunked)
                    $ranges = array_merge($ranges, $finalizedRanges);
                }

                // Start new range
                $currentRangeStart = $currentId;
                $currentRangeEnd = $currentId;
                $currentRangeIds = [$currentId];
            }
        }

        // Finalize last range
        $finalizedRanges = $this->finalizeRange($currentRangeStart, $currentRangeEnd, $currentRangeIds);

        // finalizeRange may return multiple ranges if chunking is needed
        if (isset($finalizedRanges['type'])) {
            // Single range
            $ranges[] = $finalizedRanges;
        } else {
            // Multiple ranges (chunked)
            $ranges = array_merge($ranges, $finalizedRanges);
        }

        return $ranges;
    }

    /**
     * Finalize a range by determining if it should use BETWEEN or IN
     *
     * IMPORTANT: BETWEEN fetches ALL rows in range, so only use it when density is 100%
     * (i.e., no gaps in the sequence). Otherwise, we'll fetch unwanted rows.
     *
     * @param int $min Minimum ID in range
     * @param int $max Maximum ID in range
     * @param array $ids Actual IDs in range
     * @return array Range descriptor (single) or array of range descriptors (chunked)
     */
    private function finalizeRange(int $min, int $max, array $ids): array
    {
        $rangeSize = $max - $min + 1;
        $actualCount = count($ids);
        $density = $actualCount / $rangeSize;

        // Only use BETWEEN if density is 100% (no gaps) AND range is large enough (>100 IDs)
        // Otherwise use IN clause to avoid fetching unwanted rows
        if ($density === 1.0 && $rangeSize > 100) {
            return [
                'type' => 'range',
                'min' => $min,
                'max' => $max
            ];
        } else {
            // Chunk large IN clauses to avoid query size limits
            $maxInSize = 10000;
            if (count($ids) > $maxInSize) {
                // Split into multiple IN clauses
                $chunks = array_chunk($ids, $maxInSize);
                $result = [];
                foreach ($chunks as $chunk) {
                    $result[] = [
                        'type' => 'sparse',
                        'ids' => $chunk
                    ];
                }
                return $result; // Return array of ranges
            } else {
                return [
                    'type' => 'sparse',
                    'ids' => $ids
                ];
            }
        }
    }

    /**
     * Filter out IDs that already exist in SQLite
     *
     * This prevents re-fetching rows from MySQL that were already inserted in previous batches.
     *
     * @param PDO $sourceDb SQLite database
     * @param string $tableName Table name
     * @param array $tableConfig Table configuration
     * @param array $ids Array of primary key values to check
     * @return array Array of IDs that don't exist in SQLite yet
     */
    private function filterExistingIds(PDO $sourceDb, string $tableName, array $tableConfig, array $ids): array
    {
        if (empty($ids)) {
            return [];
        }

        $primaryKey = $tableConfig['primary_key'] ?? null;
        if (!$primaryKey) {
            return $ids; // No primary key, can't filter
        }

        // For large ID lists, check in chunks
        $chunkSize = 10000;
        $newIds = [];

        foreach (array_chunk($ids, $chunkSize) as $chunk) {
            // Build IN clause
            $idList = implode(',', array_map(function($id) {
                return is_numeric($id) ? $id : "'" . addslashes($id) . "'";
            }, $chunk));

            // Query SQLite to find which IDs already exist
            $query = sprintf(
                "SELECT `%s` FROM `%s` WHERE `%s` IN (%s)",
                $primaryKey,
                $tableName,
                $primaryKey,
                $idList
            );

            $stmt = $sourceDb->query($query);
            if (!$stmt) {
                // On error, assume all IDs are new
                $newIds = array_merge($newIds, $chunk);
                continue;
            }

            // Collect existing IDs
            $existingIds = [];
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $existingIds[$row[$primaryKey]] = true;
            }

            // Filter out existing IDs
            foreach ($chunk as $id) {
                if (!isset($existingIds[$id])) {
                    $newIds[] = $id;
                }
            }
        }

        return $newIds;
    }

    /**
     * Batch SELECT and INSERT by primary key with chunking
     *
     * Fetches full rows from MySQL by primary key and inserts into SQLite.
     * Uses INSERT OR IGNORE for automatic deduplication.
     *
     * For large ID lists (>10,000), splits into chunks to avoid query size limits.
     *
     * @param mysqli $connection MySQL connection
     * @param PDO $sourceDb SQLite database
     * @param string $tableName Table name
     * @param array $tableConfig Table configuration
     * @param array $ids Array of primary key values to fetch
     * @return int Number of rows inserted
     */
    private function batchSelectAndInsert(mysqli $connection, PDO $sourceDb, string $tableName, array $tableConfig, array $ids): int
    {
        if (empty($ids)) {
            return 0;
        }

        $primaryKey = $tableConfig['primary_key'] ?? null;
        if (!$primaryKey) {
            return 0;
        }

        $columns = $this->getColumnsForTable($tableConfig);

        // Optimize query by detecting gaps in ID sequence
        $ranges = $this->detectIdRanges($ids);

        $insertedCount = 0;
        $sourceDb->beginTransaction();

        // Batch INSERTs in chunks of 1000 rows for optimal performance
        $insertChunkSize = 1000;
        $rowBuffer = [];

        foreach ($ranges as $range) {
            if ($range['type'] === 'range') {
                // Dense range: use BETWEEN
                $query = sprintf(
                    "SELECT %s FROM `%s` WHERE `%s` BETWEEN %s AND %s",
                    implode(', ', array_map(fn($c) => "`$c`", $columns)),
                    $tableName,
                    $primaryKey,
                    is_numeric($range['min']) ? $range['min'] : "'" . addslashes($range['min']) . "'",
                    is_numeric($range['max']) ? $range['max'] : "'" . addslashes($range['max']) . "'"
                );
            } else {
                // Sparse IDs: use IN clause
                $idList = implode(',', array_map(function($id) {
                    return is_numeric($id) ? $id : "'" . addslashes($id) . "'";
                }, $range['ids']));

                $query = sprintf(
                    "SELECT %s FROM `%s` WHERE `%s` IN (%s)",
                    implode(', ', array_map(fn($c) => "`$c`", $columns)),
                    $tableName,
                    $primaryKey,
                    $idList
                );
            }

            $result = $connection->query($query);

            if (!$result) {
                throw new Exception("Batch SELECT failed for {$tableName}: " . $connection->error);
            }

            // Collect rows and INSERT in chunks
            while ($row = $result->fetch_assoc()) {
                $rowBuffer[] = $row;

                // When buffer is full, execute multi-row INSERT
                if (count($rowBuffer) >= $insertChunkSize) {
                    $inserted = $this->executeMultiRowInsert($sourceDb, $tableName, $columns, $rowBuffer);
                    $insertedCount += $inserted;
                    $rowBuffer = [];
                }
            }

            $result->free();
        }

        // Insert remaining rows
        if (!empty($rowBuffer)) {
            $inserted = $this->executeMultiRowInsert($sourceDb, $tableName, $columns, $rowBuffer);
            $insertedCount += $inserted;
        }

        $sourceDb->commit();

        return $insertedCount;
    }

    /**
     * Execute multi-row INSERT for better performance
     *
     * Instead of 1000 individual INSERTs, does one INSERT with 1000 rows.
     * This is much faster for SQLite.
     *
     * @param PDO $sourceDb SQLite database
     * @param string $tableName Table name
     * @param array $columns Column names
     * @param array $rows Array of row data
     * @return int Number of rows inserted
     */
    private function executeMultiRowInsert(PDO $sourceDb, string $tableName, array $columns, array $rows): int
    {
        if (empty($rows)) {
            return 0;
        }

        // Build multi-row INSERT statement
        // INSERT OR IGNORE INTO table (col1, col2) VALUES (?, ?), (?, ?), (?, ?)
        $columnList = implode(', ', array_map(fn($c) => "`$c`", $columns));
        $rowPlaceholder = '(' . implode(', ', array_fill(0, count($columns), '?')) . ')';
        $allPlaceholders = implode(', ', array_fill(0, count($rows), $rowPlaceholder));

        $sql = sprintf(
            'INSERT OR IGNORE INTO `%s` (%s) VALUES %s',
            $tableName,
            $columnList,
            $allPlaceholders
        );

        // Flatten all row values into a single array
        $allValues = [];
        foreach ($rows as $row) {
            foreach ($columns as $col) {
                $allValues[] = $row[$col] ?? null;
            }
        }

        // Execute multi-row INSERT
        $stmt = $sourceDb->prepare($sql);
        $stmt->execute($allValues);

        return $stmt->rowCount();
    }

    /**
     * Batch SELECT and INSERT using keyset pagination (for large ID lists)
     *
     * Instead of WHERE id IN (...), uses keyset pagination:
     * WHERE id > lastId ORDER BY id LIMIT N
     *
     * This avoids query size limits and maintains constant performance.
     *
     * @param mysqli $connection MySQL connection
     * @param PDO $sourceDb SQLite database
     * @param string $tableName Table name
     * @param array $tableConfig Table configuration
     * @param array $ids Array of primary key values to fetch
     * @return int Number of rows inserted
     */
    private function batchSelectAndInsertWithKeyset(mysqli $connection, PDO $sourceDb, string $tableName, array $tableConfig, array $ids): int
    {
        $primaryKey = $tableConfig['primary_key'];
        $columns = $this->getColumnsForTable($tableConfig);

        // Sort IDs for keyset pagination
        sort($ids);
        $minId = min($ids);
        $maxId = max($ids);

        // Use keyset pagination to fetch rows
        $lastId = $minId - 1;
        $insertedCount = 0;
        $chunkSize = 10000;

        $sourceDb->beginTransaction();

        while ($lastId < $maxId) {
            // Keyset pagination query
            $query = sprintf(
                "SELECT %s FROM `%s` WHERE `%s` > %s AND `%s` <= %s ORDER BY `%s` LIMIT %d",
                implode(', ', array_map(fn($c) => "`$c`", $columns)),
                $tableName,
                $primaryKey,
                is_numeric($lastId) ? $lastId : "'" . addslashes($lastId) . "'",
                $primaryKey,
                is_numeric($maxId) ? $maxId : "'" . addslashes($maxId) . "'",
                $primaryKey,
                $chunkSize
            );

            $result = $connection->query($query);

            if (!$result) {
                throw new Exception("Keyset SELECT failed for {$tableName}: " . $connection->error);
            }

            if ($result->num_rows === 0) {
                break; // No more rows in this range
            }

            // Collect rows and INSERT in chunks of 1000 for memory efficiency
            $rowBuffer = [];
            $insertChunkSize = 1000;
            $maxIdInChunk = $lastId;

            while ($row = $result->fetch_assoc()) {
                $rowBuffer[] = $row;

                // Track max ID in this chunk
                if ($row[$primaryKey] > $maxIdInChunk) {
                    $maxIdInChunk = $row[$primaryKey];
                }

                // When buffer is full, execute multi-row INSERT
                if (count($rowBuffer) >= $insertChunkSize) {
                    $inserted = $this->executeMultiRowInsert($sourceDb, $tableName, $columns, $rowBuffer);
                    $insertedCount += $inserted;
                    $rowBuffer = [];
                }
            }

            $result->free();

            // Insert remaining rows
            if (!empty($rowBuffer)) {
                $inserted = $this->executeMultiRowInsert($sourceDb, $tableName, $columns, $rowBuffer);
                $insertedCount += $inserted;
            }

            // Update lastId for next iteration
            $lastId = $maxIdInChunk;
        }

        $sourceDb->commit();

        return $insertedCount;
    }

    /**
     * Build wide JOIN query from config (DEPRECATED - use buildSkeletonJoinQuery instead)
     *
     * Creates a single SELECT query that JOINs all related tables.
     * Column names are prefixed with table name to avoid collisions.
     *
     * @param array $config Parsed config
     * @param string $rootTable Root table name
     * @param array $tables List of tables to include
     * @param array $tableGraph Table relationship graph
     * @return string SQL query (without LIMIT/OFFSET)
     */
    private function buildWideJoinQuery(array $config, string $rootTable, array $tables, array $tableGraph): string
    {
        $columns = [];
        $joins = [];

        // Build column list with table prefixes to avoid collisions
        foreach ($tables as $tableName) {
            $tableConfig = $config[$tableName];
            $cols = $this->getColumnsForTable($tableConfig);

            foreach ($cols as $col) {
                // Prefix with table name: media__mediaID, omoccurrences__catalogNumber, etc.
                $columns[] = "`{$tableName}`.`{$col}` AS `{$tableName}__{$col}`";
            }
        }

        // Build JOIN chain from foreign keys
        $visited = [$rootTable => true];
        $this->buildJoinChain($config, $rootTable, $tableGraph, $joins, $visited);

        // Assemble query
        $query = "SELECT " . implode(', ', $columns);
        $query .= " FROM `{$rootTable}`";

        if (!empty($joins)) {
            $query .= " " . implode(' ', $joins);
        }

        // Add WHERE clause from config
        // Prefix column names with root table to avoid ambiguity
        if (isset($config['_config']['where_clause'])) {
            $whereClause = $config['_config']['where_clause'];
            // Replace bare column names with table-prefixed versions
            // This is a simple approach - assumes column names don't appear in strings
            $whereClause = preg_replace_callback(
                '/\b([a-zA-Z_][a-zA-Z0-9_]*)\b/',
                function($matches) use ($rootTable) {
                    $col = $matches[1];
                    // Don't prefix SQL keywords
                    $keywords = ['AND', 'OR', 'NOT', 'IS', 'NULL', 'IN', 'LIKE', 'BETWEEN'];
                    if (in_array(strtoupper($col), $keywords)) {
                        return $col;
                    }
                    return "`{$rootTable}`.`{$col}`";
                },
                $whereClause
            );
            $query .= " WHERE " . $whereClause;
        }

        return $query;
    }

    /**
     * Build JOIN chain recursively from foreign keys
     *
     * @param array $config Parsed config
     * @param string $currentTable Current table being processed
     * @param array $tableGraph Table relationship graph
     * @param array &$joins Array of JOIN clauses (output)
     * @param array &$visited Array of visited tables (to avoid cycles)
     */
    private function buildJoinChain(array $config, string $currentTable, array $tableGraph, array &$joins, array &$visited): void
    {
        if (!isset($tableGraph[$currentTable])) {
            return;
        }

        foreach ($tableGraph[$currentTable] as $refTable => $joinInfo) {
            if (isset($visited[$refTable])) {
                continue; // Avoid circular references
            }

            $localCol = $joinInfo['local_col'];
            $refCol = $joinInfo['ref_col'];

            // Add LEFT JOIN
            $joins[] = sprintf(
                "LEFT JOIN `%s` ON `%s`.`%s` = `%s`.`%s`",
                $refTable,
                $currentTable,
                $localCol,
                $refTable,
                $refCol
            );

            $visited[$refTable] = true;

            // Recursively add joins for this table
            $this->buildJoinChain($config, $refTable, $tableGraph, $joins, $visited);
        }
    }

    /**
     * Split batch data into separate SQLite tables
     *
     * Extracts rows for each table from the wide result set and inserts them
     * using INSERT OR IGNORE (duplicates are automatically skipped based on PRIMARY KEY).
     *
     * @param PDO $db SQLite database
     * @param array $batchData Array of wide rows from JOIN query
     * @param array $config Parsed config
     * @param array $tables List of tables
     * @return array Statistics: table name => rows inserted in this batch
     */
    private function splitBatchIntoTables(PDO $db, array $batchData, array $config, array $tables): array
    {
        $stats = [];

        foreach ($tables as $tableName) {
            $tableConfig = $config[$tableName];
            $primaryKey = $tableConfig['primary_key'] ?? null;
            $columns = $this->getColumnsForTable($tableConfig);

            // Extract unique rows for this table from batch
            $tableRows = [];
            foreach ($batchData as $row) {
                $tableRow = [];
                foreach ($columns as $col) {
                    $key = "{$tableName}__{$col}";
                    if (isset($row[$key])) {
                        $tableRow[$col] = $row[$key];
                    }
                }

                // Skip empty rows
                if (empty($tableRow)) {
                    continue;
                }

                // Deduplicate within batch
                if ($primaryKey) {
                    // Use primary key for deduplication
                    if (!empty($tableRow[$primaryKey])) {
                        $pkValue = $tableRow[$primaryKey];
                        $tableRows[$pkValue] = $tableRow;
                    }
                } else {
                    // No primary key - use serialized row as key for deduplication
                    $rowKey = serialize($tableRow);
                    $tableRows[$rowKey] = $tableRow;
                }
            }

            // INSERT OR IGNORE into SQLite
            $insertedCount = 0;
            if (!empty($tableRows)) {
                $db->beginTransaction();

                foreach ($tableRows as $tableRow) {
                    $cols = array_keys($tableRow);
                    $placeholders = array_fill(0, count($cols), '?');

                    $sql = sprintf(
                        'INSERT OR IGNORE INTO `%s` (%s) VALUES (%s)',
                        $tableName,
                        implode(', ', array_map(fn($c) => "`$c`", $cols)),
                        implode(', ', $placeholders)
                    );

                    $stmt = $db->prepare($sql);
                    $stmt->execute(array_values($tableRow));

                    // Check if row was actually inserted (not a duplicate)
                    if ($stmt->rowCount() > 0) {
                        $insertedCount++;
                    }
                }

                $db->commit();
            }

            $stats[$tableName] = $insertedCount;
        }

        return $stats;
    }

    /**
     * Get list of columns to export for a table from config
     *
     * @param array $tableConfig Table configuration section
     * @return array List of column names
     */
    private function getColumnsForTable(array $tableConfig): array
    {
        $columns = [];

        // Include primary key if defined
        if (isset($tableConfig['primary_key'])) {
            $primaryKey = $tableConfig['primary_key'];
            $columns[] = $primaryKey;
        }

        // Get columns from config
        $configColumns = $tableConfig['columns'] ?? [];
        if (!is_array($configColumns)) {
            $configColumns = [$configColumns];
        }

        foreach ($configColumns as $colDef) {
            // Parse "columnName:type[:flag][:strategy]"
            $parts = explode(':', $colDef);
            $colName = $parts[0];

            if (!in_array($colName, $columns)) {
                $columns[] = $colName;
            }
        }

        // Add foreign key columns if not already included
        if (isset($tableConfig['foreign_key'])) {
            $foreignKeys = $tableConfig['foreign_key'];
            if (!is_array($foreignKeys)) {
                $foreignKeys = [$foreignKeys];
            }

            foreach ($foreignKeys as $fk) {
                // Parse "local_column:referenced_table.referenced_column"
                list($localColumn) = explode(':', $fk);
                if (!in_array($localColumn, $columns)) {
                    $columns[] = $localColumn;
                }
            }
        }

        return $columns;
    }

    /**
     * Create SQLite table with schema from MySQL
     *
     * @param PDO $sourceDb SQLite database
     * @param mysqli $connection MySQL connection
     * @param string $tableName Table name
     * @param array $config Parsed config
     */
    private function createSqliteTable(PDO $sourceDb, mysqli $connection, string $tableName, array $config): void
    {
        $tableConfig = $config[$tableName];
        $primaryKey = $tableConfig['primary_key'] ?? null;
        $columns = $this->getColumnsForTable($tableConfig);

        // Get column types from config
        $columnTypes = [];
        $configColumns = $tableConfig['columns'] ?? [];
        if (!is_array($configColumns)) {
            $configColumns = [$configColumns];
        }

        foreach ($configColumns as $colDef) {
            $parts = explode(':', $colDef);
            $colName = $parts[0];
            $colType = $parts[1] ?? 'text';

            // Map config type to SQLite type
            if ($colType === 'numeric') {
                $columnTypes[$colName] = 'REAL';
            } elseif ($colType === 'date') {
                $columnTypes[$colName] = 'TEXT';
            } else {
                $columnTypes[$colName] = 'TEXT';
            }
        }

        // Build CREATE TABLE statement
        $columnDefs = [];
        foreach ($columns as $col) {
            $sqliteType = $columnTypes[$col] ?? 'TEXT';
            $isPrimaryKey = ($primaryKey && $col === $primaryKey);

            $def = "`{$col}` {$sqliteType}";
            if ($isPrimaryKey) {
                $def .= " PRIMARY KEY";
            }

            $columnDefs[] = $def;
        }

        // For tables without a primary key (like taxstatus with composite key),
        // we'll use a unique constraint on all columns to prevent exact duplicates
        $createSql = sprintf(
            'CREATE TABLE IF NOT EXISTS `%s` (%s)',
            $tableName,
            implode(', ', $columnDefs)
        );

        $sourceDb->exec($createSql);

        // Create indexes for performance
        $this->createTableIndexes($sourceDb, $tableName, $tableConfig, $primaryKey);
    }

    /**
     * Create indexes on SQLite table for performance
     *
     * Creates indexes on:
     * - Primary key column (explicit index for performance)
     * - Foreign key columns (for JOIN performance)
     * - All columns for tables without primary key (unique constraint)
     *
     * @param PDO $sourceDb SQLite database
     * @param string $tableName Table name
     * @param array $tableConfig Table configuration
     * @param string|null $primaryKey Primary key column name
     */
    private function createTableIndexes(PDO $sourceDb, string $tableName, array $tableConfig, ?string $primaryKey): void
    {
        // If no primary key, create a unique index on all columns
        if (!$primaryKey) {
            $columns = $this->getColumnsForTable($tableConfig);
            if (!empty($columns)) {
                $indexName = "{$tableName}_unique_idx";
                $indexSql = sprintf(
                    'CREATE UNIQUE INDEX IF NOT EXISTS `%s` ON `%s` (%s)',
                    $indexName,
                    $tableName,
                    implode(', ', array_map(fn($c) => "`$c`", $columns))
                );
                $sourceDb->exec($indexSql);

                if (Environment::isCli()) {
                    echo sprintf("  Created unique index on %s (%s)\n", $tableName, implode(', ', $columns));
                }
            }
            return;
        }

        // Create explicit index on primary key
        // Note: SQLite automatically creates an index for PRIMARY KEY constraints,
        // but we create an explicit one for consistency and to ensure it exists
        $pkIndexName = "{$tableName}_pk_idx";
        $pkIndexSql = sprintf(
            'CREATE INDEX IF NOT EXISTS `%s` ON `%s` (`%s`)',
            $pkIndexName,
            $tableName,
            $primaryKey
        );
        $sourceDb->exec($pkIndexSql);

        if (Environment::isCli()) {
            echo sprintf("  Created index on %s.%s (primary key)\n", $tableName, $primaryKey);
        }

        // Create indexes on foreign key columns for JOIN performance
        if (isset($tableConfig['foreign_key'])) {
            $foreignKeys = $tableConfig['foreign_key'];
            if (!is_array($foreignKeys)) {
                $foreignKeys = [$foreignKeys];
            }

            foreach ($foreignKeys as $fk) {
                // Parse "local_column:referenced_table.referenced_column"
                if (preg_match('/^([^:]+):([^.]+)\.(.+)$/', $fk, $matches)) {
                    $localColumn = $matches[1];

                    // Skip if this is the primary key (already indexed above)
                    if ($localColumn === $primaryKey) {
                        continue;
                    }

                    // Create index on foreign key column
                    $indexName = "{$tableName}_{$localColumn}_idx";
                    $indexSql = sprintf(
                        'CREATE INDEX IF NOT EXISTS `%s` ON `%s` (`%s`)',
                        $indexName,
                        $tableName,
                        $localColumn
                    );
                    $sourceDb->exec($indexSql);

                    if (Environment::isCli()) {
                        echo sprintf("  Created index on %s.%s (foreign key)\n", $tableName, $localColumn);
                    }
                }
            }
        }
    }

    /**
     * Get configured EAV cache database path
     */
    private function getEavCachePath(): ?string
    {
        $config = Configuration::getInstance();
        return $config->get('components.images.images_cache_db');
    }

    /**
     * Get PDO connection to EAV cache database
     * Uses DatabaseManager to get connection from Configuration
     * Can be overridden in tests by setting a custom cache path via params
     */
    private function getEavCacheConnection(?string $dbPath = null): ?\PDO
    {
        // If a custom path is provided (for testing), use it directly
        if ($dbPath !== null) {
            if (!file_exists($dbPath)) {
                return null;
            }

            try {
                $db = new \PDO("sqlite:$dbPath");
                $db->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);
                return $db;
            } catch (\Exception $e) {
                error_log("Failed to connect to EAV cache: " . $e->getMessage());
                return null;
            }
        }

        // Use DatabaseManager to get connection from Configuration
        $dbManager = new DatabaseManager();
        return $dbManager->getSqliteConnection('images_cache');
    }

    /**
     * Cleanup EAV cache files
     */
    private function eavCacheCleanup(array $params): array
    {
        // Handle --help option
        if (isset($params['help']) || isset($params['h'])) {
            if (Environment::isCli()) {
                echo "\n";
                echo "EAV Cache Cleanup\n";
                echo "=================\n\n";
                echo "Clean up EAV cache database files.\n\n";
                echo "Usage:\n";
                echo "  php index.php images eav-cache-cleanup [options]\n\n";
                echo "Options:\n";
                echo "  --help, -h       Show this help message\n";
                echo "  --work           Clean only work database (temporary build files)\n";
                echo "  --full           Clean all cache files (work + cache databases)\n";
                echo "  --db-path=PATH   Custom cache database path\n\n";
                echo "Examples:\n";
                echo "  # Clean only work database\n";
                echo "  php index.php images eav-cache-cleanup --work\n\n";
                echo "  # Clean all cache files\n";
                echo "  php index.php images eav-cache-cleanup --full\n\n";
                echo "Note: Without options, does nothing (safe default).\n";
                echo "      Use --work to clean temporary files.\n";
                echo "      Use --full to completely remove the cache.\n\n";
            }
            return [
                'type' => 'success',
                'content' => 'Help displayed'
            ];
        }

        try {
            $config = Configuration::getInstance();
            $cacheDbPath = $params['db-path'] ?? $config->get('components.images.images_cache_db');
            $workDbPath = str_replace('.db', '_work.db', $cacheDbPath);
            $configPath = __DIR__ . '/../../templates/sql/images/index_config.ini';

            $eavModel = new ImagesModelEav([
                'config_path' => $configPath,
                'work_db_path' => $workDbPath,
                'cache_db_path' => $cacheDbPath
            ]);

            // Determine cleanup mode
            $workOnly = isset($params['work']);
            $full = isset($params['full']);

            if (!$workOnly && !$full) {
                if (Environment::isCli()) {
                    echo "\n⚠️  No cleanup mode specified.\n";
                    echo "Use --work to clean temporary files, or --full to remove all cache.\n";
                    echo "Run with --help for more information.\n\n";
                }
                return [
                    'type' => 'error',
                    'message' => 'No cleanup mode specified. Use --work or --full.'
                ];
            }

            if (Environment::isCli()) {
                echo "\n=== EAV Cache Cleanup ===\n";
                if ($full) {
                    echo "Mode: Full cleanup (work + cache databases)\n";
                } else if ($workOnly) {
                    echo "Mode: Work database only\n";
                }
                echo "\n";
            }

            // Perform cleanup
            $result = $eavModel->cleanupDatabases([
                'work' => $workOnly,
                'full' => $full
            ]);

            if (Environment::isCli()) {
                if ($full) {
                    echo "✓ Removed cache database: {$cacheDbPath}\n";
                    echo "✓ Removed work database: {$workDbPath}\n";
                } else if ($workOnly) {
                    echo "✓ Removed work database: {$workDbPath}\n";
                }
                echo "\n✓ Cleanup complete\n\n";
            }

            return $result;

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to cleanup cache',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
     * Get EAV cache information
     */
    private function cacheInfo(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $cacheDbPath = $params['db-path'] ?? $config->get('components.images.images_cache_db');
            $workDbPath = str_replace('.db', '_work.db', $cacheDbPath);
            $configPath = __DIR__ . '/../../templates/sql/images/index_config.ini';

            // Check if cache exists
            if (!file_exists($cacheDbPath)) {
                if (Environment::isCli()) {
                    echo "\n❌ Cache database not found: {$cacheDbPath}\n";
                    echo "Run: php index.php images cache-build-eav\n\n";
                }
                return [
                    'type' => 'error',
                    'message' => 'Cache database not found',
                    'content' => 'Run cache-build-eav to create the cache.'
                ];
            }

            // Create ImagesModelEav instance
            $eavModel = new ImagesModelEav([
                'config_path' => $configPath,
                'work_db_path' => $workDbPath,
                'cache_db_path' => $cacheDbPath
            ]);

            // Get info
            $result = $eavModel->getInfo($params);

            if (Environment::isCli()) {
                echo "\n" . $result['content'] . "\n";
            }

            return $result;

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to get cache info',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
     * Handle 'images cache' command with --info, --build, --refresh flags
     */
    private function handleCacheCommand(array $params): array
    {
        // Check for IP whitelist if this is an HTTP request
        if (!Environment::isCli()) {
            $ipCheckResult = $this->checkRefreshIpWhitelist();
            if ($ipCheckResult !== null) {
                return $ipCheckResult;
            }
        }

        // Determine which sub-command to execute
        if (isset($params['info'])) {
            return $this->hybridIndexInfo($params);
        } elseif (isset($params['get-source'])) {
            // Alias to cache-eav --get-source (same source.db for both)
            return $this->exportEavTsvNew($params);
        } elseif (isset($params['build'])) {
            return $this->buildHybridIndex($params);
        } elseif (isset($params['refresh'])) {
            return $this->refreshHybridIndex($params);
        } elseif (isset($params['cleanup'])) {
            return $this->cleanupHybridIndex($params);
        } else {
            // No flag specified - show help
            return [
                'type' => 'error',
                'message' => "images cache requires a flag: --info, --get-source, --build, --refresh, or --cleanup\n" .
                            "Usage:\n" .
                            "  php index.php images cache --info [--output-dir=<path>]\n" .
                            "  php index.php images cache --get-source [--output-file=<path>] [--batch-size=<n>] [--limit=<n>]\n" .
                            "  php index.php images cache --build [--sourcedb=<path>] [--output-dir=<path>] [--batch-size=<n>]\n" .
                            "  php index.php images cache --refresh [--output-file=<path>]\n" .
                            "  php index.php images cache --cleanup [--output-dir=<path>] [--delete]\n" .
                            "\nNote: --get-source creates source.db used by both cache and cache-eav (shared operation)\n"
            ];
        }
    }

    /**
     * Handle 'images cache-eav' command with --get-source, --build, --info, --cleanup flags
     */
    private function handleCacheEavCommand(array $params): array
    {
        // Determine which sub-command to execute
        if (isset($params['get-source'])) {
            return $this->exportEavTsvNew($params);
        } elseif (isset($params['build'])) {
            return $this->buildEavIndexNew($params);
        } elseif (isset($params['info'])) {
            return $this->cacheInfo($params);
        } elseif (isset($params['cleanup'])) {
            return $this->eavCacheCleanup($params);
        } else {
            // No flag specified - show help
            return [
                'type' => 'error',
                'message' => "images cache-eav requires a flag: --get-source, --build, --info, or --cleanup\n" .
                            "Usage:\n" .
                            "  php index.php images cache-eav --get-source [--output-dir=<path>] [--sourcedb=<path>]\n" .
                            "  php index.php images cache-eav --build [--sourcedb=<path>] [--output-dir=<path>]\n" .
                            "  php index.php images cache-eav --info\n" .
                            "  php index.php images cache-eav --cleanup\n"
            ];
        }
    }

    /**
     * Check IP whitelist for refresh endpoint (HTTP only)
     * Returns null if allowed, error array if blocked
     */
    private function checkRefreshIpWhitelist(): ?array
    {
        $config = Configuration::getInstance();
        $allowedIps = $config->get('components.images.allowed_refresh_ips', []);

        // If no whitelist configured, allow all
        if (empty($allowedIps)) {
            return null;
        }

        // Get client IP
        $clientIp = $_SERVER['REMOTE_ADDR'] ?? '';

        // Check if IP is in whitelist
        if (!in_array($clientIp, $allowedIps, true)) {
            return [
                'type' => 'error',
                'message' => 'Access denied: IP address not authorized for cache refresh',
                'status_code' => 403
            ];
        }

        return null;
    }

    /**
     * Build autocomplete cache for hybrid search
     */
    private function buildAutocompleteCache(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $autocompleteCachePath = $params['db-path'] ?? $config->get('components.images.autocomplete_cache_db');
            $configPath = __DIR__ . '/../../templates/sql/images/eav/index_config.ini';

            // Create autocomplete builder
            // It will use DatabaseManager internally to get MySQL connection
            $builder = new ImagesModelAutocomplete([
                'config_path' => $configPath,
                'autocomplete_db_path' => $autocompleteCachePath,
                'mysql_config' => [] // Empty - will use DatabaseManager
            ]);

            // Build cache (pass params for --source-db-path support)
            $result = $builder->buildAutocompleteCache($params);

            return $result;

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to build autocomplete cache',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
     * Build hybrid index for fast indexed field search
     */
    private function buildHybridIndex(array $params): array
    {
        try {
            $config = Configuration::getInstance();
            $hybridIndexPath = $params['db-path'] ?? $config->get('components.images.hybrid_index_db');
            $configPath = __DIR__ . '/../../templates/sql/images/index_config.ini';

            if (empty($hybridIndexPath)) {
                throw new Exception('Hybrid index path not configured. Set components.images.hybrid_index_db in config.php');
            }

            // Create hybrid index builder
            $builder = new ImagesModelHybridIndex([
                'config_path' => $configPath,
                'hybrid_index_db_path' => $hybridIndexPath
            ]);

            // Build index (pass params for --source-db-path support)
            $sourceDbPath = $params['source-db-path'] ?? $config->get('components.images.source_db');

            if (empty($sourceDbPath) || !file_exists($sourceDbPath)) {
                throw new Exception('Source database not found. Run: php index.php images cache --get-source');
            }

            if (Environment::isCli()) {
                echo "\n🔨 Building hybrid index from source.db...\n";
            }

            $result = $builder->buildIndex($sourceDbPath);

            if (Environment::isCli()) {
                echo "✅ Hybrid index build complete\n";
                echo "\nIndex location: {$hybridIndexPath}\n";

                // Show stats
                $stats = $builder->getIndexStats();
                if ($stats) {
                    echo "\n📊 Index Statistics:\n";
                    echo "  • Entities: " . number_format($stats['entities'] ?? 0) . "\n";
                    echo "  • Collections: " . number_format($stats['collections'] ?? 0) . "\n";
                    echo "  • Attributes: " . number_format($stats['attributes'] ?? 0) . "\n";
                    echo "  • Distinct values: " . number_format($stats['values'] ?? 0) . "\n";
                    echo "  • EAV entries: " . number_format($stats['eav_entries'] ?? 0) . "\n";

                    if (file_exists($hybridIndexPath)) {
                        $sizeBytes = filesize($hybridIndexPath);
                        $sizeMB = round($sizeBytes / 1024 / 1024, 2);
                        echo "  • Index size: {$sizeMB} MB\n";
                    }
                }
                echo "\n";
            }

            return [
                'type' => 'success',
                'message' => 'Hybrid index built successfully',
                'data' => $result
            ];

        } catch (Exception $e) {
            if (Environment::isCli()) {
                echo "\n❌ Error: " . $e->getMessage() . "\n\n";
            }
            return [
                'type' => 'error',
                'message' => 'Failed to build hybrid index',
                'content' => $e->getMessage()
            ];
        }
    }

    /**
