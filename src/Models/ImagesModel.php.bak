<?php

namespace Symbiota\Helpers\Models;

use Symbiota\Helpers\Core\Model;
use Symbiota\Helpers\Core\Configuration;
use Symbiota\Helpers\Core\DatabaseManager;
use Symbiota\Helpers\Core\TemplateEngine;
use Symbiota\Helpers\Core\TemplateFormat;
use Symbiota\Helpers\Core\ProgressSpinner;
use Symbiota\Helpers\Core\ModuleType;
use Symbiota\Helpers\Core\Environment;
use Symbiota\Helpers\Core\UriParser;
use Symbiota\Helpers\Core\ApplicationPaths;
use Symbiota\Helpers\Core\EavIndexing;
use Symbiota\Helpers\Models\ImagesModelEav;
use Symbiota\Helpers\Models\ImagesModelHybrid;
use Symbiota\Helpers\Interfaces\ImagesSearchInterface;
use mysqli;
use Exception;
use PDO;

/**
 * Images Model - Self-Discovering
 *
 * Image gallery with endless scroll, search, sort, and filter capabilities.
 * Provides responsive grid layout and image details modal.
 *
 * Router/Facade Pattern:
 * - Detects search mode (EAV or Hybrid) based on configuration and cache availability
 * - Instantiates appropriate search plugin (ImagesModelEav or ImagesModelHybrid)
 * - Delegates autocomplete and search calls to the active plugin
 *
 * @version 2.0.0
 * @author Symbiota Portal Helpers
 */
class ImagesModel extends Model
{
    // Images is a public read-only service - no authentication required
    protected bool $requiresAuth = false;
    protected array $publicActions = ['index', 'help', 'load', 'stream', 'search', 'load-more', 'autocomplete-collections', 'autocomplete-taxa', 'autocomplete-collection-codes', 'filter', 'details', 'download'];

    private int $defaultImagesPerQuery;
    private bool $enableRandomLoading;

    // Plugin delegation
    private ?ImagesSearchInterface $searchPlugin = null;
    private ?string $detectedSearchMode = null;

    public function __construct(array $config = [])
    {
        parent::__construct($config);

        // Load images module configuration from Configuration singleton
        $configuration = Configuration::getInstance();
        $this->defaultImagesPerQuery = $configuration ?
            (int)$configuration->get('mod.images.images_per_request', 30) : 30;
        $this->enableRandomLoading = $configuration ?
            (bool)$configuration->get('mod.images.images_enable_random', true) : true;

        // Set public actions for images module
        $this->publicActions = [
            // Basic actions
            'index', 'help', 'status',

            // Search actions
            'load', 'stream', 'search', 'search-advanced', 'search-by-occid',
            'search-by-catalog', 'search-by-collection', 'search-by-taxon', 'search-by-filename',
            'details', 'filter',

            // Autocomplete actions
            'autocomplete-collections', 'autocomplete-taxa', 'autocomplete-collection-codes',

            // New simplified cache commands
            'cache', 'cache-eav', 'refresh',

            // Legacy cache management actions (deprecated but maintained for backward compatibility)
            'cache-status', 'cache-refresh', 'cache-cleanup', 'cache-info',
            'cache-get-source', 'cache-build-eav', 'cache-import-tsv', 'cache-generate-sql',
            'eav-search', 'eav-cache-cleanup',
            'cache-build-autocomplete', 'cache-info-autocomplete'
        ];
    }

    /**
     * Get the model's routing resource ID
     */
    public static function getModelId(): string
    {
        return 'images';
    }

    /**
     * Get the module type classification
     */
    public static function getModuleType(): ModuleType
    {
        return ModuleType::COMPONENT;
    }

    /**
     * Get the model's help documentation in markdown format
     */
    public static function getHelpMarkdown(): string
    {
        // Get the entry file name dynamically
        $entryFile = basename(ApplicationPaths::applicationFilename());

        // Load help content from template
        $templatePath = sprintf('%s/cli/help/images_model.txt', ApplicationPaths::templatesDirectory());
        if (!file_exists($templatePath)) {
            return 'Help documentation not found.';
        }

        $helpContent = file_get_contents($templatePath);

        // Use TemplateEngine for variable interpolation
        $templateEngine = new TemplateEngine();
        return $templateEngine->render($helpContent, ['entry_file' => $entryFile]);
    }

    /**
     * Get parsed help information from markdown
     */
    public static function getHelpInfo(): array
    {
        return static::parseHelpMarkdown(static::getHelpMarkdown());
    }

    /**
     * Parse help markdown into structured data
     *
     * Based on DiscoverableModel::parseHelpMarkdown()
     */
    protected static function parseHelpMarkdown(string $markdown): array
    {
        $info = ['description' => '', 'usage' => [], 'parameters' => [], 'examples' => [], 'permissions' => []];
        $lines = explode("\n", $markdown);
        $section = null;

        foreach ($lines as $line) {
            $line = trim($line);
            if (empty($line)) continue;

            if (preg_match('/^## (.+)$/', $line, $m)) {
                $section = strtolower($m[1]);
            } elseif ($section === null && empty($info['description'])) {
                $info['description'] = $line;
            } elseif ($section === 'parameters' && preg_match('/^- `([^`]+)`\s*(.*)$/', $line, $m)) {
                $required = str_contains($m[2], '(required)');
                $type = str_contains($m[2], 'integer') ? 'integer' : (str_contains($m[2], 'array') ? 'array' : 'string');
                $info['parameters'][$m[1]] = ['description' => preg_replace('/\([^)]*\)/', '', $m[2]), 'required' => $required, 'type' => $type];
            } elseif (in_array($section, ['usage', 'examples', 'permissions']) && preg_match('/^- (.+)$/', $line, $m)) {
                $info[$section][] = $m[1];
            }
        }

        return $info;
    }

    /**
     * Execute the requested action - implements Model base class method
     */
    protected function executeAction(string $action, array $route, array $params): array
    {
        switch ($action) {
            case 'index':
            case '':
                return $this->getMainPage();
            case 'load':
                return $this->loadImages($params);
            case 'stream':
                return $this->stream($params);
            case 'search':
                // Route to appropriate search method based on search_mode and cache availability
                return $this->routeSearch($params);
            case 'load-more':
                return $this->loadMoreImages($params);
            case 'autocomplete-fields':
                return $this->autocompleteFields($params);
            case 'autocomplete-values':
                return $this->autocompleteValues($params);
            case 'autocomplete-collections':
                return $this->autocompleteCollections($params);
            case 'autocomplete-taxa':
                return $this->autocompleteTaxa($params);
            case 'autocomplete-collection-codes':
                return $this->autocompleteCollectionCodes($params);
            case 'filter':
                return $this->filterImages($params);
            case 'details':
                return $this->getImageDetails($params);
            case 'overlay':
                return $this->handleOverlayAction($route, $params);
            // New simplified cache commands
            case 'cache':
                return $this->handleCacheCommand($params);
            case 'cache-eav':
                return $this->handleCacheEavCommand($params);
            case 'refresh':
                // Alias to 'images cache --refresh'
                $params['refresh'] = true;
                return $this->handleCacheCommand($params);

            // Legacy commands (deprecated but maintained for backward compatibility)
            case 'cache-cleanup':
                return $this->handleCacheCleanupAction($params);
            case 'cache-status':
                return $this->getCacheStatus($params);
            case 'cache-refresh':
                return $this->refreshCache($params);
            case 'cache-generate-sql':
                return $this->generateEavSql($params);
            case 'cache-build-eav':
                return $this->buildEavIndexNew($params);
            case 'cache-build-eav-optimized':
                return $this->buildEavIndexOptimized($params);
            case 'cache-get-source':
            case 'cache-export-tsv':
                return $this->exportEavTsvNew($params);
            case 'eav-cache-cleanup':
                return $this->eavCacheCleanup($params);
            case 'cache-info':
                return $this->cacheInfo($params);
            case 'cache-build-autocomplete':
                return $this->buildAutocompleteCache($params);
            case 'cache-info-autocomplete':
                return $this->autocompleteInfo($params);
            case 'cache-build-hybrid':
                return $this->buildHybridIndex($params);
            case 'cache-info-hybrid':
            case 'cache-hybrid-info':
                return $this->hybridIndexInfo($params);

            // Other commands
            case 'api-key-create':
                return $this->createApiKey($params);
            case 'api-key':
                return $this->showApiKey($params);
            case 'download':
                return $this->downloadImages($params);
            case 'clear':
                return $this->clearCache($params);
            case 'status':
                return $this->getImagesStatus($params);
            case 'help':
                return $this->getHelp();
            case 'check-tables':
                return $this->checkImageTables();
            case 'check-media-structure':
                return $this->checkMediaTableStructure();
            case 'modal':
                return $this->loadImageModal($params);
            case 'invalid':
                return $this->reportInvalidImages($params);
            default:
                return [
                    'type' => 'error',
                    'message' => "Unknown action: {$action}",
                    'status_code' => 404
                ];
        }
    }

    /**
     * Get main image gallery page
     */
    public function getMainPage(): array
    {
        if (Environment::isCli()) {
            return [
                'type' => 'success',
                'content' => "Images Gallery - Use 'helpers.php images --help' for more information"
            ];
        }

        // Get collection options for the filter dropdown
        $collectionOptions = $this->getCollectionOptions();

        // Generate CSRF token for invalid image reporting
        $csrfToken = $this->generateCsrfToken();

        // Render the search component
        $searchComponent = $this->renderTemplate('search_component', TemplateFormat::HTML, [
            'app_url_prefix' => $this->getAppUrlPrefix()
        ]);

        // Include the search component JavaScript
        $jsPath = ApplicationPaths::templatesDirectory() . '/html/images/search_component.js';
        $searchComponentJs = file_exists($jsPath) ? file_get_contents($jsPath) : '';

        // Get the main content using the content template
        $defaultSort = $this->enableRandomLoading ? 'random' : 'date_created';
        $mainContent = $this->renderTemplate('content', TemplateFormat::HTML, [
            'app_url_prefix' => $this->getAppUrlPrefix(),
            'collection_options' => $collectionOptions,
            'images_per_request' => $this->defaultImagesPerQuery,
            'default_sort' => $defaultSort,
            'random_selected' => $this->enableRandomLoading ? 'selected' : '',
            'date_selected' => !$this->enableRandomLoading ? 'selected' : '',
            'csrf_token' => $csrfToken,
            'search_component' => $searchComponent
        ]);

        // Add the JavaScript to the content
        $mainContent .= "\n<script>\n" . $searchComponentJs . "\n</script>";

        return [
            'type' => 'html',
            'content' => $mainContent
        ];
    }

    /**
     * Get collection options for filter dropdown
     */
    private function getCollectionOptions(): string
    {
        try {
            $connection = $this->getDatabaseConnection('readonly');

            if (!$connection) {
                return '<option value="">Database connection failed</option>';
            }

            $sql = $this->renderTemplate('collections_list', TemplateFormat::SQL, []);

            $result = $connection->query($sql);
            $options = '';

            if ($result) {
                while ($row = $result->fetch_assoc()) {
                    $displayName = $row['collectionname'];
                    if ($row['institutioncode']) {
                        $displayName .= ' (' . $row['institutioncode'] . ')';
                    }
                    $options .= sprintf(
                        '<option value="%d">%s</option>',
                        $row['collid'],
                        htmlspecialchars($displayName)
                    );
                }
            }

            return $options ?: '<option value="">No collections found</option>';
        } catch (Exception $e) {
            return '<option value="">Error loading collections</option>';
        }
    }

    /**
     * Load more images (for endless scroll)
     */
    public function loadImages(array $params): array
    {
        $limit = (int)($params['limit'] ?? $this->defaultImagesPerQuery);
        $offset = (int)($params['offset'] ?? 0);
        $search = $params['search'] ?? '';
        $sort = $params['sort'] ?? ($this->enableRandomLoading ? 'random' : 'date_created');
        $filter = $params['filter'] ?? '';

        return $this->executeWithFallback(
            'load',
            function() use ($limit, $offset, $search, $sort, $filter) {
                // Database operation
                $images = $this->getImagesFromDatabase($limit, $search, $sort, $filter);
                $hasMore = count($images) >= $limit; // For random, always assume more available
                $nextOffset = $offset + count($images);

                if (Environment::isCli()) {
                    $actualCount = count($images);
                    $outputLines = [sprintf('Loaded %d images from Symbiota database (requested: %d)', $actualCount, $limit)];
                    foreach ($images as $image) {
                        $caption = $image['caption'] ? sprintf('(%s)', $image['caption']) : '';
                        $outputLines[] = sprintf('- %s %s', $image['filename'], $caption);
                    }
                    $output = implode("\n", $outputLines);
                    return [
                        'type' => 'success',
                        'content' => $output
                    ];
                }

                // Generate HTML server-side for better performance
                $imagesHtml = $this->generateImagesHtml($images);
                $loadMoreHtml = $hasMore ? $this->generateLoadMoreHtml($nextOffset) : '';

                $content = $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                    'images_html' => $imagesHtml,
                    'load_more_html' => $loadMoreHtml,
                    'app_url_prefix' => $this->getAppUrlPrefix()
                ]);

                return [
                    'type' => 'htmx',
                    'content' => $content
                ];
            },
            function() use ($limit, $offset, $search, $sort, $filter) {
                // Fixture fallback
                $images = $this->getFixtureImages($limit, $offset, $search, $sort, $filter);
                $hasMore = count($images) >= $limit;
                $nextOffset = $offset + count($images);

                if (Environment::isCli()) {
                    $actualCount = count($images);
                    $outputLines = [sprintf('Loaded %d fixture images (requested: %d)', $actualCount, $limit)];
                    foreach ($images as $image) {
                        $caption = $image['caption'] ? sprintf('(%s)', $image['caption']) : '';
                        $outputLines[] = sprintf('- %s %s', $image['filename'], $caption);
                    }
                    $output = implode("\n", $outputLines);
                    return [
                        'type' => 'success',
                        'content' => $output
                    ];
                }

                // For HTTP requests, return HTML with database unavailable message
                $unavailableHtml = $this->renderTemplate('database_unavailable', TemplateFormat::HTML, [
                    'message' => 'Database unavailable. Showing sample images.'
                ]);
                $imagesHtml = $this->generateImagesHtml($images);
                $loadMoreHtml = $hasMore ? $this->generateLoadMoreHtml($nextOffset) : '';

                $content = $unavailableHtml . $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                    'images_html' => $imagesHtml,
                    'load_more_html' => $loadMoreHtml,
                    'app_url_prefix' => $this->getAppUrlPrefix()
                ]);

                return [
                    'type' => 'htmx',
                    'content' => $content
                ];
            }
        );
    }

    /**
     * Stream images with progressive loading - HTMX endpoint
     * Loads images in chunks of 5, validates them, and returns valid images immediately
     */
    public function stream(array $params = []): array
    {
        $requestedLimit = (int)($params['limit'] ?? $this->defaultImagesPerQuery);
        $offset = (int)($params['offset'] ?? 0);
        $sort = $params['sort'] ?? ($this->enableRandomLoading ? 'random' : 'date_created');
        $search = $params['search'] ?? '';
        $filter = $params['filter'] ?? '';
        $progressive = $params['progressive'] ?? true; // Enable progressive loading by default

        return $this->executeWithFallback(
            'stream',
            function() use ($requestedLimit, $offset, $search, $sort, $filter, $progressive, $params) {
                // Use fast basic loading for default browsing (no search/filter)
                if (empty($search) && empty($filter) && $this->enableRandomLoading) {
                    $rawImages = $this->executeBasicImageQuery($requestedLimit);

                    // Build load more URL for stream endpoint
                    $nextOffset = $offset + $requestedLimit;
                    $loadMoreUrl = $this->getAppUrlPrefix() . "images/stream?limit={$requestedLimit}&sort={$sort}&offset={$nextOffset}";

                    // Use unified rendering method (handles no results, load more button, etc.)
                    return $this->renderImagesWithLoadMore($rawImages, $requestedLimit, $offset, $loadMoreUrl, null);
                } else {
                    // Use traditional loading for search/filter operations
                    $conditions = [];
                    if (!empty($search)) {
                        $db = $this->getDatabaseConnection('readonly');
                        $escapedSearch = $db ? mysqli_real_escape_string($db, $search) : $search;
                        $conditions[] = sprintf("(o.sciname LIKE '%%%s%%' OR c.collectionname LIKE '%%%s%%')",
                            $escapedSearch,
                            $escapedSearch
                        );
                    }
                    if (!empty($filter)) {
                        $conditions[] = sprintf("c.collid = %d", (int)$filter);
                    }

                    $orderBy = $sort === 'random' ? 'RAND()' : 'm.mediaid DESC';
                    $rawImages = $this->executeDetailedImageQuery($conditions, $orderBy, $requestedLimit, $offset);

                    if (empty($rawImages)) {
                        return [
                            'type' => 'htmx',
                            'content' => '<div class="text-center text-muted py-4">No more images available</div>'
                        ];
                    }

                    // Always validate images concurrently to prevent browser errors
                    $validImages = $this->validateImagesConcurrently($rawImages);

                    // Take only the requested number of valid images
                    $validImages = array_slice($validImages, 0, $requestedLimit);

                    if (empty($validImages)) {
                        return [
                            'type' => 'htmx',
                            'content' => '<div class="text-center text-muted py-4">No valid images found</div>'
                        ];
                    }

                    return [
                        'type' => 'htmx',
                        'content' => $this->generateImagesHtml($validImages)
                    ];
                }
            },
            function() use ($requestedLimit, $offset, $search, $sort, $filter) {
                // Fixture fallback for when database is unavailable
                $images = $this->getFixtureImages($requestedLimit, $offset, $search, $sort, $filter);
                return [
                    'type' => 'htmx',
                    'content' => $this->generateImagesHtml($images)
                ];
            }
        );
    }

    /**
     * Execute progressive image loading - load and validate images in chunks of 5
     * Returns valid images immediately without waiting for full batch
     */
    private function executeProgressiveImageLoading(int $requestedLimit, int $offset, string $sort): array
    {
        $chunkSize = $this->defaultImagesPerQuery; // Use config value for chunk size
        $validImages = [];
        $processedCount = 0;
        $maxAttempts = $requestedLimit * 4; // Allow more attempts to find valid images

        // Get max media ID for sampling
        $maxMediaId = $this->getMaxMediaIdForSampling();
        if (!$maxMediaId) {
            return [
                'type' => 'htmx',
                'content' => '<div class="text-center text-muted py-4">No images available</div>'
            ];
        }

        while (count($validImages) < $requestedLimit && $processedCount < $maxAttempts) {
            // Query a chunk of images using basic query
            $rawImages = $this->executeBasicImageQuery($chunkSize);

            if (empty($rawImages)) {
                break;
            }

            // Validate this chunk concurrently
            $chunkValidImages = $this->validateImagesConcurrently($rawImages);

            // Add valid images to our collection
            foreach ($chunkValidImages as $image) {
                if (count($validImages) >= $requestedLimit) {
                    break;
                }
                $validImages[] = $image;
            }

            $processedCount += count($rawImages);

            // Continue until we reach the requested limit
            // Progressive loading means we process in chunks but still get the full amount requested
            if (count($validImages) >= $requestedLimit) {
                break;
            }
        }

        if (empty($validImages)) {
            return [
                'type' => 'htmx',
                'content' => '<div class="text-center text-muted py-4">No valid images found</div>'
            ];
        }

        $imagesHtml = $this->generateImagesHtml($validImages);

        // Generate load more button if we got the requested amount (indicating more might be available)
        $loadMoreHtml = '';
        if (count($validImages) >= $requestedLimit) {
            $nextOffset = $offset + count($validImages);
            $loadMoreHtml = $this->renderTemplate('load_more_button', TemplateFormat::HTML, [
                'app_url_prefix' => $this->getAppUrlPrefix(),
                'images_per_request' => $requestedLimit,
                'sort' => $sort,
                'next_offset' => $nextOffset
            ]);
        }

        return [
            'type' => 'htmx',
            'content' => $imagesHtml,
            'load_more_html' => $loadMoreHtml,
            'images_loaded' => count($validImages),
            'images_requested' => $requestedLimit,
            'progressive' => true
        ];
    }

    /**
     * Generate infinite scroll trigger element
     */
    private function generateInfiniteScrollTrigger(int $offset, int $limit, string $sort): string
    {
        return sprintf(
            '<div id="infinite-scroll-trigger-%d"
                  hx-get="%simages/stream?limit=%d&sort=%s&offset=%d"
                  hx-trigger="intersect once"
                  hx-target="#image-gallery"
                  hx-swap="beforeend"
                  hx-indicator="#infinite-loading"
                  hx-on::after-request="this.remove()"
                  style="height: 1px; margin-top: 20px;">
             </div>',
            $offset,
            $this->getAppUrlPrefix(),
            $limit,
            $sort,
            $offset
        );
    }

    /**
     * Autocomplete EAV search fields
     * Returns available field names and their aliases for search
     *
     * Router method - delegates to search plugin
     */
    public function autocompleteFields(array $params): array
    {
        $query = strtolower($params['q'] ?? $params['query'] ?? '');

        // Check if user has typed "field:value" pattern
        // If so, switch to value autocomplete for special fields
        if (preg_match('/^(collection):(.*)$/i', $query, $matches)) {
            $field = strtolower($matches[1]);
            $searchValue = $matches[2];

            // Special handling for collection field - search across multiple columns
            if ($field === 'collection' && strlen($searchValue) >= 2) {
                return $this->autocompleteCollectionValues($searchValue);
            } else if ($field === 'collection') {
                return [
                    'type' => 'htmx',
                    'content' => '<div class="autocomplete-message">Type at least 2 characters after collection:...</div>'
                ];
            }
        }

        // Check for other field:value patterns and delegate to value autocomplete
        if (preg_match('/^([a-z]+):(.+)$/i', $query, $matches)) {
            $field = strtolower($matches[1]);
            $searchValue = $matches[2];

            if (strlen($searchValue) >= 2) {
                // Delegate to autocompleteValues
                return $this->autocompleteValues([
                    'field' => $field,
                    'q' => $searchValue
                ]);
            } else {
                return [
                    'type' => 'htmx',
                    'content' => '<div class="autocomplete-message">Type at least 2 characters...</div>'
                ];
            }
        }

        // Delegate to search plugin
        return $this->delegateAutocompleteFields($params);
    }

    /**
     * Get human-readable description for a field
     */
    private function getFieldDescription(string $alias, string $actualField): string
    {
        $descriptions = [
            'date' => 'Event date (supports <, >, <=, >=, ranges)',
            'taxon' => 'Scientific name or taxon',
            'genus' => 'Genus name',
            'family' => 'Family name',
            'state' => 'State or province',
            'country' => 'Country name',
            'locality' => 'Locality description',
            'county' => 'County name',
            'municipality' => 'Municipality name',
            'collection' => 'Collection name, code, or institution (searches all)',
            'collectioncode' => 'Collection code',
            'collid' => 'Collection ID (numeric)',
            'catalog' => 'Catalog number',
            'occid' => 'Occurrence ID',
            'photographer' => 'Photographer name',
            'owner' => 'Image owner',
            'copyright' => 'Copyright holder',
            'rights' => 'Usage rights',
            'type' => 'Image type/format',
            'tag' => 'Image tag',
            'notes' => 'Image notes',
        ];

        return $descriptions[$alias] ?? "Search by $actualField";
    }

    /**
     * Autocomplete values for a specific field from EAV cache
     *
     * Router method - delegates to search plugin
     */
    public function autocompleteValues(array $params): array
    {
        $field = $params['field'] ?? '';
        $query = $params['q'] ?? $params['query'] ?? '';

        if (empty($field)) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Field parameter required</div>'
            ];
        }

        if (strlen($query) < 2) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Type at least 2 characters...</div>'
            ];
        }

        // Delegate to search plugin
        return $this->delegateAutocompleteValues($params);
    }

    /**
     * Autocomplete using specialized indexes for fast lookups
     * Routes to appropriate index based on field type
     */
    private function autocompleteFromIndex(string $field, string $query, int $limit = 20, ?string $dbPath = null): ?array
    {
        // Map fields to their autocomplete index tables
        $indexMap = [
            'taxon' => 'autocomplete_taxon',
            'sciname' => 'autocomplete_taxon',
            'scientificname' => 'autocomplete_taxon',
            'collection' => 'autocomplete_collection',
            'collectionname' => 'autocomplete_collection',
            'collectioncode' => 'autocomplete_collection',
            'institutioncode' => 'autocomplete_collection',
            'collid' => 'autocomplete_collection',
            'county' => 'autocomplete_location',
            'country' => 'autocomplete_location',
            'stateprovince' => 'autocomplete_location',
            'state' => 'autocomplete_location',
            'date' => 'autocomplete_date',
            'eventdate' => 'autocomplete_date',
        ];

        $indexTable = $indexMap[strtolower($field)] ?? null;
        if (!$indexTable) {
            return null; // No specialized index for this field
        }

        // Use provided dbPath or get from configuration
        if ($dbPath === null) {
            $dbPath = $this->getEavCachePath();
        }

        if (!file_exists($dbPath)) {
            return null;
        }

        try {
            $db = new \SQLite3($dbPath, SQLITE3_OPEN_READONLY);

            // Build query based on index type
            // Note: We deduplicate by value and take MAX count (since same taxon may appear in multiple source fields)
            if ($indexTable === 'autocomplete_taxon') {
                $sql = "SELECT taxon_name as value, MAX(image_count) as count,
                               GROUP_CONCAT(DISTINCT source_field) as field
                        FROM autocomplete_taxon
                        WHERE taxon_name LIKE :query
                        GROUP BY taxon_name
                        ORDER BY count DESC, taxon_name ASC
                        LIMIT :limit";
            } elseif ($indexTable === 'autocomplete_collection') {
                $sql = "SELECT collection_value as value, image_count as count, source_field as field
                        FROM autocomplete_collection
                        WHERE collection_value LIKE :query
                        ORDER BY image_count DESC, collection_value ASC
                        LIMIT :limit";
            } elseif ($indexTable === 'autocomplete_location') {
                $sql = "SELECT location_value as value, MAX(image_count) as count,
                               GROUP_CONCAT(DISTINCT source_field) as field
                        FROM autocomplete_location
                        WHERE location_value LIKE :query
                        GROUP BY location_value
                        ORDER BY count DESC, location_value ASC
                        LIMIT :limit";
            } elseif ($indexTable === 'autocomplete_date') {
                $sql = "SELECT year as value, image_count as count, 'eventDate' as field
                        FROM autocomplete_date
                        WHERE year LIKE :query
                        ORDER BY year DESC
                        LIMIT :limit";
            } else {
                $db->close();
                return null;
            }

            $stmt = $db->prepare($sql);
            $stmt->bindValue(':query', '%' . $query . '%', SQLITE3_TEXT);
            $stmt->bindValue(':limit', $limit, SQLITE3_INTEGER);

            $result = $stmt->execute();

            $suggestions = [];
            while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
                $suggestions[] = [
                    'value' => $row['value'],
                    'count' => (int)$row['count'],
                    'field' => $row['field'] ?? $field
                ];
            }

            $db->close();
            return $suggestions;

        } catch (\Exception $e) {
            error_log("Autocomplete index query failed: " . $e->getMessage());
            return null;
        }
    }

    /**
     * Autocomplete collection values for search pills
     * Searches across collectionName, collectionCode, and institutionCode
     * Returns results formatted for the search component
     */
    private function autocompleteCollectionValues(string $query, int $limit = 20): array
    {
        if (strlen($query) < 2) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Type at least 2 characters...</div>'
            ];
        }

        // Use the specialized autocomplete index for fast lookups
        $suggestions = $this->autocompleteFromIndex('collection', $query, $limit);

        if ($suggestions === null) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Search index not available</div>'
            ];
        }

        if (empty($suggestions)) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">No matching collections found</div>'
            ];
        }

        // Generate HTML for collection autocomplete
        $html = '';
        foreach ($suggestions as $suggestion) {
            $fieldLabel = match($suggestion['field']) {
                'collectionName' => 'Name',
                'collectionCode' => 'Code',
                'institutionCode' => 'Institution',
                'collid' => 'ID',
                default => 'Collection'
            };

            $html .= sprintf(
                '<div class="autocomplete-item" onclick="selectValue(\'collection\', \'%s\')">
                    <div class="autocomplete-value">%s</div>
                    <div class="autocomplete-field-type">%s</div>
                    <div class="autocomplete-count">%d %s</div>
                </div>',
                htmlspecialchars($suggestion['value']),
                htmlspecialchars($suggestion['value']),
                htmlspecialchars($fieldLabel),
                $suggestion['count'],
                $suggestion['count'] === 1 ? 'image' : 'images'
            );
        }

        return [
            'type' => 'htmx',
            'content' => $html
        ];
    }

    /**
     * Autocomplete collections for search
     */
    public function autocompleteCollections(array $params): array
    {
        $query = $params['q'] ?? $params['query'] ?? '';
        $limit = (int)($params['limit'] ?? 30);

        if (strlen($query) < 2) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Type at least 2 characters...</div>'
            ];
        }

        // Check search mode and route to appropriate autocomplete cache
        $searchMode = $this->getSearchMode();

        // For hybrid mode or large datasets, use hybrid autocomplete cache
        if ($searchMode === 'hybrid' || $searchMode === 'auto') {
            $collections = $this->getHybridAutocomplete('collection', $query, $limit);
            if (!empty($collections)) {
                $resultsHtml = $this->generateAutocompleteHtml($collections, 'collection');
                return [
                    'type' => 'htmx',
                    'content' => $this->renderTemplate('autocomplete_results', TemplateFormat::HTML, [
                        'results_html' => $resultsHtml
                    ])
                ];
            }

            // No results from hybrid cache - return helpful message
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">No matching collections found</div>'
            ];
        }

        // For EAV mode, query EAV cache directly
        // Fallback to direct MySQL query
        return $this->executeWithFallback(
            'autocomplete-collections',
            function() use ($query, $limit) {
                $connection = $this->getDatabaseConnection('readonly');
                if (!$connection) {
                    throw new Exception('Database connection failed');
                }

                $sql = $this->renderTemplate('mysql/autocomplete_collections', TemplateFormat::SQL, [
                    'search_term' => addslashes($query),
                    'limit' => $limit
                ]);

                $result = $connection->query($sql);
                if (!$result) {
                    throw new Exception('Query failed: ' . $connection->error);
                }

                $collections = [];
                while ($row = $result->fetch_assoc()) {
                    $collections[] = $row;
                }

                $resultsHtml = $this->generateAutocompleteHtml($collections, 'collection');

                return [
                    'type' => 'htmx',
                    'content' => $this->renderTemplate('autocomplete_results', TemplateFormat::HTML, [
                        'results_html' => $resultsHtml
                    ])
                ];
            },
            function() {
                return [
                    'type' => 'htmx',
                    'content' => '<div class="autocomplete-message">Autocomplete cache not built. Run: php index.php images cache --build</div>'
                ];
            }
        );
    }

