    /**
     * Route search to appropriate plugin based on search_mode and cache availability
     *
     * @param array $params Search parameters
     * @return array Search results
     */
    private function routeSearch(array $params): array
    {
        // Use new plugin delegation architecture
        return $this->delegateSearch($params);
    }

    /**
     * Auto-detect search mode based on cache availability and size
     *
     * Priority:
     * 1. If hybrid index exists -> use hybrid (includes autocomplete tables)
     * 2. If EAV cache exists and dataset is small -> use EAV
     * 3. Otherwise -> use hybrid (will query MySQL directly)
     *
     * @return string 'eav' or 'hybrid'
     */
    private function detectSearchMode(): string
    {
        $config = Configuration::getInstance();

        // If Configuration is not available, try to detect from filesystem
        if ($config === null) {
            // Check for EAV cache in default location
            $defaultEavPath = '/var/www/temp/myco/data/images_cache.db';
            if (file_exists($defaultEavPath)) {
                try {
                    $db = new \PDO('sqlite:' . $defaultEavPath);
                    $db->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);
                    $stmt = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='Config'");
                    if ($stmt->fetch()) {
                        return 'eav';
                    }
                } catch (\Exception $e) {
                    // Fall through
                }
            }

            // Default to hybrid if we can't determine
            return 'hybrid';
        }

        $eavCachePath = $config->get('components.images.eav_cache_db');
        $hybridIndexPath = $config->get('components.images.hybrid_index_db');
        $threshold = $config->get('components.images.hybrid_threshold', 500000);

        // PRIORITY 1: Check if hybrid index exists (hybrid mode is standalone)
        // This prevents automatic EAV cache rebuilds when using hybrid mode
        if ($hybridIndexPath && file_exists($hybridIndexPath)) {
            try {
                $db = new \PDO('sqlite:' . $hybridIndexPath);
                $db->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);

                // Verify it's a valid hybrid index (check for Entities table)
                $stmt = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='Entities'");
                if ($stmt->fetch()) {
                    return 'hybrid';
                }
            } catch (\Exception $e) {
                // Hybrid index is invalid, fall through to check EAV cache
            }
        }

        // PRIORITY 2: Check if EAV cache exists and is valid (for small datasets)
        if ($eavCachePath && file_exists($eavCachePath)) {
            try {
                $db = new \PDO('sqlite:' . $eavCachePath);
                $db->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);

                // Check if Config table exists and has entity_count
                $stmt = $db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='Config'");
                if ($stmt->fetch()) {
                    $stmt = $db->query("SELECT Value FROM Config WHERE Key = 'entity_count'");
                    $row = $stmt->fetch(\PDO::FETCH_ASSOC);
                    if ($row) {
                        $entityCount = (int)$row['Value'];

                        // Use EAV for small datasets, hybrid for large
                        if ($entityCount < $threshold) {
                            return 'eav';
                        } else {
                            // Large dataset - recommend hybrid mode
                            return 'hybrid';
                        }
                    }
                }

                // EAV cache exists but no entity count - assume it's valid and use it
                return 'eav';

            } catch (\Exception $e) {
                // EAV cache is invalid, fall through to hybrid
            }
        }

        // PRIORITY 3: No caches available - default to hybrid (will query MySQL directly)
        return 'hybrid';
    }

    /**
     * Get search mode from configuration
     *
     * @return string Search mode: 'auto', 'eav', 'hybrid', or 'false'
     */
    private function getSearchMode(): string
    {
        $config = Configuration::getInstance();
        return $config->get('components.images.search_mode', 'auto');
    }

    /**
     * Get or instantiate the search plugin based on detected mode
     *
     * @return ImagesSearchInterface|null Search plugin instance or null if disabled
     */
    private function getSearchPlugin(): ?ImagesSearchInterface
    {
        // Return cached plugin if already instantiated
        if ($this->searchPlugin !== null) {
            return $this->searchPlugin;
        }

        // Detect search mode
        $searchMode = $this->getSearchMode();

        // Check if search is disabled
        if ($searchMode === 'false') {
            return null;
        }

        // Auto-detect mode if set to 'auto'
        if ($searchMode === 'auto') {
            $searchMode = $this->detectSearchMode();
        }

        // Cache the detected mode
        $this->detectedSearchMode = $searchMode;

        // Instantiate appropriate plugin
        try {
            $config = Configuration::getInstance();
            $configPath = ApplicationPaths::templatesDirectory() . '/sql/images/eav/index_config.ini';

            if ($searchMode === 'eav') {
                $cacheDbPath = $config->get('components.images.eav_cache_db');

                if (empty($cacheDbPath) || !file_exists($cacheDbPath)) {
                    return null;
                }

                $this->searchPlugin = new ImagesModelEav([
                    'config_path' => $configPath,
                    'cache_db_path' => $cacheDbPath
                ]);

            } else {
                // Hybrid mode
                $cacheDbPath = $config->get('components.images.hybrid_index_db');

                if (empty($cacheDbPath) || !file_exists($cacheDbPath)) {
                    return null;
                }

                $this->searchPlugin = new ImagesModelHybrid([
                    'config_path' => $configPath,
                    'cache_db_path' => $cacheDbPath
                ]);
            }

            return $this->searchPlugin;

        } catch (\Exception $e) {
            error_log("Failed to instantiate search plugin: " . $e->getMessage());
            return null;
        }
    }

    /**
     * Delegate autocomplete fields to search plugin
     *
     * @param array $params Parameters
     * @return array Response array
     */
    private function delegateAutocompleteFields(array $params): array
    {
        $plugin = $this->getSearchPlugin();

        if ($plugin === null) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Search is disabled or cache not available</div>'
            ];
        }

        return $plugin->autocompleteFields($params);
    }

    /**
     * Delegate autocomplete values to search plugin
     *
     * @param array $params Parameters
     * @return array Response array
     */
    private function delegateAutocompleteValues(array $params): array
    {
        $plugin = $this->getSearchPlugin();

        if ($plugin === null) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Search is disabled or cache not available</div>'
            ];
        }

        return $plugin->autocompleteValues($params);
    }

    /**
     * Delegate search to search plugin
     *
     * @param array $params Parameters
     * @return array Response array
     */
    private function delegateSearch(array $params): array
    {
        $plugin = $this->getSearchPlugin();

        if ($plugin === null) {
            return [
                'type' => 'error',
                'message' => 'Search is disabled or cache not available',
                'status_code' => 503
            ];
        }

        return $plugin->search($params);
    }

    /**
     * Get autocomplete suggestions from hybrid index database
     * Uses autocomplete tables in the same database as the hybrid index (like EAV model)
     *
     * @param string $field Field name (e.g., 'collection', 'taxon')
     * @param string $query Search query
     * @param int $limit Maximum number of results
     * @return array Autocomplete suggestions
     */
    private function getHybridAutocomplete(string $field, string $query, int $limit): array
    {
        try {
            $config = Configuration::getInstance();
            $hybridIndexPath = $config->get('components.images.hybrid_index_db');

            if (!file_exists($hybridIndexPath)) {
                return [];
            }

            $db = new PDO('sqlite:' . $hybridIndexPath);
            $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

            // Load SQL template based on field type
            $templatePath = __DIR__ . '/../../templates/sql/images/autocomplete/';

            if ($field === 'taxon') {
                // Load taxon autocomplete query template
                $sqlTemplate = file_get_contents($templatePath . 'query_taxon.sql');
                $stmt = $db->prepare($sqlTemplate);
                $stmt->execute([$query . '%', $limit]);
                return $stmt->fetchAll(PDO::FETCH_ASSOC);
            } elseif ($field === 'collection') {
                // Load collection autocomplete query template
                $sqlTemplate = file_get_contents($templatePath . 'query_collection.sql');
                $stmt = $db->prepare($sqlTemplate);
                $stmt->execute([$query . '%', $limit]);
                return $stmt->fetchAll(PDO::FETCH_ASSOC);
            } else {
                // Load general autocomplete query template
                $sqlTemplate = file_get_contents($templatePath . 'query_general.sql');
                $stmt = $db->prepare($sqlTemplate);
                $stmt->execute([$field, $query . '%', $limit]);
                return $stmt->fetchAll(PDO::FETCH_ASSOC);
            }

        } catch (PDOException $e) {
            error_log("Hybrid autocomplete error: " . $e->getMessage());
            return [];
        }
    }

    /**
     * Autocomplete collection codes for search
     */
    public function autocompleteCollectionCodes(array $params): array
    {
        $query = $params['q'] ?? $params['query'] ?? '';
        $limit = (int)($params['limit'] ?? 30);

        if (strlen($query) < 1) {
            return [
                'type' => 'htmx',
                'content' => '<div class="autocomplete-message">Type collection code...</div>'
            ];
        }

        return $this->executeWithFallback(
            'autocomplete-collection-codes',
            function() use ($query, $limit) {
                $connection = $this->getDatabaseConnection('readonly');
                if (!$connection) {
                    throw new Exception('Database connection failed');
                }

                $sql = $this->renderTemplate('mysql/autocomplete_collection_codes', TemplateFormat::SQL, [
                    'search_term' => addslashes($query),
                    'limit' => $limit
                ]);

                $result = $connection->query($sql);
                if (!$result) {
                    throw new Exception('Query failed: ' . $connection->error);
                }

                $codes = [];
                while ($row = $result->fetch_assoc()) {
                    $codes[] = $row;
                }

                $resultsHtml = $this->generateAutocompleteHtml($codes, 'collectioncode');

                return [
                    'type' => 'htmx',
                    'content' => $this->renderTemplate('autocomplete_results', TemplateFormat::HTML, [
                        'results_html' => $resultsHtml
                    ])
                ];
            },
            function() {
                return [
                    'type' => 'htmx',
                    'content' => '<div class="autocomplete-message">Database unavailable</div>'
                ];
            }
        );
    }

    /**
     * Generate HTML for autocomplete results
     */
    private function generateAutocompleteHtml(array $results, string $type): string
    {
        if (empty($results)) {
            return '<div class="autocomplete-message">No results found</div>';
        }

        $html = '';
        foreach ($results as $result) {
            // Handle both old format (display_name, collid, tid) and new format (value, count)
            $displayName = htmlspecialchars($result['display_name'] ?? $result['value'] ?? '');
            $id = htmlspecialchars($result['collid'] ?? $result['tid'] ?? '');
            $count = isset($result['count']) ? ' (' . number_format($result['count']) . ')' : '';

            $html .= sprintf(
                '<div class="autocomplete-item" onclick="selectAutocompleteItem(\'%s\', \'%s\', \'%s\')" data-type="%s" data-value="%s" data-id="%s">',
                $type, $displayName, $id, $type, $displayName, $id
            );

            switch ($type) {
                case 'collection':
                    // For hybrid autocomplete, we only have the value (collection name/code/institution)
                    $collectionName = htmlspecialchars($result['collectionname'] ?? $result['value'] ?? '');
                    $collectionCode = htmlspecialchars($result['collectioncode'] ?? '');
                    $institutionCode = htmlspecialchars($result['institutioncode'] ?? '');

                    if ($collectionCode || $institutionCode) {
                        $html .= sprintf(
                            '<div class="autocomplete-collection"><div class="collection-name">%s</div><div class="collection-details">%s - %s</div></div>',
                            $collectionName,
                            $collectionCode,
                            $institutionCode
                        );
                    } else {
                        // Simplified format for hybrid autocomplete
                        $html .= sprintf(
                            '<div class="autocomplete-collection"><div class="collection-name">%s%s</div></div>',
                            $collectionName,
                            $count
                        );
                    }
                    break;

                case 'taxon':
                    // For hybrid autocomplete, we only have the value (taxon name)
                    $taxonName = htmlspecialchars($result['sciname'] ?? $result['value'] ?? '');
                    $author = htmlspecialchars($result['author'] ?? '');

                    $html .= sprintf(
                        '<div class="autocomplete-taxon"><div class="taxon-name">%s%s</div>%s</div>',
                        $taxonName,
                        $count,
                        $author ? sprintf('<div class="taxon-author">%s</div>', $author) : ''
                    );
                    break;

                case 'collectioncode':
                    $html .= sprintf(
                        '<div class="autocomplete-code"><div class="code-name">%s</div><div class="code-details">%s</div></div>',
                        htmlspecialchars($result['collectioncode'] ?? ''),
                        htmlspecialchars($result['collectionname'] ?? '')
                    );
                    break;
            }

            $html .= '</div>';
        }

        return $html;
    }

    /**
     * Load more images (for Load More button)
     */
    public function loadMoreImages(array $params): array
    {
        $requestedLimit = (int)($params['limit'] ?? $this->defaultImagesPerQuery);
        $offset = (int)($params['offset'] ?? 0);
        $sort = $params['sort'] ?? 'random';

        // Always use offset-based pagination for consistent "load more" behavior
        // This ensures we paginate through ALL images, not just random samples
        $connection = $this->getDatabaseConnection('readonly');
        if (!$connection) {
            return [
                'type' => 'htmx',
                'content' => '<div hx-swap-oob="innerHTML:#load-more-container"><div class="end-message">Database connection failed</div></div>'
            ];
        }
        $rawImages = $this->getFastMediaUrls($connection, $requestedLimit, $sort, $offset);

        if (empty($rawImages)) {
            // No more images - return end message
            return [
                'type' => 'htmx',
                'content' => '<div hx-swap-oob="innerHTML:#load-more-container"><div class="end-message">No more images available</div></div>'
            ];
        }

        $imagesHtml = $this->generateImagesHtml($rawImages);

        // Generate new load more button if we got a full batch
        $loadMoreHtml = '';
        if (count($rawImages) >= $requestedLimit) {
            $nextOffset = $offset + $requestedLimit;
            $loadMoreHtml = $this->renderTemplate('load_more_button', TemplateFormat::HTML, [
                'app_url_prefix' => $this->getAppUrlPrefix(),
                'images_per_request' => $requestedLimit,
                'sort' => $sort,
                'next_offset' => $nextOffset
            ]);
        }

        // Return images + new load more button
        $content = $imagesHtml;
        if (!empty($loadMoreHtml)) {
            $content .= '<div hx-swap-oob="innerHTML:#load-more-container">' . $loadMoreHtml . '</div>';
        } else {
            $content .= '<div hx-swap-oob="innerHTML:#load-more-container"><div class="end-message">No more images available</div></div>';
        }

        return [
            'type' => 'htmx',
            'content' => $content
        ];
    }

    /**
     * Filter images
     */
    public function filterImages(array $params): array
    {
        $type = $params['type'] ?? $params['filter'] ?? '';
        $sort = $params['sort'] ?? 'date_created';

        try {
            $images = $this->getImagesFromDatabase(20, '', $sort, $type);
        } catch (Exception $e) {
            // Fallback to empty results if database fails
            $images = [];
        }

        if (Environment::isCli()) {
            $outputLines = ["Filtered images by type '{$type}':"];
            foreach ($images as $image) {
                $imageType = $image['image_type'] ?? 'unknown';
                $filename = $image['filename'] ?? 'unknown';
                $outputLines[] = "- {$filename} ({$imageType})";
            }
            $output = implode("\n", $outputLines);
            return [
                'type' => 'success',
                'content' => $output
            ];
        }

        $imagesHtml = $this->generateImagesHtml($images);
        $hasMore = count($images) >= 20; // Assume more if we got the full limit
        $loadMoreHtml = $hasMore ? $this->generateLoadMoreHtml(20) : '';

        return [
            'type' => 'htmx',
            'content' => $this->renderTemplate('image_grid', TemplateFormat::HTML, [
                'images_html' => $imagesHtml,
                'load_more_html' => $loadMoreHtml,
                'app_url_prefix' => $this->getAppUrlPrefix()
            ])
        ];
    }

    /**
     * Get image details
     */
    /**
     * Get detailed image information with occurrence, collection, and taxonomy data
     * Called on-demand when user clicks on an image for overlay
     */
    public function getImageDetails(array $params): array
    {
        $mediaId = $params['id'] ?? $params['mediaId'] ?? $params[0] ?? '';

        if (!$mediaId) {
            return [
                'type' => 'error',
                'message' => 'Media ID required',
                'status_code' => 400
            ];
        }

        try {
            $connection = $this->getDatabaseConnection('readonly');
            if (!$connection) {
                throw new Exception('Database connection failed');
            }

            // Get full image details with all related data
            $sql = "SELECT
                        m.mediaID,
                        m.occid,
                        m.url,
                        m.originalUrl,
                        m.thumbnailUrl,
                        m.caption,
                        m.creator,
                        m.anatomy,
                        m.locality as media_locality,
                        m.initialTimestamp,
                        m.format,
                        m.owner,
                        o.sciname,
                        o.locality as occurrence_locality,
                        o.eventdate,
                        o.recordedby as collector,
                        o.recordnumber,
                        o.catalognumber,
                        o.family,
                        o.genus,
                        o.specificepithet,
                        c.collectionname,
                        c.institutioncode,
                        c.collid,
                        t.SciName as taxonomy_name,
                        t.TID as tid,
                        t.UnitName1 as genus_taxa,
                        t.UnitName2 as species_taxa,
                        t.Author as taxon_author
                    FROM media m
                    LEFT JOIN omoccurrences o ON o.occid = m.occid
                    LEFT JOIN omcollections c ON o.collid = c.collid
                    LEFT JOIN taxa t ON o.tidinterpreted = t.TID
                    WHERE m.mediaID = ?";

            $stmt = $connection->prepare($sql);
            if (!$stmt) {
                throw new Exception('Failed to prepare query: ' . $connection->error);
            }

            $stmt->bind_param('i', $mediaId);

            if (!$stmt->execute()) {
                throw new Exception('Failed to execute query: ' . $stmt->error);
            }

            $result = $stmt->get_result();
            $row = $result->fetch_assoc();
            $stmt->close();

            if (!$row) {
                return [
                    'type' => 'error',
                    'message' => 'Image not found',
                    'status_code' => 404
                ];
            }

            // Process image URLs
            $baseUrl = $this->getSymbiotaBaseUrl();
            $url = $this->resolveImageUrl($row['url'], $baseUrl);
            $thumbnailUrl = $row['thumbnailUrl'] ? $this->resolveImageUrl($row['thumbnailUrl'], $baseUrl) : $url;
            $originalUrl = $row['originalUrl'] ? $this->resolveImageUrl($row['originalUrl'], $baseUrl) : $url;

            $imageDetails = [
                'id' => $row['mediaID'],
                'occid' => $row['occid'],
                'filename' => basename($row['url']),
                'thumbnail_url' => $thumbnailUrl,
                'full_url' => $originalUrl,
                'url' => $url,
                'caption' => $row['caption'],
                'creator' => $row['creator'],
                'anatomy' => $row['anatomy'],
                'format' => $row['format'],
                'owner' => $row['owner'],
                'date_created' => $row['initialTimestamp'],
                'locality' => $row['occurrence_locality'] ?: $row['media_locality'],
                // Occurrence data
                'sciname' => $row['sciname'],
                'eventdate' => $row['eventdate'],
                'collector' => $row['collector'],
                'recordnumber' => $row['recordnumber'],
                'catalognumber' => $row['catalognumber'],
                // Collection data
                'collection_name' => $row['collectionname'],
                'institution_code' => $row['institutioncode'],
                'collid' => $row['collid'],
                // Taxonomy data
                'taxonomy_name' => $row['taxonomy_name'],
                'tid' => $row['tid'],
                'family' => $row['family'], // from omoccurrences
                'genus' => $row['genus'] ?: $row['genus_taxa'], // prefer omoccurrences, fallback to taxa
                'specificepithet' => $row['specificepithet'] ?: $row['species_taxa'], // prefer omoccurrences, fallback to taxa
                'taxon_author' => $row['taxon_author'],
                // Links for navigation
                'occurrence_link' => $row['occid'] ? "/collections/individual/index.php?occid={$row['occid']}" : null,
                'taxonomy_link' => $row['tid'] ? "/taxa/index.php?taxon={$row['tid']}" : null
            ];

            if (Environment::isCli()) {
                return [
                    'type' => 'success',
                    'content' => $this->formatImageDetailsForCli($imageDetails)
                ];
            }

            // Generate info HTML server-side
            $imageInfoHtml = $this->generateImageInfoHtml($imageDetails);

            return [
                'type' => 'htmx',
                'content' => $this->renderTemplate('image_details', TemplateFormat::HTML, [
                    'image_full_url' => $imageDetails['full_url'],
                    'image_caption' => $imageDetails['caption'],
                    'image_filename' => $imageDetails['filename'],
                    'image_info_html' => $imageInfoHtml,
                    'app_url_prefix' => $this->getAppUrlPrefix()
                ])
            ];

        } catch (Exception $e) {
            return [
                'type' => 'error',
                'message' => 'Failed to load image details: ' . $e->getMessage(),
                'status_code' => 500
            ];
        }
    }

    /**
     * Format image details for CLI output
     */
    private function formatImageDetailsForCli(array $imageDetails): string
    {
        $output = "Image Details:\n";
        $output .= "Filename: {$imageDetails['filename']}\n";
        $output .= "Caption: {$imageDetails['caption']}\n";
        $output .= "Creator: {$imageDetails['creator']}\n";
        $output .= "Date Created: {$imageDetails['date_created']}\n";

        if ($imageDetails['sciname']) {
            $output .= "\nOccurrence Information:\n";
            $output .= "Scientific Name: {$imageDetails['sciname']}\n";
            $output .= "Collector: {$imageDetails['collector']}\n";
            $output .= "Event Date: {$imageDetails['eventdate']}\n";
            $output .= "Locality: {$imageDetails['locality']}\n";
            $output .= "Record Number: {$imageDetails['recordnumber']}\n";
            $output .= "Catalog Number: {$imageDetails['catalognumber']}\n";
        }

        if ($imageDetails['collection_name']) {
            $output .= "\nCollection Information:\n";
            $output .= "Collection: {$imageDetails['collection_name']}\n";
            $output .= "Institution: {$imageDetails['institution_code']}\n";
        }

        if ($imageDetails['family']) {
            $output .= "\nTaxonomy Information:\n";
            $output .= "Family: {$imageDetails['family']}\n";
            $output .= "Genus: {$imageDetails['genus']}\n";
            $output .= "Species: {$imageDetails['specificepithet']}\n";
        }

        return $output;
    }

    /**
     * Get help information
     */
    public function getHelp(): array
    {
        $helpInfo = static::getHelpInfo();

        if (Environment::isCli()) {
            return [
                'type' => 'help',
                'content' => $helpInfo
            ];
        }

        return [
            'type' => 'html',
            'content' => $this->renderTemplate('help', TemplateFormat::HTML, $helpInfo)
        ];
    }

    /**
     * Get images from Symbiota database - FAST: Media table only for infinite scroll
     */
    private function getImagesFromDatabase(?int $limit = null, string $search = '', string $sort = 'random', string $filter = '', int $offset = 0): array
    {
        if (!$this->isDatabaseAvailable()) {
            throw new Exception('Database connection failed');
        }

        $connection = $this->getDatabaseConnection('readonly');
        if (!$connection) {
            throw new Exception('Database connection failed');
        }

        // Use configured default if no limit provided
        $limit = $limit ?? $this->defaultImagesPerQuery;

        // If search or filter is provided, use the filtered search method
        if (!empty($search) || !empty($filter)) {
            return $this->getFilteredImages($connection, $limit, $search, $filter, $sort);
        }

        // FASTEST: Simple media table query only - no JOINs, minimal processing
        return $this->getFastMediaUrls($connection, $limit, $sort, $offset);
    }

    /**
     * FASTEST: Get media URLs with minimal query - media table only, no JOINs
     */
    private function getFastMediaUrls($connection, int $limit, string $sort = 'random', int $offset = 0): array
    {
        // Get 2x the requested amount to account for validation filtering
        $bufferLimit = $limit * 2;

        // Build the simplest possible query - media table only
        // Fetch with lowercase column names (as stored in DB), map to camelCase in PHP
        $sql = "SELECT
                    mediaid,
                    occid,
                    url,
                    originalurl,
                    thumbnailurl,
                    caption
                FROM media
                WHERE url IS NOT NULL AND url != ''";

        // Add ORDER BY based on configuration
        if ($this->enableRandomLoading && $sort === 'random') {
            // Use seeded RAND() for consistent pagination across requests
            // Seed changes daily so users see different images each day
            $seed = (int)date('Ymd'); // Daily seed: 20250106
            $sql .= " ORDER BY RAND($seed)";
        } else {
            $sql .= " ORDER BY mediaid DESC";  // Fastest sort - uses primary key
        }

        // Add LIMIT and OFFSET
        $sql .= sprintf(" LIMIT %d OFFSET %d", $bufferLimit, $offset);

        $stmt = $connection->prepare($sql);
        if (!$stmt) {
            throw new Exception('Failed to prepare fast media query: ' . $connection->error);
        }

        if (!$stmt->execute()) {
            throw new Exception('Failed to execute query: ' . $stmt->error);
        }

        $result = $stmt->get_result();
        $images = [];

        while ($row = $result->fetch_assoc()) {
            // Map lowercase DB columns to camelCase for consistency
            $url = $row['url'];
            $thumbnailUrl = $row['thumbnailurl'] ?: $url;
            $originalUrl = $row['originalurl'] ?: $url;

            $images[] = [
                'mediaID' => (int)$row['mediaid'],  // Map mediaid -> mediaID
                'occid' => $row['occid'],
                'filename' => basename($url),
                'thumbnailUrl' => $thumbnailUrl,    // Map thumbnailurl -> thumbnailUrl
                'originalUrl' => $originalUrl,      // Map originalurl -> originalUrl
                'url' => $url,
                'caption' => $row['caption'] ?: ''
            ];
        }

        $stmt->close();
        return $images;
    }

    /**
     * Get ordered media URLs from media table (Stage 1 - fast, non-random)
     */
    private function getOrderedMediaUrls($connection, int $limit, string $sort = 'date_created'): array
    {
        // Map sort options to actual columns for performance
        $sortMap = [
            'date_created' => 'mediaID DESC',
            'filename' => 'url ASC',
            'date_modified' => 'mediaID DESC'
        ];

        $orderBy = $sortMap[$sort] ?? 'mediaID DESC';

        $sql = sprintf("SELECT
                    m.mediaID,
                    m.occid,
                    m.url,
                    m.originalUrl,
                    m.thumbnailUrl,
                    m.caption
                FROM media m
                WHERE m.url IS NOT NULL AND m.url != ''
                ORDER BY %s
                LIMIT ?", $orderBy);

        $stmt = $connection->prepare($sql);
        $stmt->bind_param('i', $limit);

        if (!$stmt->execute()) {
            throw new Exception('Failed to execute query: ' . $stmt->error);
        }

        $result = $stmt->get_result();
        $images = [];

        while ($row = $result->fetch_assoc()) {
            if (empty($row['url'])) {
                continue;
            }

            // Handle URLs relative to SYMBDIR
            $baseUrl = $this->getSymbiotaBaseUrl();
            $url = $this->resolveImageUrl($row['url'], $baseUrl);
            $thumbnailUrl = $row['thumbnailUrl'] ? $this->resolveImageUrl($row['thumbnailUrl'], $baseUrl) : $url;
            $originalUrl = $row['originalUrl'] ? $this->resolveImageUrl($row['originalUrl'], $baseUrl) : $url;

            // Extract filename from URL for display
            $filename = basename(parse_url($url, PHP_URL_PATH)) ?: 'unknown';

            $images[] = [
                'id' => $row['mediaID'],
                'filename' => $filename,
                'url' => $url,
                'thumbnail_url' => $thumbnailUrl,
                'original_url' => $originalUrl,
                'caption' => $row['caption'],
                'occid' => $row['occid']
            ];
        }

        $stmt->close();
        return $images;
    }

    /**
     * Stage 2-4: Get filtered images with joins for search/filter operations
     */
    private function getFilteredImages($connection, int $limit, string $search, string $filter, string $sort): array
    {
        // Build SQL query with joins based on search/filter requirements
        $searchClause = $this->buildSearchClause($search);
        $filterClause = $this->buildFilterClause($filter);
        $orderClause = $this->buildOrderClause($sort);

        // Determine which tables to join based on search/filter requirements
        $needsOccurrences = !empty($search) || strpos($filter, 'eventdate') !== false;
        $needsCollections = strpos($search, 'collid') !== false || strpos($search, 'collection') !== false ||
                           strpos($filter, 'collid') !== false || strpos($filter, 'collection') !== false;
        $needsTaxa = strpos($search, 'taxon') !== false || strpos($search, 'tid') !== false ||
                    strpos($filter, 'taxonomy') !== false;

        // Build FROM clause with appropriate joins
        $fromClause = "FROM media m";
        if ($needsOccurrences) {
            $fromClause .= " LEFT JOIN omoccurrences o ON o.occid = m.occid";
        }
        if ($needsCollections) {
            $fromClause .= " LEFT JOIN omcollections c ON o.collid = c.collid";
        }
        if ($needsTaxa) {
            $fromClause .= " LEFT JOIN taxa t ON o.tid = t.tid";
        }

        $sql = "SELECT
                    m.mediaID,
                    m.occid,
                    m.url,
                    m.originalUrl,
                    m.thumbnailUrl,
                    m.caption,
                    m.creator,
                    m.anatomy,
                    m.locality as media_locality,
                    m.initialTimestamp" .
                    ($needsOccurrences ? ",
                    o.sciname,
                    o.locality as occurrence_locality,
                    o.eventdate" : "") .
                    ($needsCollections ? ",
                    c.collectionname,
                    c.institutioncode" : "") .
                    ($needsTaxa ? ",
                    t.sciname as taxonomy_name,
                    t.tid" : "") . "
                $fromClause
                WHERE m.url IS NOT NULL AND m.url != ''
                $searchClause
                $filterClause
                $orderClause
                LIMIT ?";

        $stmt = $connection->prepare($sql);

        if (!$stmt) {
            throw new Exception('Failed to prepare query: ' . $connection->error);
        }

        $stmt->bind_param('i', $limit);

        if (!$stmt->execute()) {
            throw new Exception('Failed to execute query: ' . $stmt->error);
        }

        $result = $stmt->get_result();
        $images = [];
        $count = 0;

        while (($row = $result->fetch_assoc()) && $count < $limit) {
            // Skip rows with null URLs
            if (empty($row['url'])) {
                continue;
            }

            // Handle URLs relative to SYMBDIR
            $baseUrl = $this->getSymbiotaBaseUrl();
            $url = $this->resolveImageUrl($row['url'], $baseUrl);
            $thumbnailUrl = $row['thumbnailUrl'] ? $this->resolveImageUrl($row['thumbnailUrl'], $baseUrl) : $url;
            $originalUrl = $row['originalUrl'] ? $this->resolveImageUrl($row['originalUrl'], $baseUrl) : $url;

            // Check cache for known invalid images first (faster than server-side verification)
            $thumbnailValid = $this->getCachedImageStatus($thumbnailUrl);
            $mainValid = $this->getCachedImageStatus($url);

            // Skip if both URLs are known to be invalid
            if (($thumbnailValid === false) && ($mainValid === false)) {
                continue;
            }

            // Verify image availability server-side if enabled
            if ($this->isImageValidationEnabled()) {
                $verifiedThumbnail = $this->verifyImageUrl($thumbnailUrl);
                $verifiedUrl = $verifiedThumbnail ? $thumbnailUrl : ($this->verifyImageUrl($url) ? $url : null);

                // Skip images that can't be verified
                if (!$verifiedUrl) {
                    continue;
                }

                // Use verified URL as the display URL
                $thumbnailUrl = $verifiedUrl;
            }

            $images[] = [
                'id' => $row['mediaID'],
                'occid' => $row['occid'],
                'filename' => basename($row['url']),
                'thumbnail_url' => $thumbnailUrl,
                'full_url' => $originalUrl,
                'url' => $url,
                'caption' => $row['caption'],
                'creator' => $row['creator'] ?? '',
                'anatomy' => $row['anatomy'] ?? '',
                'date_created' => $row['initialTimestamp'] ?? '',
                'sciname' => $row['sciname'] ?? '',
                'locality' => ($row['occurrence_locality'] ?? '') ?: ($row['media_locality'] ?? ''),
                'collection_name' => $row['collectionname'] ?? '',
                'institution_code' => $row['institutioncode'] ?? '',
                'eventdate' => $row['eventdate'] ?? '',
                'taxonomy_name' => $row['taxonomy_name'] ?? '',
                'tid' => $row['tid'] ?? null
            ];
            $count++;
        }

        $stmt->close();
        return $images;
    }



    /**
     * Check what image tables exist in the database
     */
    public function checkImageTables(): array
    {
        try {
            $connection = $this->getDatabaseConnection('readonly');

            if (!$connection) {
                return [
                    'type' => 'error',
                    'message' => 'Database connection failed',
                    'status_code' => 500
                ];
            }

            // Check for image tables
            $sql = "SHOW TABLES LIKE '%image%'";
            $result = $connection->query($sql);

            $imageTables = [];
            if ($result) {
                while ($row = $result->fetch_array()) {
                    $imageTables[] = $row[0];
                }
            }

            // Check for tables with URL columns that might contain images
            $sql = "SELECT TABLE_NAME, COLUMN_NAME
                    FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE TABLE_SCHEMA = DATABASE()
                    AND (COLUMN_NAME LIKE '%url%' OR COLUMN_NAME LIKE '%image%')
                    ORDER BY TABLE_NAME, COLUMN_NAME";

            $result = $connection->query($sql);
            $urlTables = [];
            if ($result) {
                while ($row = $result->fetch_assoc()) {
                    $urlTables[] = $row['TABLE_NAME'] . '.' . $row['COLUMN_NAME'];
                }
            }

            $output = "Image-related tables found:\n" . implode("\n", $imageTables);
            $output .= "\n\nTables with URL/image columns:\n" . implode("\n", $urlTables);

            return [
                'type' => 'success',
                'content' => $output
            ];
        } catch (Exception $e) {
            return [
                'type' => 'error',
                'message' => 'Failed to check tables: ' . $e->getMessage(),
                'status_code' => 500
            ];
        }
    }

    /**
     * Check the structure of the media table
     */
    public function checkMediaTableStructure(): array
    {
        try {
            $connection = $this->getDatabaseConnection('readonly');

            if (!$connection) {
                return [
                    'type' => 'error',
                    'message' => 'Database connection failed',
                    'status_code' => 500
                ];
            }

            $sql = "DESCRIBE media";
            $result = $connection->query($sql);

            $columns = [];
            if ($result) {
                while ($row = $result->fetch_assoc()) {
                    $columns[] = $row['Field'] . ' (' . $row['Type'] . ')';
                }
            }

            return [
                'type' => 'success',
                'content' => "Media table structure:\n" . implode("\n", $columns)
            ];
        } catch (Exception $e) {
            return [
                'type' => 'error',
                'message' => 'Failed to check media table structure: ' . $e->getMessage(),
                'status_code' => 500
            ];
        }
    }

    /**
     * Load image modal content
     */
    public function loadImageModal(array $params): array
    {
        $imageId = $params[0] ?? null;

        if (!$imageId) {
            return [
                'type' => 'error',
                'message' => 'Image ID required',
                'status_code' => 400
            ];
        }

        try {
            $connection = $this->getDatabaseConnection('readonly');

            if (!$connection) {
                throw new Exception('Database connection failed');
            }

            // Get single image details
            $sql = "SELECT
                        m.mediaID,
                        m.occid,
                        m.url,
                        m.originalUrl,
                        m.thumbnailUrl,
                        m.caption,
                        m.creator,
                        m.anatomy,
                        m.locality as media_locality,
                        m.initialTimestamp,
                        o.sciname,
                        o.locality as occurrence_locality,
                        c.collectionname,
                        c.institutioncode
                    FROM media m
                    LEFT JOIN omoccurrences o ON o.occid = m.occid
                    LEFT JOIN omcollections c ON o.collid = c.collid
                    WHERE m.mediaID = ?";

            $stmt = $connection->prepare($sql);
            $stmt->bind_param('i', $imageId);
            $stmt->execute();
            $result = $stmt->get_result();
            $image = $result->fetch_assoc();
            $stmt->close();

            if (!$image) {
                return [
                    'type' => 'error',
                    'message' => 'Image not found',
                    'status_code' => 404
                ];
            }

            // Process URLs
            $baseUrl = $this->getSymbiotaBaseUrl();
            $image['full_url'] = $this->resolveImageUrl($image['originalUrl'] ?: $image['url'], $baseUrl);
            $image['image_title'] = $image['caption'] ?: $image['sciname'] ?: 'Image #' . $image['mediaID'];
            $image['locality'] = $image['media_locality'] ?: $image['occurrence_locality'];

            // Render modal template
            $content = $this->renderTemplate('image_modal', TemplateFormat::HTML, $image);

            return [
                'type' => 'htmx',
                'content' => $content
            ];

        } catch (Exception $e) {
            return [
                'type' => 'error',
                'message' => 'Failed to load image modal: ' . $e->getMessage(),
                'status_code' => 500
            ];
        }
    }

    /**
     * Build search clause for SQL query with advanced prefix parsing
     */
    private function buildSearchClause(string $search): string
    {
        if (empty($search)) {
            return '';
        }

        $searchTerms = $this->parseSearchTerms($search);
        $conditions = [];

        foreach ($searchTerms as $term) {
            $condition = $this->buildSearchCondition($term);
            if (!empty($condition)) {
                $conditions[] = $condition;
            }
        }

        if (empty($conditions)) {
            return '';
        }

        return 'AND (' . implode(' AND ', $conditions) . ')';
    }

    /**
     * Parse search string into individual terms with prefixes
     */
    private function parseSearchTerms(string $search): array
    {
        $terms = [];
        $search = trim($search);

        // Handle quoted strings and prefixed terms
        preg_match_all('/(\w+:"[^"]*"|\w+:\S+|"[^"]*"|\S+)/', $search, $matches);

        foreach ($matches[0] as $match) {
            $match = trim($match);
            if (!empty($match)) {
                $terms[] = $match;
            }
        }

        return $terms;
    }

    /**
     * Build individual search condition based on term type
     */
    private function buildSearchCondition(array|string $term): string
    {
        if (is_array($term)) {
            $term = $term[0] ?? '';
        }

        $term = trim($term);
        if (empty($term)) {
            return '';
        }

        // Handle prefixed searches
        if (strpos($term, ':') !== false) {
            list($prefix, $value) = explode(':', $term, 2);
            $prefix = strtolower(trim($prefix));
            $value = trim($value, '"\'');

            return $this->buildPrefixedCondition($prefix, $value);
        }

        // Handle general search (sciname LIKE)
        $value = trim($term, '"\'');
        $escapedValue = '%' . addslashes($value) . '%';

        return sprintf(
            "(o.sciname LIKE '%s' OR t.sciname LIKE '%s' OR m.caption LIKE '%s' OR m.creator LIKE '%s')",
            $escapedValue, $escapedValue, $escapedValue, $escapedValue
        );
    }

    /**
     * Build condition for prefixed search terms
     */
    private function buildPrefixedCondition(string $prefix, string $value): string
    {
        $escapedValue = addslashes($value);

        switch ($prefix) {
            case 'occid':
                return sprintf("o.occid = %d", (int)$value);

            case 'catalognumber':
                return sprintf("o.catalogNumber = '%s'", $escapedValue);

            case 'collid':
                return sprintf("c.collid = %d", (int)$value);

            case 'taxonid':
            case 'tid':
                return sprintf("t.tid = %d", (int)$value);

            case 'filename':
                $likeValue = '%' . $escapedValue . '%';
                return sprintf("m.url LIKE '%s'", $likeValue);

            case 'collection':
                $likeValue = '%' . $escapedValue . '%';
                return sprintf("c.collectionname LIKE '%s'", $likeValue);

            case 'collectioncode':
                return sprintf("c.collectioncode LIKE '%%%s%%'", $escapedValue);

            case 'taxon':
                $likeValue = '%' . $escapedValue . '%';
                return sprintf("(t.sciname LIKE '%s' OR o.sciname LIKE '%s')", $likeValue, $likeValue);

            case 'country':
                return sprintf("o.country LIKE '%%%s%%'", $escapedValue);

            case 'state':
            case 'stateprovince':
                return sprintf("o.stateprovince LIKE '%%%s%%'", $escapedValue);

            case 'county':
                return sprintf("o.county LIKE '%%%s%%'", $escapedValue);

            case 'eventdate':
                return sprintf("o.eventdate LIKE '%%%s%%'", $escapedValue);

            default:
                // Unknown prefix - treat as general search
                $likeValue = '%' . $escapedValue . '%';
                return sprintf("(o.sciname LIKE '%s' OR t.sciname LIKE '%s')", $likeValue, $likeValue);
        }
    }

    /**
     * Build filter clause for SQL query
     */
    private function buildFilterClause(string $filter): string
    {
        if (empty($filter)) {
            return '';
        }

        return "AND c.collid = " . (int)$filter;
    }

    /**
     * Build order clause for SQL query
     */
    private function buildOrderClause(string $sort): string
    {
        switch ($sort) {
            case 'newest':
                return 'ORDER BY m.initialTimestamp DESC';
            case 'oldest':
                return 'ORDER BY m.initialTimestamp ASC';
            case 'creator':
                return 'ORDER BY m.creator ASC';
            case 'sciname':
                return 'ORDER BY o.sciname ASC';
            case 'random':
            default:
                return ''; // Random handled by WHERE clause
        }
    }

    /**
     * Get maximum mediaID from database
     */
    private function getMaxMediaId(\mysqli $connection): int
    {
        $result = $connection->query("SELECT MAX(mediaID) as max_id FROM media WHERE url IS NOT NULL AND url != ''");
        if ($result && $row = $result->fetch_assoc()) {
            return (int)$row['max_id'];
        }
        return 8699118; // Fallback to known max
    }

    /**
     * Generate random mediaID list for efficient random selection
     * Generate 2x the needed amount to account for deleted/missing records
     */
    private function generateRandomMediaIds(int $limit, int $maxMediaId): array
    {
        $randomIds = [];
        $targetCount = $limit * 2; // Generate twice as many to account for gaps
        $attempts = 0;
        $maxAttempts = $targetCount * 2; // Safety limit

        while (count($randomIds) < $targetCount && $attempts < $maxAttempts) {
            $randomId = mt_rand(1, $maxMediaId);
            if (!in_array($randomId, $randomIds)) {
                $randomIds[] = $randomId;
            }
            $attempts++;
        }

        return $randomIds;
    }

    /**
     * Get Symbiota base URL from configuration or environment
     */
    private function getSymbiotaBaseUrl(): string
    {
        // Try to get from config first
        $symbiotaUrl = $this->config['symbiota_base_url'] ?? null;

        if (!$symbiotaUrl) {
            // Try to detect from current request
            $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https://' : 'http://';
            $host = $_SERVER['HTTP_HOST'] ?? 'localhost';
            $symbiotaUrl = $protocol . $host;
        }

        return rtrim($symbiotaUrl, '/');
    }

    /**
     * Resolve image URL - handle paths relative to SYMBDIR
     */
    private function resolveImageUrl(?string $url, string $baseUrl): string
    {
        if (empty($url)) {
            return '';
        }

        // If URL starts with '/', it's relative to SYMBDIR
        if (str_starts_with($url, '/')) {
            return $baseUrl . $url;
        }

        // If URL already has protocol, return as-is
        if (str_contains($url, '://')) {
            return $url;
        }

        // Otherwise, assume it's relative to base URL
        return $baseUrl . '/' . ltrim($url, '/');
    }

    // formatFileSize method removed - now inherited from Model base class

    /**
     * Get app URL prefix for templates
     */
    public function getAppUrlPrefix(): string
    {
        $requestUri = $_SERVER['REQUEST_URI'] ?? '/?/';
        $parser = new UriParser($requestUri);
        $fullUrl = $parser->getAppUrlPrefix();

        if (str_contains($fullUrl, '://')) {
            $parts = parse_url($fullUrl);
            return ($parts['path'] ?? '') . '?/';
        }

        return $fullUrl;
    }

    /**
     * Generate HTML for image grid items using templates
     */
    private function generateImagesHtml(array $images): string
    {
        $imageItems = [];
        $appUrlPrefix = $this->getAppUrlPrefix();

        foreach ($images as $image) {
            // Use original database column names
            // mediaID is always present (primary key in media table)
            $imageItems[] = $this->renderTemplate('image_item', TemplateFormat::HTML, [
                'mediaID' => $image['mediaID'] ?? '',
                'thumbnailUrl' => htmlspecialchars($image['thumbnailUrl'] ?? $image['url'] ?? ''),
                'url' => htmlspecialchars($image['url'] ?? ''),
                'filename' => htmlspecialchars($image['filename'] ?? ''),
                'caption' => htmlspecialchars($image['caption'] ?? ''),
                'occid' => htmlspecialchars($image['occid'] ?? ''),
                'app_url_prefix' => $appUrlPrefix,
                'caption_display' => !empty($image['caption']) ?
                    sprintf('<div><i class="fas fa-image me-1"></i>%s</div>', htmlspecialchars($image['caption'])) : ''
            ]);
        }

        return implode("\n", $imageItems);
    }

    /**
     * Get fixture images for testing/fallback
     */
    private function getFixtureImages(int $limit, int $offset = 0, string $search = '', string $sort = 'random', string $filter = ''): array
    {
        // Sample fixture data for testing
        $fixtures = [
            [
                'id' => 1,
                'filename' => 'sample_image_1.jpg',
                'url' => 'https://via.placeholder.com/400x300/4CAF50/white?text=Sample+1',
                'thumbnail_url' => 'https://via.placeholder.com/200x150/4CAF50/white?text=Sample+1',
                'caption' => 'Sample botanical specimen 1',
                'occid' => 1001
            ],
            [
                'id' => 2,
                'filename' => 'sample_image_2.jpg',
                'url' => 'https://via.placeholder.com/400x300/2196F3/white?text=Sample+2',
                'thumbnail_url' => 'https://via.placeholder.com/200x150/2196F3/white?text=Sample+2',
                'caption' => 'Sample botanical specimen 2',
                'occid' => 1002
            ],
            [
                'id' => 3,
                'filename' => 'sample_image_3.jpg',
                'url' => 'https://via.placeholder.com/400x300/FF9800/white?text=Sample+3',
                'thumbnail_url' => 'https://via.placeholder.com/200x150/FF9800/white?text=Sample+3',
                'caption' => 'Sample botanical specimen 3',
                'occid' => 1003
            ]
        ];

        // Apply search filter if provided
        if (!empty($search)) {
            $fixtures = array_filter($fixtures, function($image) use ($search) {
                return stripos($image['filename'], $search) !== false ||
                       stripos($image['caption'], $search) !== false;
            });
        }

        // Apply pagination
        return array_slice($fixtures, $offset, $limit);
    }

    /**
     * Generate HTML for load more trigger using streaming endpoint
     */
    private function generateLoadMoreHtml(int $nextOffset): string
    {
        $appUrlPrefix = $this->getAppUrlPrefix();
        $limit = $this->defaultImagesPerQuery;
        $sort = $this->enableRandomLoading ? 'random' : 'date_created';

        return sprintf(
            '<div hx-get="%simages/stream?limit=%d&offset=%d&sort=%s" ' .
            'hx-trigger="intersect once delay:500ms" ' .
            'hx-swap="outerHTML" ' .
            'hx-target="this" ' .
            'class="load-trigger text-center py-3">' .
            '<div class="spinner-border spinner-border-sm text-primary" role="status">' .
            '<span class="visually-hidden">Loading more images...</span>' .
            '</div>' .
            '<span class="ms-2 text-muted">Loading more images...</span>' .
            '</div>',
            $appUrlPrefix,
            $limit,
            $nextOffset,
            $sort
        );
    }

