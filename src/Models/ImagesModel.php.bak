                        $lastRefresh
                    );
                }
            }

            if (isset($status['message'])) {
                $output[] = "\nMessage: " . $status['message'];
            }

            return [
                'type' => 'cli',
                'content' => implode("\n", $output)
            ];
        }

        return [
            'type' => 'json',
            'data' => $status
        ];
        */
    }

